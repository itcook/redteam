+// inflight-limit 插件单测：准入上限计数语义（+1/-1 各一次），503 与健康检查豁免。
+// 关键行为都依赖 Elysia 1.4.28 的实测结论（见插件头注释），故这里逐条钉住。
+import { describe, test, expect, beforeEach, afterEach } from 'bun:test';
+import { Elysia } from 'elysia';
+import { inflightLimit, inflightStats, __resetInflightForTest } from '../../src/plugins/inflight-limit';
+
+let slowMs = 0;
+
+function buildApp(max?: string) {
+  if (max !== undefined) process.env.HIAPI_MAX_INFLIGHT = max;
+  let release: (() => void) | null = null;
+  const app = new Elysia()
+    .use(inflightLimit)
+    .get('/work', async () => {
+      if (slowMs > 0) {
+        await new Promise<void>((resolve) => {
+          release = resolve;
+          setTimeout(resolve, slowMs);
+        });
+      }
+      return { code: 0, message: 'ok', data: { done: true } };
+    })
+    .get('/internal/health', () => ({ code: 0, message: 'ok', data: { status: 'ok' } }))
+    .get('/boom', () => {
+      throw new Error('kaboom');
+    });
+  return { app, getRelease: () => release };
+}
+
+// 快照 / 还原 HIAPI_MAX_INFLIGHT（不裸 delete：quality-guidelines §Testing Requirements 09-24 判例）。
+let savedMax: string | undefined;
+
+beforeEach(() => {
+  __resetInflightForTest();
+  slowMs = 0;
+  savedMax = process.env.HIAPI_MAX_INFLIGHT;
+  delete process.env.HIAPI_MAX_INFLIGHT; // 用例默认从「未设置」起步，afterEach 还原
+});
+
+afterEach(() => {
+  if (savedMax === undefined) delete process.env.HIAPI_MAX_INFLIGHT;
+  else process.env.HIAPI_MAX_INFLIGHT = savedMax;
+});
+
+describe('inflight-limit：计数', () => {
+  test('请求完成后 in-flight 归零（不泄漏）', async () => {
+    const { app } = buildApp();
+    const r = await app.handle(new Request('http://localhost/work'));
+    expect(r.status).toBe(200);
+    await Bun.sleep(10); // afterResponse 经 setImmediate 异步触发
+    expect(inflightStats().inflight).toBe(0);
+    expect(inflightStats().peak).toBe(1);
+  });
+
+  test('handler 抛错后 in-flight 仍归零（onError 路径也触发 afterResponse）', async () => {
+    const { app } = buildApp();
+    const r = await app.handle(new Request('http://localhost/boom'));
+    expect(r.status).toBe(500);
+    await Bun.sleep(10);
+    expect(inflightStats().inflight).toBe(0);
+  });
+
+  test('客户端中途断开（真实 HTTP 连接 abort）后 in-flight 仍归零', async () => {
+    let finished = 0;
+    const server = new Elysia()
+      .use(inflightLimit)
+      .get('/work', async () => {
+        await Bun.sleep(150);
+        finished++;
+        return { code: 0, message: 'ok', data: { done: true } };
+      })
+      .listen(0);
+    try {
+      const port = server.server!.port;
+      const ac = new AbortController();
+      const pending = fetch(`http://127.0.0.1:${port}/work`, { signal: ac.signal }).catch((e: unknown) => e);
+      await Bun.sleep(30);
+      expect(inflightStats().inflight).toBe(1);
+      ac.abort();
+      expect(String(await pending)).toContain('AbortError');
+      await Bun.sleep(300); // handler 照常跑完 → afterResponse 补触发
+      expect(finished).toBe(1);
+      expect(inflightStats().inflight).toBe(0);
+    } finally {
+      await server.stop(true);
+    }
+  });
+
+  test('并发 3 个慢请求 → peak=3，全部完成后归零', async () => {
+    slowMs = 1000;
+    const { app, getRelease } = buildApp();
+    const ps = Array.from({ length: 3 }, () => app.handle(new Request('http://localhost/work')));
+    await Bun.sleep(10);
+    expect(inflightStats().inflight).toBe(3);
+    expect(inflightStats().peak).toBe(3);
+    getRelease()?.();
+    const res = await Promise.all(ps);
+    expect(res.every((r) => r.status === 200)).toBe(true);
+    await Bun.sleep(10);
+    expect(inflightStats().inflight).toBe(0);
+  });
+});
+
+describe('inflight-limit：准入拒绝', () => {
+  test('超过上限 → 503 busy，且不重复计数/不漏减', async () => {
+    slowMs = 1000;
+    const { app, getRelease } = buildApp('1');
+    const p1 = app.handle(new Request('http://localhost/work')); // 占住唯一名额
+    await Bun.sleep(10);
+    expect(inflightStats().inflight).toBe(1);
+
+    const r2 = await app.handle(new Request('http://localhost/work'));
+    expect(r2.status).toBe(503);
+    expect(await r2.json()).toEqual({ code: 503, message: 'busy' });
+    expect(r2.headers.get('x-content-cache')).toBe('BYPASS');
+    expect(inflightStats().shed).toBe(1);
+    // 被拒的请求没 +1 → 完成时不减，计数仍为 1（不多也不少）
+    await Bun.sleep(10);
+    expect(inflightStats().inflight).toBe(1);
+
+    getRelease()?.();
+    await p1;
+    await Bun.sleep(10);
+    expect(inflightStats().inflight).toBe(0);
+  });
+
+  test('健康检查不受准入限制（即使已满）', async () => {
+    slowMs = 1000;
+    const { app, getRelease } = buildApp('1');
+    const p1 = app.handle(new Request('http://localhost/work'));
+    await Bun.sleep(10);
+    expect(inflightStats().inflight).toBe(1);
+
+    const h = await app.handle(new Request('http://localhost/internal/health'));
+    expect(h.status).toBe(200);
+    // 健康检查不计数、不占名额
+    expect(inflightStats().inflight).toBe(1);
+    expect(inflightStats().shed).toBe(0);
+
+    getRelease()?.();
+    await p1;
+    await Bun.sleep(10);
+    expect(inflightStats().inflight).toBe(0);
+  });
+
+  test('HIAPI_MAX_INFLIGHT 未设 → 默认 64', () => {
+    expect(inflightStats().max).toBe(64);
+  });
+
+  test('HIAPI_MAX_INFLIGHT 非法值 → 回落默认', () => {
+    process.env.HIAPI_MAX_INFLIGHT = 'x';
+    expect(inflightStats().max).toBe(64);
+  });
+
+  test('HIAPI_MAX_INFLIGHT=0 → 不限制（0 表示关闭闸门）', async () => {
+    const { app } = buildApp('0');
+    const ps = Array.from({ length: 20 }, () => app.handle(new Request('http://localhost/work')));
+    const res = await Promise.all(ps);
+    expect(res.every((r) => r.status === 200)).toBe(true);
+    expect(inflightStats().shed).toBe(0);
+  });
+});
+
+describe('inflight-limit：与缓存命中互不干扰（顺序即语义）', () => {
+  test('缓存命中不进入 in-flight 计数（命中在更早的 onBeforeHandle 短路）', async () => {
+    const { responseCache } = await import('../../src/plugins/response-cache');
+    const { __resetResponseCacheForTest } = await import('../../src/utils/response-cache');
+    // 测试进程默认关缓存（tests/support/clean-env.ts）——本用例要真实缓存语义，临时开启
+    const savedTtl = process.env.HIAPI_RESPONSE_CACHE_TTL_MS;
+    process.env.HIAPI_RESPONSE_CACHE_TTL_MS = '60000';
+    __resetResponseCacheForTest();
+    const app = new Elysia().use(responseCache).use(inflightLimit).get('/announcement', () => ({
+      code: 0,
+      message: 'ok',
+      data: { n: 1 },
+    }));
+    await app.handle(new Request('http://localhost/announcement')); // MISS：计数 1 次
+    await Bun.sleep(10);
+    expect(inflightStats().peak).toBe(1);
+
+    __resetInflightForTest();
+    const hit = await app.handle(new Request('http://localhost/announcement')); // HIT：不应计数
+    expect(hit.headers.get('x-content-cache')).toBe('HIT');
+    await Bun.sleep(10);
+    expect(inflightStats().peak).toBe(0); // 命中完全没进 inflightLimit
+    __resetResponseCacheForTest();
+    if (savedTtl === undefined) delete process.env.HIAPI_RESPONSE_CACHE_TTL_MS;
+    else process.env.HIAPI_RESPONSE_CACHE_TTL_MS = savedTtl;
+  });
+});
diff --git a/apps/content-api/tests/plugins/metrics.test.ts b/apps/content-api/tests/plugins/metrics.test.ts
