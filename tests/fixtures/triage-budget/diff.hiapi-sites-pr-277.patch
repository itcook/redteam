+/** cards 端点计数路由：前 okCalls 次成功（值为 version），之后 502。 */
+function routeCardsSequence(okCalls: number, version: () => string) {
+  let calls = 0;
+  routeFn((url) => {
+    if (!url.includes("/models?locale=en")) return undefined;
+    calls += 1;
+    if (calls > okCalls) return Promise.reject(new Error("upstream overloaded"));
+    return { items: [{ slug: version() }], total: 1 };
+  });
+  return () => calls;
+}
