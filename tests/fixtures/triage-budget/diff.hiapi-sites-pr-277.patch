+  // 负缓存窗口过后应回源拿新内容；原缺陷下 A 顶替降级槽，驻留整个 TTL 返回旧内容、不回源
+  virtualNow += 11_000;
+  expect((await modelCardsSnapshot(NO_RUNTIME, "en")).map((c) => c.slug)).toEqual(["new"]);
+  expect(calls).toBe(3);
+});
