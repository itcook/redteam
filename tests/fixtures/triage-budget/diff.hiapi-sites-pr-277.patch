+// ——— stale-on-error + 负缓存（2026-11-17：content-api 过载放大·环 5）———
+// 契约：回源成功记 last-good；失败时有 ≤10min 旧值就返回旧值并装 15s 窗口（窗口内不回源），
+// 无旧值则 10s 负缓存（窗口内直接抛、不调用 load）；超过 10min 的旧值不用；purge 不清 lastGood；
+// 恢复后返回新值；L2 stale 条目让新 isolate（L1 清空）也能拿到旧值。
+
+/** 安装内存版 Cache API（L2）；返回 store 供断言，调用方负责在 finally 里恢复。 */
+function installMemoryCaches(): { store: Map<string, string>; restore: () => void } {
+  const prevCaches = (globalThis as { caches?: unknown }).caches;
+  const store = new Map<string, string>();
+  (globalThis as { caches?: unknown }).caches = {
+    default: {
+      match: async (req: Request) => (store.has(req.url) ? new Response(store.get(req.url)!) : undefined),
+      put: async (req: Request, res: Response) => {
+        store.set(req.url, await res.text());
+      },
+      delete: async (req: Request) => store.delete(req.url),
+    },
+  };
+  return {
+    store,
+    restore: () => {
+      (globalThis as { caches?: unknown }).caches = prevCaches;
+    },
+  };
+}
