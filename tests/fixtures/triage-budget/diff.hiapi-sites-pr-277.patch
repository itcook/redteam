+test("L1 旧值副本有界：超 160 键先清 10 分钟以上的，再按数据时刻丢最旧的；新键仍可作旧值返回", async () => {
+  let failing = false;
+  routeFn((url) => {
+    if (!url.includes("/showcases/cards?family=")) return undefined;
+    if (failing) return Promise.reject(new Error("overloaded"));
+    const fam = new URL(url, "http://x").searchParams.get("family");
+    return { items: [{ slug: `card-${fam}` }], total: 1 };
+  });
+  const baseline = __lastGoodKeysForTest().length;
+  // 第一阶段：150 个老键，之后时间推过 10 分钟，再写 20 个新键 → 老键全部按年龄清掉
+  for (let i = 0; i < 150; i++) await showcaseCardsSnapshot(NO_RUNTIME, `old-${i}`, "en");
+  virtualNow += 10 * 60_000 + 1_000;
+  for (let i = 0; i < 20; i++) {
+    virtualNow += 1;
+    await showcaseCardsSnapshot(NO_RUNTIME, `new-${i}`, "en");
+  }
+  let keys = __lastGoodKeysForTest();
+  expect(keys.length).toBeLessThanOrEqual(160);
+  expect(keys.filter((k) => k.includes(":old-")).length).toBe(0);
+  // 第二阶段：全在 10 分钟内，持续写到超限 → 逐条丢最旧，总数恒 ≤ 160
+  for (let i = 0; i < 200; i++) {
+    virtualNow += 1;
+    await showcaseCardsSnapshot(NO_RUNTIME, `fresh-${i}`, "en");
+    expect(__lastGoodKeysForTest().length).toBeLessThanOrEqual(160);
+  }
+  keys = __lastGoodKeysForTest();
+  expect(keys.some((k) => k.includes(":fresh-0:"))).toBe(false); // 最旧的被丢
+  expect(keys.some((k) => k.includes(":fresh-199:"))).toBe(true);
+  expect(baseline).toBe(0);
+  // 最新键在失败时仍能返回旧值
+  failing = true;
+  virtualNow += 121_000;
+  expect((await showcaseCardsSnapshot(NO_RUNTIME, "fresh-199", "en")).map((c) => c.slug)).toEqual(["card-fresh-199"]);
