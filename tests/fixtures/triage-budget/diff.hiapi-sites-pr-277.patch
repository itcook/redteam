index 00000000..5456ad3b
--- /dev/null
+++ b/apps/content-api/tests/plugins/metrics.test.ts
@@ -0,0 +1,60 @@
+// metrics 插件单测：指标行格式（一行 JSON、字段齐全、池读不到时写明原因）。
+import { describe, test, expect } from 'bun:test';
+import { statsSnapshot, logStatsLine } from '../../src/plugins/metrics';
+
+describe('metrics：指标行', () => {
+  test('snapshot 字段齐全（ts/pool/inflight/cache）', () => {
+    const s = statsSnapshot();
+    expect(typeof s.ts).toBe('string');
+    expect(s.pool).toBeDefined();
+    expect(s.inflight).toMatchObject({
+      inflight: expect.any(Number),
+      peak: expect.any(Number),
+      shed: expect.any(Number),
+      max: expect.any(Number),
+    });
+    expect(s.cache).toMatchObject({
+      hits: expect.any(Number),
+      misses: expect.any(Number),
+      coalesced: expect.any(Number),
+      evictions: expect.any(Number),
+      entries: expect.any(Number),
+      bytes: expect.any(Number),
+      flights: expect.any(Number),
+      ttlMs: expect.any(Number),
+    });
+  });
+
+  test('pool 要么给出真实三项计数、要么写明读不到的原因（不许省略/静默）', () => {
+    const pool = statsSnapshot().pool as Record<string, unknown>;
+    // 不依赖进程状态：同进程跑全量时别的用例可能已连库。两种合法形态：
+    //   ① 已 connect → { total, idle, waiting } 三个数字；
+    //   ② 未 connect → { error: <原因字符串> }（区分「读不到」与「0 连接」）。
+    if ('error' in pool) {
+      expect(typeof pool.error).toBe('string');
+      expect((pool.error as string).length).toBeGreaterThan(0);
+    } else {
+      expect(typeof pool.total).toBe('number');
+      expect(typeof pool.idle).toBe('number');
+      expect(typeof pool.waiting).toBe('number');
+    }
+  });
+
+  test('logStatsLine 输出单行 [content-api] stats {json}', () => {
+    const lines: string[] = [];
+    const orig = console.info;
+    console.info = (msg: string) => {
+      lines.push(msg);
+    };
+    try {
+      logStatsLine();
+    } finally {
+      console.info = orig;
+    }
+    expect(lines.length).toBe(1);
+    expect(lines[0]!.startsWith('[content-api] stats ')).toBe(true);
+    expect(lines[0]!.includes('\n')).toBe(false);
+    const json = JSON.parse(lines[0]!.slice('[content-api] stats '.length));
+    expect(json.pool).toBeDefined();
+  });
+});
diff --git a/apps/content-api/tests/plugins/response-cache.integration.test.ts b/apps/content-api/tests/plugins/response-cache.integration.test.ts
new file mode 100644
index 00000000..19559bc6
--- /dev/null
+++ b/apps/content-api/tests/plugins/response-cache.integration.test.ts
@@ -0,0 +1,299 @@
+// response-cache 集成测试：真实 app（src/index.ts）+ DB harness。
+// 单测（tests/plugins/response-cache.test.ts）已钉住 key/TTL/单飞/准入等语义；这里只验真实组装下必须成立的四件事：
+//   ① 鉴权在缓存之前（未带 client token 拿不到缓存内容）；
+//   ② 真实白名单路由 miss→hit，且命中不查库（DB 关掉后仍能命中）；
+//   ③ 真实写路由（POST /announcement）成功 → 缓存清空；
+//   ④ purgeSitePaths 发请求前先清本进程缓存；
+//   ⑤ 真实路由上同 key 并发只进一次 service（单飞）。
+// 只有一处写（POST /announcement，ULID 新行，不影响其它用例断言）→ 用文件级重置档（beforeAll resetAndSeed）。
+import { describe, test, expect, beforeAll, beforeEach, afterEach } from 'bun:test';
+import { app } from '../../src/index';
+import { resetAndSeed } from '../db-harness';
+import { json } from '../support/http';
+import { CLIENT_TEST_TOKEN } from '../support/client-token';
+import { staffCookie } from '../support/auth';
+import {
+  clearResponseCache,
+  responseCacheStats,
+  __resetResponseCacheForTest,
+} from '../../src/utils/response-cache';
+import {
+  __installSitePurgeTestDeps,
+  __resetSitePurgeForTest,
+  __flushSitePurgeForTest,
+  collectSitePurge,
+  purgeSitePaths,
+} from '../../src/modules/model-sync/site-purge';
+
+const AUTH = { authorization: `Bearer ${CLIENT_TEST_TOKEN}` };
+// 测试进程预置 TTL=0（tests/support/clean-env.ts），本文件要验证真实缓存语义 → 显式开启。
+// 本文件改动的全部 env 键：每用例前快照、后逐键还原（SITE_PURGE_TOKEN 无 HIAPI_ 前缀，clean-env 清不到，
+// 不还原会泄漏给同进程后续文件——quality-guidelines §Testing Requirements 09-24 判例）。
+const TOUCHED_ENV = [
+  'HIAPI_RESPONSE_CACHE_TTL_MS',
+  'SITE_PURGE_TOKEN',
+  'HIAPI_CONTENT_TO_SITE_BASE_URL',
+  'HIAPI_CF_ZONE_ID',
+  'HIAPI_CF_PURGE_TOKEN',
+] as const;
+let savedEnv: Record<string, string | undefined> = {};
+
+beforeAll(async () => {
+  await resetAndSeed();
+});
+
+beforeEach(() => {
+  savedEnv = Object.fromEntries(TOUCHED_ENV.map((k) => [k, process.env[k]]));
+  process.env.HIAPI_RESPONSE_CACHE_TTL_MS = '60000';
+  __resetResponseCacheForTest();
+});
+
+afterEach(() => {
+  clearResponseCache();
+  __resetSitePurgeForTest();
+  for (const k of TOUCHED_ENV) {
+    const v = savedEnv[k];
+    if (v === undefined) delete process.env[k];
+    else process.env[k] = v;
+  }
+});
+
+describe('集成：鉴权先于缓存', () => {
+  test('不带 client token → 401，且不返回缓存内容', async () => {
+    // 先带 token 建立缓存
+    const ok = await app.handle(json('GET', '/announcement?locale=en'));
+    expect(ok.status).toBe(200);
+    expect(ok.headers.get('x-content-cache')).toBe('MISS');
+    const okBody = (await ok.json()) as { code: number };
+    expect(okBody.code).toBe(0);
+
+    // 同 URL 不带 token
+    const res = await app.handle(new Request('http://localhost/announcement?locale=en'));
+    expect(res.status).toBe(401);
+    const body = (await res.json()) as { code: number; message: string };
+    expect(body.code).toBe(401);
+    expect(body.message).toBe('unauthorized');
+    expect(res.headers.get('x-content-cache')).toBeNull();
+  });
+
+  test('/internal 健康检查不受 client token 限制，也不进缓存', async () => {
+    const a = await app.handle(new Request('http://localhost/internal/model-sync/health'));
+    const b = await app.handle(new Request('http://localhost/internal/model-sync/health'));
+    expect(a.status).toBe(200);
+    expect(b.headers.get('x-content-cache')).toBeNull();
+  });
+});
+
+describe('集成：真实路由 miss → hit', () => {
+  const ROUTES = [
+    '/announcement?locale=en',
+    '/showcases?locale=en',
+    '/models?locale=en',
+    '/blog?locale=en',
+    '/faq?locale=en',
+    '/changelog?locale=en',
+    '/faq/categories?locale=en',
+    '/changelog/categories?locale=en',
+    '/api-doc?locale=en',
+    '/promotions?locale=en',
+    '/playgrounds/bundles?locale=en',
+    '/models/_filters?locale=en',
+    '/models/_names',
+    '/models/_redirects',
+    '/models/_retired',
+    '/pricing?locale=en',
+    '/locales/enabled',
+    '/blog/slugs?locale=en',
+  ];
+
+  for (const path of ROUTES) {
+    test(`${path}：第一次 MISS、第二次 HIT 且内容一致`, async () => {
+      const r1 = await app.handle(json('GET', path));
+      expect(r1.status).toBe(200);
+      expect(r1.headers.get('x-content-cache')).toBe('MISS');
+      const body1 = await r1.text();
+
+      const r2 = await app.handle(json('GET', path));
+      expect(r2.status).toBe(200);
+      expect(r2.headers.get('x-content-cache')).toBe('HIT');
+      expect(await r2.text()).toBe(body1);
+    });
+  }
+});
+
+describe('集成：命中不查库（容量来源）', () => {
+  test('命中不进 service（DB 查询入口调用次数不变）', async () => {
+    const { AnnouncementService } = await import('../../src/modules/announcement/service');
+    let calls = 0;
+    const orig = AnnouncementService.list.bind(AnnouncementService);
+    // 计数包装：命中原样返回，但能看出 handler 是否真的执行到 DB 层
+    (AnnouncementService as unknown as { list: typeof orig }).list = ((locale?: string) => {
+      calls++;
+      return orig(locale);
+    }) as typeof orig;
+    try {
+      const r1 = await app.handle(json('GET', '/announcement?locale=en'));
+      expect(r1.status).toBe(200);
+      expect(r1.headers.get('x-content-cache')).toBe('MISS');
+      expect(calls).toBe(1);
+
+      const stats1 = responseCacheStats();
+      const r2 = await app.handle(json('GET', '/announcement?locale=en'));
+      expect(r2.headers.get('x-content-cache')).toBe('HIT');
+      expect(calls).toBe(1); // 命中原样不触库
+
+      // 对照：另一个 locale 未缓存 → 必须再进 service
+      const r3 = await app.handle(json('GET', '/announcement?locale=ja'));
+      expect(r3.headers.get('x-content-cache')).toBe('MISS');
+      expect(calls).toBe(2);
+
+      const stats2 = responseCacheStats();
+      expect(stats2.hits).toBe(stats1.hits + 1);
+      expect(stats2.misses).toBe(stats1.misses + 1); // 只有未命中那次计 miss
+    } finally {
+      (AnnouncementService as unknown as { list: typeof orig }).list = orig;
+    }
+  });
+});
+
+describe('集成：真实路由单飞', () => {
+  test('同 key 并发 5 个 → service 只进 1 次，其余 COALESCED 且内容一致', async () => {
+    const { AnnouncementService } = await import('../../src/modules/announcement/service');
+    let calls = 0;
+    const orig = AnnouncementService.list.bind(AnnouncementService);
+    (AnnouncementService as unknown as { list: typeof orig }).list = (async (locale?: string) => {
+      calls++;
+      await new Promise((r) => setTimeout(r, 50)); // 拉长领头窗口，保证其余请求挂上 flight
+      return orig(locale);
+    }) as typeof orig;
+    try {
+      const results = await Promise.all(
+        Array.from({ length: 5 }, () => app.handle(json('GET', '/announcement?locale=en'))),
+      );
+      expect(calls).toBe(1);
+      const markers = results.map((r) => r.headers.get('x-content-cache')).sort();
+      expect(markers).toEqual(['COALESCED', 'COALESCED', 'COALESCED', 'COALESCED', 'MISS']);
+      const bodies = await Promise.all(results.map((r) => r.text()));
+      expect(new Set(bodies).size).toBe(1);
+      expect(responseCacheStats().flights).toBe(0);
+    } finally {
+      (AnnouncementService as unknown as { list: typeof orig }).list = orig;
+    }
+  });
+});
+
+describe('集成：写后失效（真实写路由）', () => {
+  test('POST /announcement 成功后缓存清空，再 GET 拿到新内容', async () => {
+    // 基线：先读一次建立缓存
+    const before = await app.handle(json('GET', '/announcement?locale=en'));
+    expect(before.status).toBe(200);
+    expect(responseCacheStats().entries).toBeGreaterThan(0);
+
+    const created = await app.handle(
+      json(
+        'POST',
+        '/announcement',
+        {
+          base: { enabled: true, level: 'info' },
+          sequence: 1,
+          translations: [{ locale: 'en', message: 'cache-invalidation-probe' }],
+        },
+        { ...AUTH, cookie: staffCookie() },
+      ),
+    );
+    expect(created.status).toBe(200);
+    expect(responseCacheStats().entries).toBe(0); // 写成功即清空
+
+    const after = await app.handle(json('GET', '/announcement?locale=en'));
+    expect(after.headers.get('x-content-cache')).toBe('MISS');
+    expect(await after.text()).toContain('cache-invalidation-probe');
+  });
+});
+
+describe('集成：site-purge 前先清缓存', () => {
+  let sent = 0;
+  beforeEach(() => {
+    sent = 0;
+    process.env.SITE_PURGE_TOKEN = 'purge-token';
+    process.env.HIAPI_CONTENT_TO_SITE_BASE_URL = 'https://site.test';
+    delete process.env.HIAPI_CF_ZONE_ID;
+    delete process.env.HIAPI_CF_PURGE_TOKEN;
+    __installSitePurgeTestDeps({
+      fetch: (async () => {
+        sent++;
+        return new Response('{"purged":true}', { status: 200 });
+      }) as unknown as typeof fetch,
+    });
+  });
+
+  test('collectSitePurge 不逐事件清：多个同步事件合并到 flush 时清一次（发 purge 之前）', async () => {
+    const entriesAtSend: number[] = [];
+    __installSitePurgeTestDeps({
+      fetch: (async () => {
+        sent++;
+        entriesAtSend.push(responseCacheStats().entries); // 发 purge 时本缓存必须已清空（站点收到 purge 立刻回源）
+        return new Response('{"purged":true}', { status: 200 });
+      }) as unknown as typeof fetch,
+      query: async () => new Map(),
+    });
+    await app.handle(json('GET', '/announcement?locale=en'));
+    collectSitePurge(['fam-1']);
+    collectSitePurge(['fam-2']);
+    expect(responseCacheStats().entries).toBeGreaterThan(0); // 收集时不清
+    await __flushSitePurgeForTest();
+    expect(sent).toBeGreaterThan(0);
+    expect(entriesAtSend.every((n) => n === 0)).toBe(true);
+    expect(responseCacheStats().entries).toBe(0);
+  });
+
+  test('purgeSitePaths 调用后缓存条目归零（站点回源不会拿到旧内容）', async () => {
+    await app.handle(json('GET', '/announcement?locale=en'));
+    expect(responseCacheStats().entries).toBeGreaterThan(0);
+
+    await purgeSitePaths(['/en', '/en/models']);
+    expect(sent).toBeGreaterThan(0);
+    expect(responseCacheStats().entries).toBe(0);
+  });
+
+  test('站点 purge 请求本身失败也照样清本缓存（不能因站点不可用而留旧内容）', async () => {
+    __installSitePurgeTestDeps({
+      fetch: (async () => {
+        throw new Error('site down');
+      }) as unknown as typeof fetch,
+    });
+    await app.handle(json('GET', '/announcement?locale=en'));
+    const entriesBefore = responseCacheStats().entries;
+    expect(entriesBefore).toBeGreaterThan(0);
+
+    await purgeSitePaths(['/en']);
+    expect(responseCacheStats().entries).toBe(0);
+  });
+});
+
+describe('集成：purge 通道不可用时也清本缓存', () => {
+  test('env 未配时 collectSitePurge 按 3s 窗口合并清本进程缓存', async () => {
+    delete process.env.SITE_PURGE_TOKEN;
+    delete process.env.HIAPI_CONTENT_TO_SITE_BASE_URL;
+    delete process.env.HIAPI_CF_ZONE_ID;
+    delete process.env.HIAPI_CF_PURGE_TOKEN;
+    await app.handle(json('GET', '/announcement?locale=en'));
+    collectSitePurge(['fam-1']);
+    collectSitePurge(['fam-2']);
+    expect(responseCacheStats().entries).toBeGreaterThan(0);
+    await Bun.sleep(3_200);
+    expect(responseCacheStats().entries).toBe(0);
+  }, 10_000);
+
+  test('env 未配（envConfig 返回 null）时 purgeSitePaths 仍清本进程缓存', async () => {
+    delete process.env.SITE_PURGE_TOKEN;
+    delete process.env.HIAPI_CONTENT_TO_SITE_BASE_URL;
+    delete process.env.HIAPI_CF_ZONE_ID;
+    delete process.env.HIAPI_CF_PURGE_TOKEN;
+
+    await app.handle(json('GET', '/announcement?locale=en'));
+    expect(responseCacheStats().entries).toBeGreaterThan(0);
+
+    await purgeSitePaths(['/en']);
+    expect(responseCacheStats().entries).toBe(0);
+  });
+});
diff --git a/apps/content-api/tests/plugins/response-cache.test.ts b/apps/content-api/tests/plugins/response-cache.test.ts
new file mode 100644
index 00000000..1c0bf896
--- /dev/null
+++ b/apps/content-api/tests/plugins/response-cache.test.ts
@@ -0,0 +1,503 @@
+// response-cache 插件单测：不依赖 DB / 业务路由（挂临时 app，白名单 key 复用真实路径形态）。
+//
+// 覆盖（对齐任务卡验收 1）：
+//   miss→hit；不同 query/locale 不串；50 并发同 key → handler 只执行 1 次；TTL 到期重新执行；
+//   handler 失败不入缓存、等待者都失败；POST 成功后清空；TTL=0 完全旁路；
+//   未带 token（onRequest 鉴权失败）不返回缓存；Accept-Language 协商进 key。
+import { describe, test, expect, beforeEach, afterEach } from 'bun:test';
+import { Elysia } from 'elysia';
+import { apiError } from '@hiapi/content-sdk';
+import { responseCache } from '../../src/plugins/response-cache';
+import { envelope } from '../../src/plugins/envelope';
+import { NotFoundError } from '../../src/utils/errors';
+import {
+  clearResponseCache,
+  responseCacheStats,
+  __resetResponseCacheForTest,
+} from '../../src/utils/response-cache';
+
+let handlerCalls = 0;
+let failNext = false;
+let slowMs = 0;
+
+/** 临时 app：/announcement（不协商头）、/showcases（协商 Accept-Language）、POST /write（写后清空）。 */
+function buildApp(opts: { withAuthGuard?: boolean; requireToken?: string } = {}) {
+  const app = new Elysia();
+  if (opts.withAuthGuard === true) {
+    app.onRequest(({ request, set }) => {
+      const expected = `Bearer ${opts.requireToken}`;
+      if (request.headers.get('authorization') !== expected) {
+        set.status = 401;
+        return apiError(401, 'unauthorized') as unknown as Response;
+      }
+      return undefined;
+    });
+  }
+  return app
+    .use(responseCache)
+    .get('/announcement', async ({ query }) => {
+      handlerCalls++;
+      if (slowMs > 0) await Bun.sleep(slowMs);
+      if (failNext) throw new Error('boom');
+      return { code: 0, message: 'ok', data: { locale: query.locale ?? 'en', n: handlerCalls } };
+    })
+    .get('/showcases', async ({ query, headers, set }) => {
+      handlerCalls++;
+      set.headers['vary'] = 'Accept-Language';
+      const al = headers['accept-language'] ?? 'en';
+      return { code: 0, message: 'ok', data: { locale: query.locale ?? al, n: handlerCalls } };
+    })
+    .post('/write', () => ({ code: 0, message: 'ok', data: { written: true } }));
+}
+
+let app: Elysia;
+let saved: Record<string, string | undefined> = {};
+const ENV_KEYS = [
+  'HIAPI_RESPONSE_CACHE_TTL_MS',
+  'HIAPI_RESPONSE_CACHE_MAX_ENTRIES',
+  'HIAPI_RESPONSE_CACHE_MAX_BYTES',
+  'HIAPI_RESPONSE_CACHE_WAIT_MS',
+];
+
+beforeEach(() => {
+  __resetResponseCacheForTest();
+  // 测试进程预置 TTL=0（tests/support/clean-env.ts：默认关缓存）——本文件显式开一个等效默认值，
+  // 断言「TTL 默认」的用例临时删 key 即可；文件结束原样恢复（不污染同进程后续文件）。
+  saved = Object.fromEntries(ENV_KEYS.map((k) => [k, process.env[k]]));
+  process.env.HIAPI_RESPONSE_CACHE_TTL_MS = '60000';
+  delete process.env.HIAPI_RESPONSE_CACHE_MAX_ENTRIES;
+  delete process.env.HIAPI_RESPONSE_CACHE_MAX_BYTES;
+  handlerCalls = 0;
+  failNext = false;
+  slowMs = 0;
+  app = buildApp();
+});
+
+afterEach(() => {
+  for (const [k, v] of Object.entries(saved)) {
+    if (v === undefined) delete process.env[k];
+    else process.env[k] = v;
+  }
+  clearResponseCache();
+});
+
+describe('response-cache：基本命中', () => {
+  test('miss → hit：第二次不执行 handler，x-content-cache 依次为 MISS / HIT', async () => {
