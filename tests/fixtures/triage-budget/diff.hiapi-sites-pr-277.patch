+// 指标行插件（P1）：每 60s 打**一行** JSON，覆盖过载排查需要的最小集合。
+// 为什么会卡死时看不到东西（11-17 复盘）：没有任何进程内指标，只能靠外部抓 5432 流量反推。
+//
+// 内容：pool（Prisma 池 total/idle/waiting）+ in-flight（当前/峰值/503 数）+ 响应缓存（hits/misses/
+// coalesced/entries/bytes/evictions）+ ttl/maxInflight 生效值。
+// 拿不到池时 `pool` 写 `{ error: "<原因>" }` 而不是省略（否则线上分不清「0 连接」和「读不到」）。
+//
+// 只在 main 入口启用（见 src/index.ts），测试进程不装定时器；`logStatsLine()` 导出供测试断言格式。
+import { Elysia } from 'elysia';
+import { dbPoolStats } from '../db/client';
+import { responseCacheStats } from '../utils/response-cache';
+import { inflightStats } from './inflight-limit';
+
+const INTERVAL_MS = 60_000;
+
+/** 组装一行指标（纯函数，便于测试）。 */
+export function statsSnapshot(): Record<string, unknown> {
+  const pool = dbPoolStats();
+  return {
+    ts: new Date().toISOString(),
+    pool: pool === null ? { error: 'not connected yet' } : { total: pool.total, idle: pool.idle, waiting: pool.waiting },
+    inflight: inflightStats(),
+    cache: responseCacheStats(),
+  };
+}
+
+/** 打一行 `[content-api] stats {json}`。 */
+export function logStatsLine(): void {
+  try {
+    console.info(`[content-api] stats ${JSON.stringify(statsSnapshot())}`);
+  } catch (e) {
+    console.error('[content-api] stats line failed', e);
+  }
+}
+
+let timer: ReturnType<typeof setInterval> | null = null;
+
+/** 启动 60s 指标（main 入口用；幂等）。`.unref()` 不阻进程退出。 */
+export function startStatsLogger(): void {
+  if (timer !== null) return;
+  timer = setInterval(logStatsLine, INTERVAL_MS);
+  timer.unref?.();
+}
+
+/** 停止（测试 / 排水用）。 */
+export function stopStatsLogger(): void {
+  if (timer === null) return;
+  clearInterval(timer);
+  timer = null;
+}
+
+/**
+ * 空插件占位：指标不挂任何 HTTP 生命周期，仅由 index.ts 的 main 段调 startStatsLogger()。
+ * 保留导出以便组装处 `.use(metrics)` 读起来连贯（与其它插件同构），无运行时副作用。
+ */
+export const metrics = new Elysia({ name: 'metrics' });
