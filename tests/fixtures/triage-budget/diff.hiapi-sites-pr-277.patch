+// 准入上限插件（P1·过载修复第二环）
+//
+// 根因链第 4 环「白干活」：突发把池压满后，排队超过站点 15s 放弃，但服务端仍把每个请求做完 ——
+// 吞吐占满、有效产出接近 0。本地复现 S5b 证明：in-flight 超阈值直接 503，能把「有效产出 0」变成
+// 「按容量出活」（2xx 稳定在容量上限、p50 < 1s）。
+//
+// 计数口径（Elysia 1.4.28 实测行为，改动前必读）：
+//   - 计数在全局 `onBeforeHandle` +1：clientAuthGuard 是 onRequest，故**鉴权先于计数**（401 不占名额）；
+//   - 减在全局 `onAfterResponse`：-**handler 抛错**（走 onError）后仍触发；-**客户端中途断开**后仍触发
+//     （实测：handler 会照常跑完，随后 mapResponse/afterResponse 补触发）→ 不会因断开泄漏计数；
+//   - **onRequest 阶段短路**（鉴权 401/503、CORS preflight）时 onBeforeHandle 根本不跑，故不 +1；
+//   - 缓存命中（responseCache 的 onBeforeHandle 先于本插件注册）已短路，本插件不跑 → 命中不受限。
+//   - 本插件自身超限返回 503 时**不 +1**，故不会重复扣减。
+//
+// 豁免：整个 `/internal/*` 面——健康检查（Railway / backend 门控）与 model-sync 的 hook、reconcile 等内部入口。
+//   理由：都带内部 token、频率低；被 503 的代价比过载更糟（健康探针失败会摘流量，同步 hook 被拒要靠对端重试）。
+//   代价：这些请求不进 inflight/shed 统计。缓存命中不受限由上面的注册顺序天然满足。
+//
+// env：HIAPI_MAX_INFLIGHT（默认 64；与 Prisma 池 max 5 的关系是「排队深度」而非并发度）。
+import { Elysia } from 'elysia';
+import { apiError } from '@hiapi/content-sdk';
+
+/** 计数在案的请求（每个只能在 afterResponse 里减一次）。 */
+const counted = new WeakSet<Request>();
+
+let inflight = 0;
+let shed = 0;
+let peak = 0;
+
+function maxInflight(): number {
+  const raw = process.env.HIAPI_MAX_INFLIGHT;
+  if (raw === undefined || raw === '') return 64;
+  const n = Number(raw);
+  return Number.isFinite(n) && n >= 0 ? Math.floor(n) : 64;
+}
+
+export function inflightStats(): { inflight: number; peak: number; shed: number; max: number } {
+  return { inflight, peak, shed, max: maxInflight() };
+}
+
+/** 测试复位。 */
+export function __resetInflightForTest(): void {
+  inflight = 0;
+  shed = 0;
+  peak = 0;
+}
+
+const HEALTH_PREFIX = '/internal';
+
+export const inflightLimit = new Elysia({ name: 'inflight-limit' })
+  .onBeforeHandle({ as: 'global' }, ({ request, set }) => {
+    const { pathname } = new URL(request.url);
+    // 整个 /internal 面不受准入限制（理由见文件头）。
+    if (pathname === HEALTH_PREFIX || pathname.startsWith(`${HEALTH_PREFIX}/`)) return undefined;
+    const max = maxInflight();
+    if (max > 0 && inflight >= max) {
+      shed++;
+      // 为什么手写 Response 而不是 `set.status = 503; return apiError(...)`：onBeforeHandle 返回普通对象
+      // 会被当成 handler 结果走路由的 response 校验，503 不在各路由声明的分支里 → 被判 422。
+      // 返回 Response 跳过校验，body 仍用 apiError() 构造，信封形态与 envelope 插件一致。
+      set.status = 503;
+      set.headers['x-content-cache'] = 'BYPASS';
+      return new Response(JSON.stringify(apiError(503, 'busy')), {
+        status: 503,
+        headers: { 'content-type': 'application/json;charset=utf-8', 'x-content-cache': 'BYPASS' },
+      });
+    }
+    inflight++;
+    if (inflight > peak) peak = inflight;
+    counted.add(request);
+    return undefined;
+  })
+  .onAfterResponse({ as: 'global' }, ({ request }) => {
+    if (!counted.has(request)) return;
+    counted.delete(request);
+    if (inflight > 0) inflight--;
+  });
