@@ -0,0 +1,472 @@
+// 响应缓存（进程内·P0 过载修复）：缓存状态、清空入口与钩子实现。Elysia 注册在 plugins/response-cache.ts。
+//
+// 背景（已核实根因，~/.local/share/lingdao-cards/content-api-pool-rootcause-1117/REPORT.md 甲类）：
+// 站点 Worker 突发回源 → 热门 GET 列表接口把 Prisma 池（max 5）压满排队 → 超过 15s 站点放弃但服务端照做 →
+// 站点失败不缓存、重复回源放大 → 亚稳态卡死。本模块断的是「容量」这一环：公共只读目录数据命中缓存后
+// 几乎不占 DB 连接，同时用单飞把同一 key 的并发压成一次执行（突发时不再 N 份重复查询）。
+//
+// 机制要点（Elysia 1.4.28 实测结论，勿凭直觉改）：
+//   1. 命中：全局 `onBeforeHandle` 返回**已序列化 body 的 Response** → 跳过 handler、跳过 response 校验。
+//      ⚠️ 绝不能返回字符串/对象当 body：那会走 response 校验并被判 422。
+//   2. 存：全局 `mapResponse` 拿到的 `response` 是**response 校验之后**的树枝对象（信封），此处
+//      `JSON.stringify` 一次并落库，回一个带 `content-type` 的 Response（命中时直接用同一份字符串）。
+//   3. `set.headers`（含 handler 设的 `vary: Accept-Language`）会与这里返回的 Response 头合并，
+//      故缓存条目只需记 `vary`，其余请求级头（CORS 等）由各自钩子补。
+//   4. 写后失效：任何非 GET/HEAD 成功响应（2xx）→ 清空整个缓存（写很少，简单可靠）。清空发生在
+//      `mapResponse`（同步于响应映射）而非 `onAfterResponse`（经 setImmediate 异步），避免写返回与
+//      清空之间留下重放旧内容的时间窗。
+//   5. site-purge 发清站点缓存请求**之前**必须先清本缓存（见 modules/model-sync/site-purge.ts 接线），
+//      否则站点回源拿到的仍是旧缓存。
+//
+// 白名单原则（宁缺毋滥）：只缓存「输出与请求身份无关」的公开 GET；读 header/cookie/会话/staff 身份的路由
+// 一律不进（审计结论见报告 REPORT-api.md）。依赖「当前时间」的路由可进，代价是最多晚一个 TTL 生效。
+//
+// env：
+//   HIAPI_RESPONSE_CACHE_TTL_MS       默认 60000；`0` = 缓存整体关闭（紧急开关；旁路时不读不写、也不写 x-content-cache 头）
+//   HIAPI_RESPONSE_CACHE_MAX_ENTRIES  默认 2000（LRU 淘汰）
+//   HIAPI_RESPONSE_CACHE_MAX_BYTES    默认 64MB（LRU 淘汰）
+//   HIAPI_RESPONSE_CACHE_WAIT_MS      默认 12000（单飞等待上限，超时回 503 busy，防「领头请求卡住拖死等待者」）
+import { ElysiaCustomStatusResponse, type Context } from 'elysia';
+import { apiError } from '@hiapi/content-sdk';
+import { resolveLocale } from './accept-language';
+
+/** 缓存条目：序列化后的响应体 + 需重放的响应头 + 记账字段。 */
+interface CacheEntry {
+  body: string;
+  status: number;
+  contentType: string;
+  vary?: string;
+  bytes: number;
+  expiresAt: number;
+}
+
+/**
+ * 单飞结果（领头请求在 mapResponse/onAfterResponse 时 settle）。
+ * resolve 的 entry 是领头的最终响应：2xx 成功信封（同时落缓存），或 4xx/5xx 错误信封（不落缓存，
+ * 等待者原样应答——同一 URL 并发拿到同一类结果，404 不会被等待者折成 503）。
+ * reject 只用于拿不到可重放响应的情况（handler 抛错未经 mapResponse、响应是原生 Response 等），等待者回 503。
+ */
+type Flight = {
+  promise: Promise<CacheEntry>;
+  resolve: (entry: CacheEntry) => void;
+  reject: (err: unknown) => void;
+  request: Request;
+  /** 挂上来的等待者数（只用于失败日志）。 */
+  waiters: number;
+};
+
+/**
+ * 白名单：路径模式（Elysia 同款 `:param` 段语法）+ 是否需要把协商后的 Accept-Language 并入 key。
+ *
+ * `negotiatesHeader` = true 的路由在 handler 里 `resolveLocale(query.locale, accept-language)`：
+ * 输出随「协商结果」而非 header 字面值变化，故 key 用协商后的 locale（不同 header 协商到同一 locale
+ * 得到同一份缓存，正确且不碎片化）。
+ *
+ * 全部候选路由的逐条审计（读 header / 会话 / staff / 当前时间）见 REPORT-api.md 的「白名单审计表」。
+ */
+const WHITELIST: readonly { pattern: string; negotiatesHeader: boolean }[] = [
+  // ——— 站点回源主力（生产流量 Top）———
+  { pattern: '/announcement', negotiatesHeader: false }, // ?locale=；按当前时间筛生效窗口（最多晚一个 TTL）
+  // ⚠️ 字面量段必须排在参数段之前：/blog/slugs 不能被 /blog/:slug 吃掉（否则 key 维度用错）。
+  { pattern: '/blog/slugs', negotiatesHeader: false },
+  { pattern: '/showcases', negotiatesHeader: true },
+  { pattern: '/showcases/cards', negotiatesHeader: true },
+  { pattern: '/showcases/:slug', negotiatesHeader: true },
+  // ——— 模型目录 ———
+  { pattern: '/models', negotiatesHeader: false },
+  { pattern: '/models/page/:modelSlug', negotiatesHeader: false }, // ?locale=&route=
+  { pattern: '/models/_names', negotiatesHeader: false },
+  { pattern: '/models/_filters', negotiatesHeader: false },
+  { pattern: '/models/_redirects', negotiatesHeader: false },
+  { pattern: '/models/_retired', negotiatesHeader: false },
+  { pattern: '/pricing', negotiatesHeader: false },
+  // ——— 内容面 ———
+  { pattern: '/blog', negotiatesHeader: false },
+  { pattern: '/blog/:slug', negotiatesHeader: false },
+  { pattern: '/playgrounds/bundles', negotiatesHeader: false },
+  { pattern: '/playgrounds/models/:id', negotiatesHeader: false },
+  { pattern: '/promotions', negotiatesHeader: false }, // buildLiveWhere 含时间窗（最多晚一个 TTL）
+  { pattern: '/promotions/:slug', negotiatesHeader: false },
+  { pattern: '/faq', negotiatesHeader: true },
+  { pattern: '/faq/categories', negotiatesHeader: true },
+  { pattern: '/changelog', negotiatesHeader: true },
+  { pattern: '/changelog/categories', negotiatesHeader: true },
+  { pattern: '/changelog/feed', negotiatesHeader: true },
+  { pattern: '/changelog/:id', negotiatesHeader: true },
+  { pattern: '/api-doc', negotiatesHeader: false },
+  { pattern: '/locales/enabled', negotiatesHeader: false },
+];
+
+/** 编译成 { regex, negotiatesHeader }；`:param` 只匹配单段（故 /blog/:slug 不会误吃 /blog/x/translations/en/raw）。 */
+const ROUTES: readonly { regex: RegExp; negotiatesHeader: boolean }[] = WHITELIST.map((r) => {
+  const source = r.pattern
+    .split('/')
+    .map((seg) => (seg.startsWith(':') ? '[^/]+' : seg.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')))
+    .join('/');
+  return { regex: new RegExp(`^${source}$`), negotiatesHeader: r.negotiatesHeader };
+});
+
+function matchRoute(pathname: string): { negotiatesHeader: boolean } | null {
+  for (const route of ROUTES) if (route.regex.test(pathname)) return route;
+  return null;
+}
+
+/** env 数值读取：非法/负数按默认值（防误配成 "abc" 静默关掉缓存）。 */
+function envInt(name: string, fallback: number): number {
+  const raw = process.env[name];
+  if (raw === undefined || raw === '') return fallback;
+  const n = Number(raw);
+  return Number.isFinite(n) && n >= 0 ? Math.floor(n) : fallback;
+}
+
+function ttlMs(): number {
+  return envInt('HIAPI_RESPONSE_CACHE_TTL_MS', 60_000);
+}
+function maxEntries(): number {
+  return envInt('HIAPI_RESPONSE_CACHE_MAX_ENTRIES', 2_000);
+}
+function maxBytes(): number {
+  return envInt('HIAPI_RESPONSE_CACHE_MAX_BYTES', 64 * 1024 * 1024);
+}
+function waitMs(): number {
+  return envInt('HIAPI_RESPONSE_CACHE_WAIT_MS', 12_000);
+}
+
+// ———————————————————————— 缓存存储（手写 LRU：Map 插入序 + get 时搬到末尾）————————————————————————
+const cache = new Map<string, CacheEntry>();
+const flights = new Map<string, Flight>();
+/** 领头请求 → 它的 flight（mapResponse/onAfterResponse 用请求本身找回 key，不靠重算 URL 维度）。 */
+const flightOfRequest = new WeakMap<Request, { key: string; flight: Flight; generation: number }>();
+
+let hits = 0;
+let misses = 0;
+let coalesced = 0;
+let evictions = 0;
+let totalBytes = 0;
+
+/**
+ * 缓存世代（写-清竞态，审计风险点 5）：
+ * 「写前开始、写后才完成的 GET」若在清空之后落库，会把写前的旧数据写回缓存，导致「刚发布却又是旧内容」
+ * 直到下个 TTL。修法：清空时 generations++，GET 在开始（onBeforeHandle 领头处）记下当前世代，
+ * 落缓存时世代不一致就丢弃。flight 也按世代判定——跨代的 in-flight 结果不喂给清空后的等待者。
+ */
+let generation = 0;
+
+/** 清空本缓存（写请求成功、site-purge 前、测试复位）；同时推进世代，让在途的旧读结果不再落库。 */
+export function clearResponseCache(): void {
+  cache.clear();
+  // 在途 flight 也摘掉：清空之后到达的请求必须自己当领头去读新数据，不能挂到清空前开始的旧读上
+  // （否则旧读按世代被判废，后到者只能拿 503——purge 后站点立刻回源正好撞上，等于这次刷新白发）。
+  // 旧领头仍持有自己的 flight，完成后照常 settle 它原有的等待者（见 mapResponse）。
+  flights.clear();
+  totalBytes = 0;
+  generation++;
+}
+
+/** 缓存指标（测试 / 指标行）。`inflight` 由 plugins/inflight.ts 另计，不在此。 */
+export function responseCacheStats(): {
+  hits: number;
+  misses: number;
+  coalesced: number;
+  evictions: number;
+  entries: number;
+  bytes: number;
+  flights: number;
+  ttlMs: number;
+} {
+  return {
+    hits,
+    misses,
+    coalesced,
+    evictions,
+    entries: cache.size,
+    bytes: totalBytes,
+    flights: flights.size,
+    ttlMs: ttlMs(),
+  };
+}
+
+/** 测试复位（计数与内容都归零；不动 env）。 */
+export function __resetResponseCacheForTest(): void {
+  cache.clear();
+  flights.clear();
+  totalBytes = 0;
+  hits = 0;
+  misses = 0;
+  coalesced = 0;
+  evictions = 0;
+}
+
+/**
+ * 归一化 query：只按参数名排序（稳定排序，同名参数保留原顺序），重建稳定串。
+ * 同名参数不能按值排：Elysia 对标量参数取最后一个值，`?locale=en&locale=zh` 与 `?locale=zh&locale=en`
+ * 含义不同，按值排会把两者归成同一个 key 而串内容。
+ */
+function canonicalQuery(searchParams: URLSearchParams): string {
+  const pairs = [...searchParams.entries()].sort((a, b) => (a[0] === b[0] ? 0 : a[0] < b[0] ? -1 : 1));
+  return pairs.map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');
+}
+
+/** 缓存 key：method + 完整 path + 规范化 query（+ 协商 locale 维度）。 */
+function cacheKey(request: Request, route: { negotiatesHeader: boolean }): string {
+  const url = new URL(request.url);
+  const query = canonicalQuery(url.searchParams);
+  if (!route.negotiatesHeader) return `${request.method} ${url.pathname}?${query}`;
+  const acceptLanguage = request.headers.get('accept-language') ?? undefined;
+  const locale = resolveLocale(url.searchParams.get('locale') ?? undefined, acceptLanguage);
+  return `${request.method} ${url.pathname}?${query}|al=${locale}`;
+}
+
+function byteLength(s: string): number {
+  return Buffer.byteLength(s, 'utf8');
+}
+
+/** 取未过期条目；命中则搬到 LRU 末尾。 */
+function readEntry(key: string): CacheEntry | null {
+  const entry = cache.get(key);
+  if (entry === undefined) return null;
+  if (entry.expiresAt <= Date.now()) {
+    cache.delete(key);
+    totalBytes -= entry.bytes;
+    return null;
+  }
+  cache.delete(key);
+  cache.set(key, entry); // LRU：最近使用搬到末尾
+  return entry;
+}
+
+/** 写入 + 容量淘汰（条目数 / 总字节双上限，都按 LRU 从前端淘汰）。 */
+function writeEntry(key: string, entry: CacheEntry): void {
+  const existing = cache.get(key);
+  if (existing !== undefined) {
+    totalBytes -= existing.bytes;
+    cache.delete(key);
+  }
+  cache.set(key, entry);
+  totalBytes += entry.bytes;
+  const maxE = maxEntries();
+  const maxB = maxBytes();
+  while (cache.size > 0 && (cache.size > maxE || totalBytes > maxB)) {
+    const oldest = cache.keys().next();
+    if (oldest.done === true) break;
+    const victim = cache.get(oldest.value);
+    cache.delete(oldest.value);
+    if (victim !== undefined) totalBytes -= victim.bytes;
+    evictions++;
+  }
+}
+
+/** 构造命中响应：重放 content-type/vary，带 x-content-cache，遵循 set.headers 合并（CORS 由 onRequest 钩子补）。 */
+function hitResponse(entry: CacheEntry, marker: 'HIT' | 'COALESCED'): Response {
+  const headers: Record<string, string> = {
+    'content-type': entry.contentType,
+    'x-content-cache': marker,
+  };
+  if (entry.vary !== undefined) headers.vary = entry.vary;
+  return new Response(entry.body, { status: entry.status, headers });
+}
+
+/** 单飞等待者失败（等待超时 / 领头失败）的 503 busy：手写 Response 跳过路由 response 校验（同 inflight-limit）。 */
+function busyResponse(): Response {
+  return new Response(JSON.stringify(apiError(503, 'busy')), {
+    status: 503,
+    headers: { 'content-type': 'application/json;charset=utf-8', 'x-content-cache': 'COALESCED' },
+  });
+}
+
+/** 缓存关闭（TTL=0）时的旁路判定：所有钩子直接返回，不读不写不记账。 */
+function bypassed(): boolean {
+  return ttlMs() <= 0;
+}
+
+/** 只摘掉「仍是自己」的 flight：清空后同 key 可能已有新领头，不能误删别人的。 */
+function detachFlight(key: string, flight: Flight): void {
+  if (flights.get(key) === flight) flights.delete(key);
+  flightOfRequest.delete(flight.request);
+}
+
+/** 单飞领头请求拿不到可重放的响应：所有等待者一起回 503（不入缓存）。有等待者时记一行，便于追原因。 */
+function settleFlightError(leader: { key: string; flight: Flight }, err: unknown): void {
+  const { key, flight } = leader;
+  detachFlight(key, flight);
+  if (flight.waiters > 0) {
+    const reason = err instanceof Error ? err.message : String(err);
+    console.warn(`[response-cache] 单飞领头失败，${flight.waiters} 个等待者回 503 key=${key} reason=${reason}`);
+  }
+  flight.reject(err);
+  // 拒绝后没人 await 会触发 unhandledRejection：给个空 catch 兜底（等待方自己 await 的是同一 promise）。
+  flight.promise.catch(() => {});
+}
+
+/**
+ * 领头的响应不可缓存（4xx/5xx 或 code≠0）：能重放就让等待者原样应答（不落缓存，下一个请求照常回源），
+ * 否则等待者回 503。
+ *
+ * 错误路径（handler throw → envelope onError 的 `status(404, apiError(...))`）：Elysia 1.4.28 交给
+ * mapResponse 的是 ElysiaCustomStatusResponse { code, response }，此刻 set.status 仍是 500（实测）——
+ * 必须拆包取真实状态与信封，否则等待者拿到的是 500 + 包装对象。
+ */
+function settleFlightNonCacheable(leader: { key: string; flight: Flight }, response: unknown, status: number): void {
+  const wrapped = response instanceof ElysiaCustomStatusResponse;
+  const replayStatus = wrapped ? Number(response.code) : status;
+  const replayBody: unknown = wrapped ? response.response : response;
+  const replayable =
+    typeof replayBody === 'object' && replayBody !== null && !(replayBody instanceof Response) && Number.isFinite(replayStatus);
+  if (!replayable) {
+    settleFlightError(leader, new Error(`non-replayable response ${status}`));
+    return;
+  }
+  const body = JSON.stringify(replayBody);
+  detachFlight(leader.key, leader.flight);
+  leader.flight.resolve({
+    body,
+    status: replayStatus,
+    contentType: 'application/json;charset=utf-8',
+    bytes: byteLength(body),
+    expiresAt: 0,
+  });
+}
+
+/** Elysia 钩子的 `set`（状态码 / 响应头）。本模块只读写 status 与 headers。 */
+type HookSet = Context['set'];
+
+// ———————————————————————— 钩子实现（插件 plugins/response-cache.ts 只负责注册）————————————————————————
+
+/**
+ * onBeforeHandle：命中直接应答 / 单飞等待。非白名单、非 GET、旁路模式一律放行到 handler。
+ * 单飞等待者最多等 HIAPI_RESPONSE_CACHE_WAIT_MS（默认 12s），超时或领头失败都回 503 busy（不各自再起一轮查询）。
+ */
+export async function cacheBeforeHandle({ request, set }: { request: Request; set: HookSet }): Promise<Response | undefined> {
+  if (bypassed()) return;
+  if (request.method !== 'GET' && request.method !== 'HEAD') return;
+  const { pathname } = new URL(request.url);
+  const route = matchRoute(pathname);
+  if (route === null) return;
+
+  const key = cacheKey(request, route);
+  const cached = readEntry(key);
+  if (cached !== null) {
+    hits++;
+    // 传出去的 body 与缓存条目共用同一字符串（不可变），无需再 stringify。
+    return hitResponse(cached, 'HIT');
+  }
+
+  // 单飞：同 key 已有请求在执行 → 复用它的结果（不再打 DB）。
+  const existing = flights.get(key);
+  if (existing !== undefined) {
+    coalesced++;
+    existing.waiters++;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const timeout = new Promise<null>((resolve) => {
+      timer = setTimeout(() => resolve(null), waitMs());
+      timer.unref?.();
+    });
+    try {
+      const entry = await Promise.race([existing.promise, timeout]);
+      if (entry === null) {
+        // 等待超时：领头请求可能已卡在 DB 上——直接失败，别把等待者一起挂住（也避免它们各自起一轮）。
+        set.status = 503;
+        return busyResponse();
+      }
+      return hitResponse(entry, 'COALESCED');
+    } catch {
+      // 领头失败 → 本请求也失败（不入缓存）；走全局 onError 的信封化路径会丢「同因」，故直接回 503。
+      set.status = 503;
+      return busyResponse();
+    } finally {
+      if (timer !== undefined) clearTimeout(timer);
+    }
+  }
+
+  // 领头：登记 flight，等 mapResponse（成功）或 onAfterResponse（兜底失败）来 settle。
+  misses++;
+  let resolve!: (entry: CacheEntry) => void;
+  let reject!: (err: unknown) => void;
+  const promise = new Promise<CacheEntry>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  promise.catch(() => {}); // 无等待者时也不产生 unhandledRejection
+  const flight: Flight = { promise, resolve, reject, request, waiters: 0 };
+  flights.set(key, flight);
+  flightOfRequest.set(request, { key, flight, generation });
+  return;
+}
+
+// 成功响应落缓存：只存「2xx + 信封 code===0」的 JSON 对象；顺带 settle 单飞。
+// 写后失效也在这里做（而非 onAfterResponse——后者经 setImmediate 异步触发，会给写返回与清空之间
+// 留下一个真实的重放窗口）。
+//
+// ⚠️ 每条路径都必须 **原样 return response（passthrough）**：Elysia 1.4.28 的错误/404 路径上，
+// 全局 mapResponse 返回 undefined 会被当成「替换结果」写回 `_r`，而 `_r` 不会还原成原响应
+// → 404 变 200 空体（实测：/playgrounds/branches/x 由 404 变 200 ""）。故一律 `return response`。
+export function cacheMapResponse({ request, set, response }: { request: Request; set: HookSet; response: unknown }): Response {
+  // 原样透传（绝不可返回 undefined：Elysia 1.4.28 错误路径上 undefined 会吞掉原响应）。
+  // Elysia context 把 response 标成 unknown，这里按契约断言（普通对象被原样返回即「不替换」语义）。
+  const keep = response as unknown as Response;
+  const method = request.method;
+  const status = typeof set.status === 'string' ? Number(set.status) : (set.status ?? 200);
+
+  // 写后失效第一优先：任何非 GET/HEAD 的 2xx（写很少，整体清空简单可靠）。
+  if (method !== 'GET' && method !== 'HEAD') {
+    if (status >= 200 && status < 300) clearResponseCache();
+    return keep;
+  }
+
+  const leader = flightOfRequest.get(request);
+  if (bypassed()) {
+    if (leader !== undefined) settleFlightError(leader, new Error('cache bypassed'));
+    return keep;
+  }
+  const { pathname } = new URL(request.url);
+  const route = matchRoute(pathname);
+  if (route === null) {
+    if (leader !== undefined) settleFlightError(leader, new Error('not whitelisted'));
+    return keep;
+  }
+
+  const isEnvelopeOk =
+    typeof response === 'object' &&
+    response !== null &&
+    !(response instanceof Response) &&
+    (response as { code?: unknown }).code === 0;
+  if (status < 200 || status >= 300 || !isEnvelopeOk) {
+    if (leader !== undefined) settleFlightNonCacheable(leader, response, status);
+    return keep;
+  }
+
+  const body = JSON.stringify(response);
+  const vary = typeof set.headers.vary === 'string' ? set.headers.vary : undefined;
+  const entry: CacheEntry = {
+    body,
+    status,
+    contentType: 'application/json;charset=utf-8',
+    ...(vary !== undefined ? { vary } : {}),
+    bytes: byteLength(body),
+    expiresAt: Date.now() + ttlMs(),
+  };
+  if (leader !== undefined) {
+    const key = leader.key;
+    detachFlight(key, leader.flight);
+    // 世代不一致 = 本次读在清空（写成功 / purge）之前开始、之后才完成 → 结果可能含旧数据，不落缓存。
+    // 等待者都是清空前挂上的（清空时 flights 已摘掉，之后到达的会自己当领头），它们本就开始于写之前，
+    // 拿这份结果与「直接打到 handler」等价，故照常应答而不是 503。
+    if (leader.generation === generation) writeEntry(key, entry);
+    leader.flight.resolve(entry);
+  }
+  set.headers['x-content-cache'] = 'MISS';
+  return new Response(body, {
+    status,
+    headers: { 'content-type': entry.contentType, ...(vary !== undefined ? { vary } : {}) },
+  });
+}
+
+/**
+ * onAfterResponse 兜底：领头请求没走到 mapResponse 的 settle（handler 抛错、被后续钩子短路等），
+ * 在这里把 flight 置失败，等待者一起回 503。不另挂全局 onError——全局 onError 只留 plugins/envelope.ts 一处。
+ * onAfterResponse 经 setImmediate 触发，比 onError 晚一个事件循环 tick，对等待者无实质影响。
+ */
+export function cacheAfterResponse({ request }: { request: Request }): void {
+  const leader = flightOfRequest.get(request);
+  if (leader !== undefined) settleFlightError(leader, new Error('leader finished without cacheable response'));
+}
