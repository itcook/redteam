+// 响应缓存插件：只做钩子注册。缓存状态、白名单、单飞与 clearResponseCache 在 src/utils/response-cache.ts
+// （业务域如 modules/model-sync/site-purge.ts 只依赖 utils，不依赖本插件）。
+//
+// 注册顺序即语义：本插件须在 inflightLimit 之前 .use()，缓存命中在更早的 onBeforeHandle 短路，不占准入名额。
+import { Elysia } from 'elysia';
+import { cacheAfterResponse, cacheBeforeHandle, cacheMapResponse } from '../utils/response-cache';
+
+export const responseCache = new Elysia({ name: 'response-cache' })
+  .onBeforeHandle({ as: 'global' }, (ctx) => cacheBeforeHandle(ctx))
+  .mapResponse({ as: 'global' }, (ctx) => cacheMapResponse(ctx))
+  .onAfterResponse({ as: 'global' }, (ctx) => cacheAfterResponse(ctx));
