+    if (calls === 2) return Promise.reject(new Error("blip"));
+    return { items: [{ slug: "new" }], total: 1 };
+  });
+  const a = modelCardsSnapshot(NO_RUNTIME, "en"); // A：purge 前发出、在途
+  await Bun.sleep(0);
+  await invalidateCatalogSnapshots();
+  await expect(modelCardsSnapshot(NO_RUNTIME, "en")).rejects.toThrow(/blip/); // B：purge 后失败 → 负缓存
+  releaseA();
