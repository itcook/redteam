index 00000000..47d46701
--- /dev/null
+++ b/apps/dashboard/src/lib/api/api-map.test.ts
@@ -0,0 +1,68 @@
+// api-map ↔ 代码 的机器校验。
+//
+// 「返回形态」这一列是人工判定的，选错不会编译报错、也不会让 URL 测试失败，
+// 只会让页面拿到的对象少一层（review 第二轮就抓到 6 行写反）。
+// 这里用源码事实反推：凡是代码里走 `apiEnvelope` 的路径，文档必须标 `body`；
+// 其余标 `data`。任何一边改了另一边没跟上，这条测试就红。
+import { describe, expect, test } from "bun:test";
+import { readFileSync, readdirSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+const API_DIR = new URL("./", import.meta.url);
+const MAP_URL = new URL("../../../docs/api-map.md", import.meta.url);
+
+/** 源码里所有走 `apiEnvelope` 的路径（排除 http.ts 的实现本身与测试）。 */
+function envelopePaths(): Set<string> {
+  const paths = new Set<string>();
+  for (const name of readdirSync(API_DIR)) {
+    if (!name.endsWith(".ts") || name.endsWith(".test.ts") || name === "http.ts") continue;
+    const source = readFileSync(new URL(name, API_DIR), "utf8");
+    for (const match of source.matchAll(/apiEnvelope<[\s\S]*?>\(\s*"([^"]+)"/g)) {
+      if (match[1]) paths.add(match[1]);
+    }
+  }
+  return paths;
+}
+
+interface DocRow {
+  endpoint: string;
+  path: string;
+  form: string;
+}
+
+function docRows(): DocRow[] {
+  const md = readFileSync(fileURLToPath(MAP_URL), "utf8");
+  const rows: DocRow[] = [];
+  for (const line of md.split("\n")) {
+    if (!line.startsWith("| `")) continue;
+    const cols = line.split("|").slice(1, -1).map((c) => c.trim());
+    if (cols.length < 8) continue;
+    const endpoint = (cols[0] ?? "").replaceAll("`", "");
+    const pathMatch = (cols[1] ?? "").match(/`(?:GET|POST|PUT|PATCH|DELETE) ([^`]+)`/);
+    // 从右锚定（鉴权 / 分页 / 返回形态 / 信封族），避免左侧单元格里混入裸 `|` 时错位
+    const form = (cols[cols.length - 3] ?? "").replaceAll("`", "");
+    if (pathMatch?.[1]) rows.push({ endpoint, path: pathMatch[1], form });
+  }
+  return rows;
+}
+
+describe("api-map 的返回形态与代码一致", () => {
+  const rows = docRows();
+  const envelopes = envelopePaths();
+
+  test("文档解析出全部端点（防止表格被改坏后静默空跑）", () => {
+    expect(rows.length).toBe(60);
+  });
+
+  test("每个端点的 data/body 与它实际用的传输入口一致", () => {
+    const mismatched = rows
+      .map((row) => ({
+        ...row,
+        expected: envelopes.has(row.path) ? "body" : "data",
+      }))
+      .filter((row) => row.form !== row.expected)
+      .map((row) => `${row.endpoint} (${row.path}) 文档=${row.form} 实际=${row.expected}`);
+
+    expect(mismatched).toEqual([]);
+  });
+});
