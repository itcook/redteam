@@ -0,0 +1,158 @@
+// auth-flow —— 登出与会话失效的副作用契约。
+//
+// 这两条路径都改过多次（清 cache、per-client 闩、locale 推断），是本仓最高频的回归点，
+// 所以单独锁住：登出必须「清登录态 + 清缓存」两件事都做，缺一个就会串号。
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { createQueryClient } from "@/lib/query-client";
+import { authKeys } from "@/lib/api/keys";
+import { performSignOut } from "./use-sign-out";
+import { handleSessionExpired } from "./session-expiry";
+import { classifyGuardError } from "./session";
+import { ApiError } from "@/lib/api/errors";
+import { useAuthStore } from "./store";
+
+const realFetch = globalThis.fetch;
+const realDocument = (globalThis as { document?: unknown }).document;
+const realWindow = (globalThis as { window?: unknown }).window;
+
+interface Captured {
+  url: string;
+  init: RequestInit;
+}
+let captured: Captured[] = [];
+/** `clearUserId` 用 `document.cookie = ...` 清 cookie；这里记录写入而不是模拟浏览器。 */
+let cookieWrites: string[] = [];
+
+function installWindow(assigned: string[] = []): void {
+  (globalThis as { window?: unknown }).window = {
+    location: {
+      hostname: "localhost",
+      protocol: "http:",
+      pathname: "/",
+      href: "http://localhost/",
+      assign: (url: string) => assigned.push(url),
+    },
+  };
+}
+
+beforeEach(() => {
+  captured = [];
+  cookieWrites = [];
+  (globalThis as { document?: unknown }).document = {
+    get cookie() {
+      return "new-api-user-id=42; other=1";
+    },
+    set cookie(value: string) {
+      cookieWrites.push(value);
+    },
+  };
+  installWindow();
+  globalThis.fetch = (async (input: RequestInfo | URL, init: RequestInit = {}) => {
+    captured.push({ url: typeof input === "string" ? input : String(input), init });
+    return new Response(JSON.stringify({ success: true }), {
+      status: 200,
+      headers: { "content-type": "application/json" },
+    });
+  }) as unknown as typeof fetch;
+  useAuthStore.setState({ state: "user", userId: "42", userName: "u" });
+});
+
+afterEach(() => {
+  globalThis.fetch = realFetch;
+  if (realDocument === undefined) delete (globalThis as { document?: unknown }).document;
+  else (globalThis as { document?: unknown }).document = realDocument;
+  if (realWindow === undefined) delete (globalThis as { window?: unknown }).window;
+  else (globalThis as { window?: unknown }).window = realWindow;
+});
+
+describe("performSignOut", () => {
+  test("打 backend 登出端点，并清空登录态与整个 query cache", async () => {
+    const client = createQueryClient();
+    client.setQueryData(authKeys.self(), { seeded: true });
+
+    await performSignOut(client);
+
+    expect(captured.map((c) => c.url)).toEqual(["/dashboard-api/user/logout"]);
+    expect(client.getQueryCache().getAll()).toHaveLength(0);
+    expect(useAuthStore.getState().state).toBe("guest");
+    // 清 cookie（host-only 与共享域各一次）
+    expect(cookieWrites.length).toBeGreaterThan(0);
+    expect(cookieWrites.every((w) => w.includes("max-age=0"))).toBe(true);
+  });
+
+  test("backend 登出失败也要完成本地登出（会话最终会过期）", async () => {
+    globalThis.fetch = (async () => {
+      throw new Error("network down");
+    }) as unknown as typeof fetch;
+    const client = createQueryClient();
+    client.setQueryData(authKeys.self(), { seeded: true });
+
+    await performSignOut(client);
+
+    expect(client.getQueryCache().getAll()).toHaveLength(0);
+    expect(useAuthStore.getState().state).toBe("guest");
+  });
+});
+
+describe("handleSessionExpired", () => {
+  test("清登录态 + 清缓存 + 跳登录页并带 returnTo", async () => {
+    const assigned: string[] = [];
+    (globalThis as { window?: unknown }).window = {
+      location: {
+        hostname: "console.example",
+        protocol: "https:",
+        pathname: "/zh/dashboard/logs",
+        href: "https://console.example/zh/dashboard/logs",
+        assign: (url: string) => assigned.push(url),
+      },
+    };
+
+    const client = createQueryClient();
+    client.setQueryData(authKeys.self(), { seeded: true });
+
+    handleSessionExpired(client);
+
+    expect(client.getQueryCache().getAll()).toHaveLength(0);
+    expect(useAuthStore.getState().state).toBe("guest");
+    expect(assigned).toHaveLength(1);
+    // locale 从路径首段推出来，returnTo 是当前完整 URL
+    expect(assigned[0]).toContain("/zh/sign?");
+    expect(assigned[0]).toContain("face=signin");
+    expect(assigned[0]).toContain(
