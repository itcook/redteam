+// queryKey 注册表契约测试。
+//
+// 目的不是测 TanStack Query，而是锁住三条本仓约定：
+//   1. 首段恒为域常量（手滑写错域会让失效打到别人身上）；
+//   2. 同参数深度相等、不同参数不等（分页/筛选必须区分缓存条目）；
+//   3. 参数对象原样进入 key（不在 key 工厂里偷偷改写，否则失效对不上）。
+import { describe, expect, test } from "bun:test";
+import {
+  authKeys,
+  billingKeys,
+  logKeys,
+  mcpKeys,
+  modelKeys,
+  overviewKeys,
+  referralKeys,
+  settingsKeys,
+  storageKeys,
+  systemKeys,
+  telegramKeys,
+  ticketKeys,
+  tokenKeys,
+} from "./keys";
+
+const DOMAINS = [
+  authKeys,
+  systemKeys,
+  overviewKeys,
+  tokenKeys,
+  logKeys,
+  billingKeys,
+  referralKeys,
+  settingsKeys,
+  storageKeys,
+  ticketKeys,
+  telegramKeys,
+  modelKeys,
+  mcpKeys,
+];
+
+describe("首段是域常量", () => {
+  test("每个域的 all 首段与其余 key 首段一致", () => {
+    for (const domain of DOMAINS) {
+      const [first] = domain.all;
+      expect(typeof first).toBe("string");
+    }
+    expect(authKeys.self()[0]).toBe(authKeys.all[0]);
+    expect(tokenKeys.list()[0]).toBe(tokenKeys.all[0]);
+    expect(logKeys.list()[0]).toBe(logKeys.all[0]);
+    expect(storageKeys.list()[0]).toBe(storageKeys.all[0]);
+    expect(ticketKeys.detail(1)[0]).toBe(ticketKeys.all[0]);
+  });
+
+  test("不同域的首段互不相同", () => {
+    const heads = DOMAINS.map((d) => d.all[0]);
+    expect(new Set(heads).size).toBe(heads.length);
+  });
+});
+
+describe("参数进入 key", () => {
+  test("同参数深度相等", () => {
+    expect(logKeys.list({ p: 2, per_page: 20 })).toEqual(logKeys.list({ p: 2, per_page: 20 }));
+    expect(storageKeys.billing({ page: 1 })).toEqual(storageKeys.billing({ page: 1 }));
+  });
+
+  test("不同参数不等（翻页不复用上页缓存）", () => {
+    expect(logKeys.list({ p: 1 })).not.toEqual(logKeys.list({ p: 2 }));
+    expect(referralKeys.invitees({ page: 1, page_size: 20 })).not.toEqual(
+      referralKeys.invitees({ page: 2, page_size: 20 }),
+    );
+    expect(ticketKeys.messages(1, 0)).not.toEqual(ticketKeys.messages(1, 99));
+  });
+
+  test("参数对象原样进入 key，不被改写", () => {
+    const params = { p: 3, model_name: "gpt-x" };
+    const [, , paramsInKey] = logKeys.list(params);
+    expect(paramsInKey).toBe(params);
+  });
+
+  test("默认参数形成稳定 key（无参调用可被前缀匹配）", () => {
+    const key = logKeys.list();
+    expect(key).toEqual(["logs", "list", {}]);
+    // partial match：["logs"] 前缀能命中所有日志相关条目
+    expect(key.slice(0, 1)).toEqual(["logs"]);
+  });
+});
+
+describe("资源级 key 的粒度", () => {
+  test("详情类 key 按 id 区分", () => {
+    expect(ticketKeys.detail(1)).not.toEqual(ticketKeys.detail(2));
+    expect(billingKeys.conversionStatus("A")).not.toEqual(billingKeys.conversionStatus("B"));
+    expect(billingKeys.embeddedSession("s1")).not.toEqual(billingKeys.embeddedSession("s2"));
+    expect(tokenKeys.key(7)).not.toEqual(tokenKeys.key(8));
+  });
+
+  test("单例资源 key 恒定", () => {
+    expect(authKeys.self()).toEqual(authKeys.self());
+    expect(settingsKeys.balanceAlerts()).toEqual(["settings", "balance-alerts"]);
+    expect(systemKeys.siteConfig()).toEqual(["system", "site-config"]);
+    expect(overviewKeys.summary()).toEqual(["overview", "summary"]);
+  });
+});
