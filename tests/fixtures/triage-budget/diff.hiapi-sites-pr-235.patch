+++ b/apps/dashboard/src/lib/api/modules.test.ts
@@ -0,0 +1,722 @@
+// 领域模块契约测试：端点 URL/method/参数 + mutation 失效集合。
+//
+// 传输层细节（信封族、错误归一、FormData）在 http.test.ts 已覆盖；这里只验证
+// 「每个域方法打对了端点」与「写操作失效了对的 key」——这两件事错都不会报编译错。
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import type { QueryClient } from "@tanstack/react-query";
+import { createQueryClient } from "@/lib/query-client";
+import {
+  affCodeQuery,
+  affInviteesQuery,
+  affRuleQuery,
+  affWithdrawalQuery,
+  authKeys,
+  authSelfQuery,
+  bindOAuthStateQuery,
+  changePasswordMutation,
+  balanceAlertsQuery,
+  billingKeys,
+  byKeyStatsQuery,
+  callLogListQuery,
+  createTicketMutation,
+  createTokenMutation,
+  createWithdrawalMutation,
+  deleteTokenMutation,
+  embeddedCheckoutStatusQuery,
+  logKeys,
+  logListQuery,
+  mcpConnectionsQuery,
+  overviewSummaryQuery,
+  mcpKeys,
+  overviewKeys,
+  initTelegramBindMutation,
+  pricingQuery,
+  promoteStorageMutation,
+  publicStatusQuery,
+  siteConfigQuery,
+  submitAffApplicationMutation,
+  telegramBindingQuery,
+  telegramInviteLinkQuery,
+  userModelsQuery,
+  removeStorageMutation,
+  revokeAllMcpConnectionsMutation,
+  setAffCodeMutation,
+  redemptionRecordsQuery,
+  redeemCodeMutation,
+  referralKeys,
+  settingsKeys,
+  storageBillingQuery,
+  storageKeys,
+  storageListQuery,
+  telegramKeys,
+  ticketKeys,
+  ticketListQuery,
+  tokenKeys,
+  tokenListQuery,
+  topupRecordsQuery,
+  transferAffQuotaMutation,
+  unbindTelegramMutation,
+  updateAutoRechargeMutation,
+  updateBillingProfileMutation,
+  updateEmailPreferencesMutation,
+  updateSelfMutation,
+  updateTokenMutation,
+  updateWithdrawalProfileMutation,
+  updateBalanceAlertsMutation,
+} from "./index";
+
+const realFetch = globalThis.fetch;
+const realDocument = (globalThis as { document?: unknown }).document;
+
+interface Captured {
+  url: string;
+  init: RequestInit;
+}
+let captured: Captured[] = [];
+
+function call(): Captured {
+  const item = captured[0];
+  if (!item) throw new Error("expected a fetch call");
+  return item;
+}
+
+function stub(body: unknown, status = 200): void {
+  globalThis.fetch = (async (input: RequestInfo | URL, init: RequestInit = {}) => {
+    captured.push({ url: typeof input === "string" ? input : String(input), init });
+    return new Response(JSON.stringify(body), {
+      status,
+      headers: { "content-type": "application/json" },
+    });
+  }) as typeof fetch;
+}
+
+/**
+ * 预置缓存条目，执行 mutationFn 再手动跑 onSuccess，返回「被标记失效的 key」。
+ *
+ * 不走 `MutationCache.build` 是为了绕开 TanStack 的四层泛型推导——这里要验证的
+ * 是「真的打了这个端点」与「onSuccess 失效了这些 key」，两者不需要完整 mutation 生命周期。
+ */
+async function invalidatedBy<TVars>(
+  client: QueryClient,
+  options: unknown,
+  vars: TVars,
+  preseed: readonly (readonly unknown[])[],
+): Promise<string[]> {
+  const { mutationFn, onSuccess } = options as {
+    mutationFn?: (variables: TVars) => Promise<unknown>;
+    onSuccess?: (...args: unknown[]) => unknown;
+  };
+  for (const key of preseed) client.setQueryData(key, { seeded: true });
+  const data = await mutationFn?.(vars);
+  await onSuccess?.(data, vars, undefined, undefined);
+  return preseed
+    .filter((key) => client.getQueryState(key)?.isInvalidated)
+    .map((key) => JSON.stringify(key));
+}
+
+beforeEach(() => {
+  captured = [];
+  (globalThis as { document?: unknown }).document = { cookie: "new-api-user-id=42" };
+});
+
+afterEach(() => {
+  globalThis.fetch = realFetch;
+  if (realDocument === undefined) delete (globalThis as { document?: unknown }).document;
+  else (globalThis as { document?: unknown }).document = realDocument;
+});
+
+describe("读端点：URL 与参数", () => {
+  test("authSelfQuery → GET /api/user/self", async () => {
+    stub({ success: true, data: { id: 42, username: "u" } });
+    const client = createQueryClient();
+    await client.fetchQuery(authSelfQuery());
+    expect(call().url).toBe("/dashboard-api/user/self");
+    expect(call().init.method).toBe("GET");
+  });
+
+  test("authSelfQuery：200 但没有身份 → 403（与迁移前守卫一致）", async () => {
+    stub({ success: true });
+    const client = createQueryClient();
+    const err = (await client.fetchQuery(authSelfQuery()).catch((e: unknown) => e)) as unknown;
+    const { isForbidden } = await import("./errors");
+    expect(isForbidden(err)).toBe(true);
+  });
+
+  test("authSelfQuery：data:null 同样按 403 处理", async () => {
+    stub({ success: true, data: null });
+    const client = createQueryClient();
+    const err = (await client.fetchQuery(authSelfQuery()).catch((e: unknown) => e)) as unknown;
+    const { isForbidden } = await import("./errors");
+    expect(isForbidden(err)).toBe(true);
+  });
+
+  test("tokenListQuery → GET /api/token/", async () => {
+    stub({ success: true, data: { items: [], page: 1, page_size: 20, total: 0 } });
+    const client = createQueryClient();
+    await client.fetchQuery(tokenListQuery());
+    expect(call().url).toBe("/dashboard-api/token/");
+  });
+
+  test("logListQuery 用 p 而不是 page", async () => {
+    stub({ success: true, data: { items: [], page: 2, page_size: 20, total: 0 } });
+    const client = createQueryClient();
+    await client.fetchQuery(logListQuery({ p: 2, per_page: 20, model_name: "gpt-x" }));
+    const url = call().url;
+    const params = new URL(call().url, "https://x").searchParams;
+    expect(params.get("p")).toBe("2");
+    expect(params.get("per_page")).toBe("20");
+    expect(params.get("model_name")).toBe("gpt-x");
+    // 关键：不能把 p 写成 page
+    expect(params.get("page")).toBeNull();
+  });
+
+  test("callLogListQuery 用 p / page_size", async () => {
+    stub({ success: true, data: { items: [], page: 1, page_size: 20, total: 0 } });
+    const client = createQueryClient();
+    await client.fetchQuery(callLogListQuery({ p: 1, page_size: 20, status: "failed" }));
+    const params = new URL(call().url, "https://x").searchParams;
+    expect(call().url.startsWith("/dashboard-api/log/self/calls?")).toBe(true);
+    expect(params.get("p")).toBe("1");
+    expect(params.get("page_size")).toBe("20");
+    expect(params.get("status")).toBe("failed");
+  });
+
+  test("byKeyStatsQuery → /api/log/self/stat/by-key 带 bucket", async () => {
+    stub({ success: true, data: [] });
+    const client = createQueryClient();
+    await client.fetchQuery(
+      byKeyStatsQuery({ start_timestamp: 1, end_timestamp: 2, bucket: "month" }),
+    );
+    const url = call().url;
+    expect(url.startsWith("/dashboard-api/log/self/stat/by-key?")).toBe(true);
+    expect(url).toContain("bucket=month");
+  });
+
+  test("storageListQuery → /api/user/storages（storages 族）", async () => {
+    stub({ code: 200, message: "ok", data: { items: [], total: 0, page: 1, size: 20 } });
+    const client = createQueryClient();
+    await client.fetchQuery(storageListQuery({ type: "persistent", page: 1, size: 20 }));
+    const url = call().url;
+    expect(url.startsWith("/dashboard-api/user/storages?")).toBe(true);
+    expect(url).toContain("type=persistent");
+  });
+
+  test("storageBillingQuery → /api/user/storages/billing", async () => {
+    stub({ code: 200, message: "ok", data: { items: [], total: 0, page: 1, size: 20 } });
+    const client = createQueryClient();
+    await client.fetchQuery(storageBillingQuery({ start_date: "2026-11-01", end_date: "2026-11-14" }));
+    expect(call().url.startsWith("/dashboard-api/user/storages/billing?")).toBe(true);
+  });
+
+  test("ticketListQuery → /api/tickets", async () => {
