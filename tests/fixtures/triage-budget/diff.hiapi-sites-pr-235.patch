+// usage —— 用量统计（`/api/log/self/stat*`）。
+//
+// 三个端点都是「载荷整个在 data 里」，用 `apiData`。
+// 与 logs.ts 分开是因为：logs 是明细列表（分页、按条），usage 是聚合（按时间段/按 Key）。
+
+import { queryOptions } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { logKeys, type ByKeyStatParams, type StatRangeParams } from "./keys";
+
+export interface LogStats {
+  /** 时间段内总消费配额 */
+  quota: number;
+  /** 请求数/分钟 */
+  rpm: number;
+  /** Token 数/分钟 */
+  tpm: number;
+}
+
+export interface DailyStatEntry {
+  /** "2026-04-01" */
