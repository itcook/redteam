@@ -0,0 +1,134 @@
+// storages —— 产物存储（`/api/user/storages*`）。
+//
+// **信封族不同**：这一族全部是 `{code,message,data}`，不是 `{success,message,data}`。
+// 所以每个请求都显式传 `envelope: "storages"`；少了它会漏抓 `code !== 200` 的业务失败
+// （见 docs/api-map.md D1，http.test.ts 有专项回归）。
+
+import { mutationOptions, queryOptions, type QueryClient } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { billingKeys, storageKeys, type StorageBillingParams, type StorageListParams } from "./keys";
+import { invalidate } from "./invalidate";
+
+export type StorageTier = "temporary" | "persistent" | "static";
+
+export interface StorageArtifactItem {
+  /** 与 `/v1/tasks` 的 output[].artifactId、promote/delete 请求体一致 */
+  id: string;
+  task_id: string;
+  artifact_type: string;
+  media_kind?: string;
+  mime_type?: string;
+  download_filename?: string;
+  storage_tier: StorageTier;
+  cdn_url: string;
+  size_bytes: number;
+  /** Unix 秒；0 = 不过期 */
+  expire_at: number;
+  promotable: boolean;
+  created_at: number;
+  prompt?: string;
+}
+
+export interface StorageListData {
+  items: StorageArtifactItem[];
+  total: number;
+  page: number;
+  size: number;
+}
+
+export type StorageRejectReason =
+  | "not_owned"
+  | "insufficient"
+  | "cap_exceeded"
+  | "not_promotable"
+  | "already_deleted"
+  | "pending_archiving"
+  | "storage_op_pending"
+  | "static_immutable";
+
+export interface StorageOpResult {
+  accepted: string[];
+  rejected: Array<{ id: string; reason: StorageRejectReason | string }>;
+}
+
+export interface StorageBillingSummary {
+  total_usd: number;
+  yesterday_usd: number;
+  month_usd: number;
+  price_per_gb_month: number;
+}
+
+export type StorageBillingStatus = "charged" | "insufficient";
+
+export interface StorageBillingItem {
+  /** YYYY-MM-DD（UTC 日） */
+  billing_date: string;
+  bytes_snapshot: number;
+  price_per_gb_month: number;
+  /** 后端历史命名：实扣原始 quota（insufficient 行为 0） */
+  credits_charged: number;
+  amount_usd: number;
+  quota_per_unit_snapshot?: number;
+  status: StorageBillingStatus | string;
+  charged_at: number;
+}
+
+export interface StorageBillingListData {
+  items: StorageBillingItem[];
+  total: number;
+  page: number;
+  size: number;
+}
+
+export function storageListQuery(params: StorageListParams = {}) {
+  return queryOptions({
+    queryKey: storageKeys.list(params),
+    queryFn: ({ signal }) =>
+      apiData<StorageListData>("/api/user/storages", {
+        signal,
+        query: params,
+        envelope: "storages",
+      }),
+    staleTime: 30_000,
+  });
+}
+
+export function storageBillingQuery(params: StorageBillingParams = {}) {
+  return queryOptions({
+    queryKey: storageKeys.billing(params),
+    queryFn: ({ signal }) =>
+      apiData<StorageBillingListData>("/api/user/storages/billing", {
+        signal,
+        query: params,
+        envelope: "storages",
+      }),
+    staleTime: 30_000,
+  });
+}
+
+/** 转持久存储。批量上限 50 个 id；部分成功语义见 `StorageOpResult.rejected`。 */
+export function promoteStorageMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (ids: string[]) =>
+      apiData<StorageOpResult>("/api/user/storages/promote", {
+        method: "POST",
+        body: ids,
+        envelope: "storages",
+      }),
+    // 转持久会改变计费口径 → 连带账单
+    onSuccess: () => invalidate(client, [storageKeys.all, billingKeys.all]),
+  });
+}
+
+/** 删除产物（含 `static` 不可删的拒绝原因）。 */
+export function removeStorageMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (ids: string[]) =>
+      apiData<StorageOpResult>("/api/user/storages/delete", {
+        method: "POST",
+        body: ids,
+        envelope: "storages",
+      }),
+    onSuccess: () => invalidate(client, [storageKeys.all, billingKeys.all]),
+  });
+}
diff --git a/apps/dashboard/src/lib/api/system.ts b/apps/dashboard/src/lib/api/system.ts
new file mode 100644
index 00000000..b8eb5ce2
--- /dev/null
+++ b/apps/dashboard/src/lib/api/system.ts
@@ -0,0 +1,61 @@
+// system —— 非 backend 的 dashboard 自有端点。
+//
+// `/api/site-config` 由 Worker 代持 content-api 凭据后返回（本地 vite dev 没有 Worker，
+// 会 404 → 这里 `retry: 0` 并让调用方回落 USD）。响应是裸对象 `{ creditRate }`，
+// 没有 `success` 包装，所以走 `apiEnvelope`。
+
+import { mutationOptions, queryOptions } from "@tanstack/react-query";
+import { apiData, apiEnvelope } from "./http";
+import { systemKeys } from "./keys";
+
+export interface SiteConfig {
+  /** 每 USD 对应多少 credits；null = 未启用汇率 → 隐藏单位切换器 */
+  creditRate: number | null;
+}
+
+export function siteConfigQuery() {
+  return queryOptions({
+    queryKey: systemKeys.siteConfig(),
+    queryFn: ({ signal }) => apiEnvelope<SiteConfig>("/api/site-config", { signal }),
+    staleTime: 5 * 60_000,
+    // 本地 dev 没有 Worker 会 404；允许一次重试即可，不必快速失败：
+    // 单次失败让 rate=null 会把单位切换器整个会话藏起来，重试 + 回焦重取能自愈
+    retry: 1,
+    refetchOnWindowFocus: true,
+  });
+}
+
+/**
+ * 站点搜索索引：Worker 代理宿主的 `/internal/search-index`（跨域规避）。
+ * 响应是宿主自有的 JSON（无 `success` 包装），所以走 `apiEnvelope`。
+ * Header 的 `loadIndex` 是命令式回调，这里给纯函数而不是 query。
+ */
+export function searchIndexRequest<T>(locale: string): Promise<T> {
+  return apiEnvelope<T>("/api/search-index", { query: { locale } });
+}
+
+/** 站点状态（Turnstile site key、汇率等）。api-keys 页用它决定是否渲染人机验证。 */
+export interface PublicStatus {
+  turnstile_site_key?: string;
+  quota_per_unit?: number;
+  [key: string]: unknown;
+}
+
+export function publicStatusQuery() {
+  return queryOptions({
+    queryKey: systemKeys.publicStatus(),
+    queryFn: ({ signal }) => apiData<PublicStatus>("/api/status", { signal }),
+    staleTime: 5 * 60_000,
+  });
+}
+
+/**
+ * 产品归因埋点（注册/试用来源）。失败不影响主流程 → 调用方用 `mutate()` 并忽略错误。
+ */
+export function recordProductAttributionMutation() {
+  return mutationOptions({
+    mutationFn: (body: Record<string, unknown>) =>
+      apiData<{ recorded: boolean }>("/api/user/product-attributions", { method: "POST", body }),
+    retry: 0,
+  });
+}
diff --git a/apps/dashboard/src/lib/api/telegram.ts b/apps/dashboard/src/lib/api/telegram.ts
