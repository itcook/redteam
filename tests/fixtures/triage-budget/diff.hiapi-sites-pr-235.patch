+// telegram —— Telegram 会员绑定（`/api/telegram/membership/*`）。
+//
+// 4 个端点由共享邀请组件带入：contact 页（工单外的社群入口）与 settings 页都用。
+// 都不是热路径，统一 60s 缓存。
+
+import { mutationOptions, queryOptions, type QueryClient } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { telegramKeys } from "./keys";
+import { invalidate } from "./invalidate";
+
+export type TelegramMembershipState =
+  | "authenticated_no_order"
+  | "authenticated_order_processing"
+  | "authenticated_paid_unbound"
+  | "authenticated_paid_bound";
+
+export interface TelegramMembershipBinding {
+  state: TelegramMembershipState;
+  has_paid_order: boolean;
+  has_domestic_paid_order?: boolean;
+  has_processing_order: boolean;
+  telegram_user_id?: number;
+  telegram_username?: string;
+  bound_at?: number;
+}
+
+export interface TelegramMembershipBindInit {
+  token: string;
+  bot_username: string;
+  deep_link: string;
+  expires_in: number;
+}
+
+export function telegramBindingQuery() {
+  return queryOptions({
+    queryKey: telegramKeys.binding(),
+    queryFn: ({ signal }) =>
+      apiData<TelegramMembershipBinding>("/api/telegram/membership/binding", { signal }),
+    staleTime: 60_000,
+  });
+}
+
+export function telegramInviteLinkQuery() {
+  return queryOptions({
+    queryKey: telegramKeys.inviteLink(),
+    queryFn: ({ signal }) =>
+      apiData<{ invite_link: string }>("/api/telegram/membership/invite-link", { signal }),
+    staleTime: 60_000,
+  });
+}
+
+export function initTelegramBindMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: () =>
+      apiData<TelegramMembershipBindInit>("/api/telegram/membership/bind/init", {
+        method: "POST",
+      }),
+    onSuccess: () => invalidate(client, [telegramKeys.all]),
+  });
+}
+
+export function unbindTelegramMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: () =>
+      apiData<void>("/api/telegram/membership/unbind", { method: "POST" }),
+    onSuccess: () => invalidate(client, [telegramKeys.all]),
+  });
+}
