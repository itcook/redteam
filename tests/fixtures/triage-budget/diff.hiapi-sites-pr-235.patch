+// tickets —— 工单（`/api/tickets`，dashboard 路由 `/dashboard/contact`）。
+//
+// 范围只有「列表 + 新建」两个：工单详情/回复在 `tickets/[id]` 子页，不在 9 项菜单内，
+// 属于后续子任务（见 docs/api-map.md「未纳入」）。
+//
+// 新建工单会发通知、可能进队列 → 成功后失效整个 tickets 域。
+
+import { mutationOptions, queryOptions, type QueryClient } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { ticketKeys, type TicketListParams } from "./keys";
+import { invalidate } from "./invalidate";
+
+export type TicketStatus = "pending" | "replied" | "resolved" | "closed";
+export type TicketPriority = "low" | "normal" | "high";
+export type TicketCategory =
+  | "billing"
+  | "api_403"
+  | "generation_failed"
+  | "api_integration"
+  | "other";
+
+export interface TicketAttachmentRef {
+  attachment_id: number;
+  name: string;
+  size: number;
+  mime: string;
+}
+
+export interface Ticket {
+  id: number;
+  ticket_no: string;
+  user_id: number;
+  contact_email: string;
+  title: string;
+  category: TicketCategory;
+  status: TicketStatus;
+  priority: TicketPriority;
+  source: string;
+  last_message_id: number;
+  last_message_sender_type: string;
+  last_message_at: number;
+  user_last_read_message_id: number;
+  admin_last_read_message_id: number;
+  created_at: number;
+  updated_at: number;
+  closed_at: number;
+  unread_count: number;
+}
+
+export interface TicketListResponse {
+  items: Ticket[];
+  total: number;
+  page: number;
+  page_size: number;
+}
+
+export interface CreateTicketPayload {
+  title: string;
+  category: TicketCategory;
+  contact_email: string;
+  body: string;
+  attachments?: TicketAttachmentRef[];
+  /** 幂等键：网络重试不产生重复工单 */
+  client_request_id?: string;
+}
+
+export function ticketListQuery(params: TicketListParams = {}) {
+  return queryOptions({
+    queryKey: ticketKeys.list(params),
+    queryFn: ({ signal }) =>
+      apiData<TicketListResponse>("/api/tickets", { signal, query: params }),
+    // 工单随时可能有新回复，不吃缓存
+    staleTime: 0,
+    refetchOnMount: "always",
+  });
+}
+
+export function createTicketMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: CreateTicketPayload) =>
+      apiData<Ticket>("/api/tickets", { method: "POST", body }),
+    onSuccess: () => invalidate(client, [ticketKeys.all]),
+  });
+}
