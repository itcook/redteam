new file mode 100644
index 00000000..349e62bd
--- /dev/null
+++ b/apps/dashboard/src/lib/api/auth.ts
@@ -0,0 +1,117 @@
+// auth —— 登录态、资料、改密、登出。
+//
+// 范围：9 页依赖闭包内的 5 个端点。**不含 2FA**（见 docs/api-map.md：功能未上线且有
+// 账号锁死风险，backend issue #440）。
+//
+// 401 的副作用不在这里：`authSelfQuery` 用 `meta.skipAuthRedirect` 退出全局跳转，
+// 由 `useAuthGuard` 自己处理「首帧不闪面板」的跳转时序（见 lib/query-client.ts）。
+
+import { mutationOptions, queryOptions, type QueryClient } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { ApiError } from "./errors";
+import { authKeys, overviewKeys } from "./keys";
+import { invalidate } from "./invalidate";
+
+/** `/api/user/self` 的响应。字段与 backend `controller/user.go` 的 GetSelf 输出对齐。 */
+export interface AuthUser {
+  id: number;
+  username: string;
+  display_name: string;
+  email: string;
+  has_password?: boolean;
+  /** 1=普通用户，10=管理员，100=超级管理员 */
+  role: number;
+  /** 1=启用，2=禁用 */
+  status: number;
+  /** 剩余额度（quota 单位） */
+  quota: number;
+  quota_per_unit?: number;
+  used_quota: number;
+  request_count: number;
+  group: string;
+  aff_code: string;
+  aff_count: number;
+  aff_quota: number;
+  aff_withdrawal_reserved_quota?: number;
+  aff_history_quota?: number;
+  webhook_sign_key?: string;
+  github_id?: string;
+  oidc_id?: string;
+}
+
+/** `PUT /api/user/self` 的请求体（只列页面会改的字段，其余由 backend 忽略）。 */
+export interface UpdateSelfRequest {
+  display_name?: string;
+  username?: string;
+  password?: string;
+  original_password?: string;
+  email?: string;
+}
+
+export interface ChangePasswordRequest {
+  current_password: string;
+  new_password: string;
+}
+
+export function authSelfQuery() {
+  return queryOptions({
+    queryKey: authKeys.self(),
+    queryFn: async ({ signal }) => {
+      const user = await apiData<AuthUser | null>("/api/user/self", { signal });
+      // 200 但没有身份（`{success:true}` / `data:null`）与 403 同义：
+      // 迁移前守卫对同一形状抛 403，这里保持可观察行为不变。
+      if (!user || typeof user.id !== "number") {
+        throw new ApiError(403, user, { message: "self payload missing" });
+      }
+      return user;
+    },
+    // 余额展示依赖它；与迁移前的守卫保持一致
+    staleTime: 60_000,
+    // 守卫自己处理 401 的跳转时序，不让全局钩子抢先
+    meta: { skipAuthRedirect: true },
+  });
+}
+
+export function updateSelfMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: UpdateSelfRequest) =>
+      apiData<void>("/api/user/self", { method: "PUT", body }),
+    // 概览聚合里有 self（余额/昵称），改资料要连带失效
+    onSuccess: () => invalidate(client, [authKeys.self(), overviewKeys.summary()]),
+  });
+}
+
+export function changePasswordMutation(client: QueryClient) {
+  return mutationOptions({
+    // 注意：改密是 /api/user/self/password，不是 /api/user/setting（见 api-map D6）
+    mutationFn: (body: ChangePasswordRequest) =>
+      apiData<void>("/api/user/self/password", { method: "PUT", body }),
+    onSuccess: () => invalidate(client, [authKeys.self()]),
+  });
+}
+
+export function requestPasswordResetMutation() {
+  return mutationOptions({
+    // 发信是 GET /api/reset_password；提交重置才是 POST /api/user/reset（api-map D7）
+    mutationFn: (body: { email: string; locale?: string }) =>
+      apiData<void>("/api/reset_password", { query: body }),
+  });
+}
+
+export function logoutRequest(): Promise<void> {
+  return apiData<void>("/api/user/logout");
+}
+
+
+/** OAuth 绑定态（settings 页发起 GitHub/OIDC 绑定时取 state）。 */
+export function bindOAuthStateQuery(provider: string) {
+  return queryOptions({
+    queryKey: authKeys.oauthState(provider),
+    queryFn: ({ signal }) =>
+      apiData<string>("/api/oauth/state", {
+        signal,
+        query: { purpose: "bind", provider },
+      }),
+    staleTime: 0,
+  });
+}
