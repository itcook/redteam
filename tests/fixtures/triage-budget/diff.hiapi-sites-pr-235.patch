+  });
+
+  test("响应形状异常也落 failed", () => {
+    const r = classifyGuardError(
+      new ApiError(200, "<html>", { kind: "business", message: "unexpected response body" }),
+      true,
+    );
+    expect(r.failed).toBe(true);
+  });
+
+  test("无 cookie 时不算 failed（走跳转分支）", () => {
+    const r = classifyGuardError(new ApiError(500, null), false);
+    expect(r.failed).toBe(false);
+  });
+});
