+// tokens —— API Keys（`/api/token/*`）。
+//
+// 三个易错点（见 docs/api-map.md）：
+//   1. `GET /api/token/` 服务端本来分页（`data:{items,page,page_size,total}`），
+//      interim 把元数据丢掉只回数组 —— 这里保留完整结构，`apiData` 取 `data`；
+//   2. 取明文密钥是 **POST** `/api/token/:id/key`，不是 GET，所以只能做 mutation；
+//   3. 增删改都要连带 `auth.self` 与 `overview.summary`（余额/配额会变）。
+
+import { mutationOptions, queryOptions, type QueryClient } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { tokenKeys, type TokenListParams } from "./keys";
+import { BALANCE_KEYS, invalidate } from "./invalidate";
+
+export interface Token {
+  id: number;
+  user_id: number;
+  /** 只有创建响应里是完整明文；列表里是脱敏值 */
+  key: string;
+  name: string;
+  /** 1=启用，2=禁用，3=已耗尽 */
+  status: number;
+  created_time: number;
+  accessed_time: number;
+  /** -1 = 永不过期 */
+  expired_time: number;
+  remain_quota: number;
+  unlimited_quota: boolean;
+  used_quota: number;
+  model_limits_enabled: boolean;
+  model_limits: string;
+  allow_ips: string | null;
+  group: string;
+  cross_group_retry: boolean;
+  source?: "mcp" | "";
+}
+
+export interface TokenListResult {
+  items: Token[];
+  page: number;
+  page_size: number;
+  total: number;
+}
+
+export interface CreateTokenRequest {
+  name: string;
+  expired_time?: number;
+  remain_quota?: number;
+  remain_credits?: number;
+  unlimited_quota?: boolean;
+  model_limits_enabled?: boolean;
+  model_limits?: string;
+  allow_ips?: string;
+}
+
+export interface UpdateTokenRequest {
+  id: number;
+  name?: string;
+  expired_time?: number;
+  remain_quota?: number;
+  remain_credits?: number;
+  unlimited_quota?: boolean;
+  status?: number;
+  model_limits_enabled?: boolean;
+  model_limits?: string;
+  allow_ips?: string;
+}
+
+export function tokenListQuery(params: TokenListParams = {}) {
+  return queryOptions({
+    queryKey: tokenKeys.list(params),
+    // 服务端用 p / page_size 分页；不传参数只能拿默认页
+    queryFn: ({ signal }) => apiData<TokenListResult>("/api/token/", { signal, query: params }),
+    // API Key 是高频自查页
+    staleTime: 10_000,
+  });
+}
+
+export function createTokenMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: CreateTokenRequest) =>
+      apiData<Token>("/api/token/", { method: "POST", body }),
+    onSuccess: () => invalidate(client, [tokenKeys.all, ...BALANCE_KEYS]),
+  });
+}
+
+export function updateTokenMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: UpdateTokenRequest) =>
+      apiData<void>("/api/token/", { method: "PUT", body }),
+    onSuccess: () => invalidate(client, [tokenKeys.all, ...BALANCE_KEYS]),
+  });
+}
+
+export function deleteTokenMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (id: number) => apiData<void>(`/api/token/${id}`, { method: "DELETE" }),
+    onSuccess: () => invalidate(client, [tokenKeys.all, ...BALANCE_KEYS]),
+  });
+}
+
+/** 明文密钥只在用户点「显示」时现取，不进缓存（POST，不幂等）。 */
+export function revealTokenKeyMutation() {
+  return mutationOptions({
+    mutationFn: (id: number) => apiData<{ key: string }>(`/api/token/${id}/key`, { method: "POST" }),
+  });
+}
