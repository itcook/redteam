+// session-expiry —— 会话失效的唯一副作用实现（应用层）。
+//
+// 为什么在 features 而不是 lib：清登录态要读 auth store、跳转要知道站点域名与 locale，
+// 这两件事都是应用层知识。`lib/query-client` 只负责在 401 时回调，不 import `@/features`。
+//
+// 三个动作必须一起做，缺一个都会留下跨账号残留：
+//   1. 清登录态（`useAuthStore.clear()` 内部已 `clearUserId()`）；
+//   2. 清 query cache（否则下一个账号看到上一个账号的余额/日志）；
+//   3. 跳营销站登录页并带 returnTo。
+
+import type { QueryClient } from "@tanstack/react-query";
+import { useAuthStore } from "./store";
+import { currentLocale, signInUrl } from "@/lib/site";
+
+export function handleSessionExpired(client: QueryClient): void {
+  useAuthStore.getState().clear();
+  client.clear();
+
+  if (typeof window === "undefined") return;
+  window.location.assign(signInUrl(currentLocale(), window.location.href));
+}
