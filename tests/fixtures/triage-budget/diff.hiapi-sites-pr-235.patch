+// models —— 模型列表与价格（`/api/pricing`、`/api/user/models`）。
+//
+// api-keys 页用它算「额度换算成多少模型用量」，logs 页用它做模型筛选下拉。
+//
+// `/api/pricing` 不是裸响应：它带 `success`，但载荷在顶层（`data[]` 与 `vendors[]` 是兄弟），
+// 所以走 `apiEnvelope`（见 docs/api-map.md 返回形态）。
+
+import { queryOptions } from "@tanstack/react-query";
+import { apiEnvelope, apiData } from "./http";
+import { modelKeys } from "./keys";
+
+export interface PricingVendor {
+  id: string;
+  name: string;
+  icon?: string;
+}
+
+/** `/api/pricing` 的顶层结构（`data` 是模型数组，分页/元数据在兄弟字段）。 */
+export interface PricingResponse {
+  success?: boolean;
+  message?: string;
+  data: unknown[];
+  vendors?: PricingVendor[];
+  pricing_version?: string;
+  group_ratio?: Record<string, number>;
+  usable_group?: Record<string, string>;
+  supported_endpoint?: Record<string, unknown>;
+  auto_groups?: string[];
+}
+
+/** 当前用户可用的模型名列表（logs 页筛选用）。 */
+export function userModelsQuery() {
+  return queryOptions({
+    queryKey: modelKeys.list(),
+    queryFn: ({ signal }) => apiData<string[]>("/api/user/models", { signal }),
+    staleTime: 5 * 60_000,
+  });
+}
+
+export function pricingQuery() {
+  return queryOptions({
+    queryKey: modelKeys.pricing(),
+    queryFn: ({ signal }) => apiEnvelope<PricingResponse>("/api/pricing", { signal }),
+    staleTime: 5 * 60_000,
+  });
+}
diff --git a/apps/dashboard/src/lib/api/modules.test.ts b/apps/dashboard/src/lib/api/modules.test.ts
