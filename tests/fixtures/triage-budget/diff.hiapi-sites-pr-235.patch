+  /** token_id=0 时为空串，展示层用本地化标签 */
+  token_name: string;
+  count: number;
+  quota: number;
+}
+
+export function logStatsQuery(params: StatRangeParams = {}) {
+  return queryOptions({
+    queryKey: logKeys.stats(params),
+    queryFn: ({ signal }) => apiData<LogStats>("/api/log/self/stat", { signal, query: params }),
+    staleTime: 30_000,
+  });
+}
+
+export function dailyStatsQuery(params: StatRangeParams = {}) {
+  return queryOptions({
+    queryKey: logKeys.daily(params),
+    queryFn: ({ signal }) =>
+      apiData<DailyStatEntry[]>("/api/log/self/stat/daily", { signal, query: params }),
+    staleTime: 30_000,
+  });
+}
+
+export function byKeyStatsQuery(params: ByKeyStatParams) {
+  return queryOptions({
+    queryKey: logKeys.byKey(params),
+    queryFn: ({ signal }) =>
+      apiData<KeyStatEntry[]>("/api/log/self/stat/by-key", { signal, query: params }),
+    staleTime: 30_000,
+  });
+}
diff --git a/apps/dashboard/src/lib/query-client.test.ts b/apps/dashboard/src/lib/query-client.test.ts
new file mode 100644
index 00000000..6e9d6e0b
--- /dev/null
+++ b/apps/dashboard/src/lib/query-client.test.ts
@@ -0,0 +1,110 @@
+// query-client —— 401 单点的契约测试。
+//
+// 这条 40 行的路径在三天内改过 4 次（清 cache、per-client 闩、skipAuthRedirect、
+// 回调注入），是最高频的回归点，所以三件事必须各有一条断言：
+//   1. 只有 401 触发，403/业务失败不触发；
+//   2. `meta.skipAuthRedirect` 能退出；
+//   3. 闩是 per-client 的 —— 两个实例互不影响。
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { queryOptions, type QueryClient } from "@tanstack/react-query";
+import { createQueryClient } from "./query-client";
+import { apiData } from "./api/http";
+
+const realFetch = globalThis.fetch;
+const realDocument = (globalThis as { document?: unknown }).document;
+
+beforeEach(() => {
+  (globalThis as { document?: unknown }).document = { cookie: "new-api-user-id=42" };
+});
+
+afterEach(() => {
+  globalThis.fetch = realFetch;
+  if (realDocument === undefined) delete (globalThis as { document?: unknown }).document;
+  else (globalThis as { document?: unknown }).document = realDocument;
+});
+
+function stub(status: number, body: unknown = { success: false }): void {
+  globalThis.fetch = (async () =>
+    new Response(JSON.stringify(body), {
+      status,
+      headers: { "content-type": "application/json" },
+    })) as unknown as typeof fetch;
+}
+
+/** 走真实传输层，这样 401 / 业务失败 / 形状失败都按生产路径归一。 */
+function probe(meta?: Record<string, unknown>) {
+  return queryOptions({
+    queryKey: ["probe", meta ?? null],
+    queryFn: ({ signal }) => apiData<{ ok: true }>("/api/probe", { signal }),
+    retry: false,
+    ...(meta ? { meta } : {}),
+  });
+}
+
+describe("401 单点", () => {
+  test("401 触发 onAuthExpired，只调一次（并发两个 401 也只一次）", async () => {
+    stub(401);
+    const calls: QueryClient[] = [];
+    const client = createQueryClient({ onAuthExpired: (c) => calls.push(c) });
+
+    await client.fetchQuery(probe()).catch(() => undefined);
+    await client.fetchQuery(probe({ n: 2 })).catch(() => undefined);
+
+    expect(calls).toHaveLength(1);
+    expect(calls[0]).toBe(client);
+  });
+
+  test("meta.skipAuthRedirect 退出单点（守卫自处理）", async () => {
+    stub(401);
+    const calls: QueryClient[] = [];
+    const client = createQueryClient({ onAuthExpired: (c) => calls.push(c) });
+
+    await client
+      .fetchQuery(probe({ skipAuthRedirect: true }))
+      .catch(() => undefined);
+
+    expect(calls).toHaveLength(0);
+  });
+
+  test("403 不触发（已登录但无权限不等于会话失效）", async () => {
+    stub(403);
+    const calls: QueryClient[] = [];
+    const client = createQueryClient({ onAuthExpired: (c) => calls.push(c) });
+
+    await client.fetchQuery(probe()).catch(() => undefined);
+
+    expect(calls).toHaveLength(0);
+  });
+
+  test("业务失败（2xx + success:false）不触发", async () => {
+    stub(200, { success: false, message: "nope" });
+    const calls: QueryClient[] = [];
+    const client = createQueryClient({ onAuthExpired: (c) => calls.push(c) });
+
+    await client.fetchQuery(probe()).catch(() => undefined);
+
+    expect(calls).toHaveLength(0);
+  });
+
+  test("不同 client 各有自己的闩（测试隔离依赖这一点）", async () => {
+    stub(401);
+    const a: QueryClient[] = [];
+    const b: QueryClient[] = [];
+    const clientA = createQueryClient({ onAuthExpired: (c) => a.push(c) });
+    const clientB = createQueryClient({ onAuthExpired: (c) => b.push(c) });
+
+    await clientA.fetchQuery(probe()).catch(() => undefined);
+    await clientB.fetchQuery(probe()).catch(() => undefined);
+
+    expect(a).toHaveLength(1);
+    expect(b).toHaveLength(1);
+  });
+
+  test("不传 onAuthExpired 时静默（SSR / 测试场景）", async () => {
+    stub(401);
+    const client = createQueryClient();
+    await client.fetchQuery(probe()).catch(() => undefined);
+    // 不抛异常即通过
+    expect(client.getQueryCache().getAll().length).toBeGreaterThanOrEqual(0);
+  });
+});
diff --git a/apps/dashboard/src/lib/query-client.ts b/apps/dashboard/src/lib/query-client.ts
new file mode 100644
index 00000000..3d275ece
--- /dev/null
+++ b/apps/dashboard/src/lib/query-client.ts
@@ -0,0 +1,67 @@
+// query-client —— QueryClient 工厂 + 401 单点。
+//
+// 为什么单独成文件（而不是留在 __root.tsx）：
+//   1. mutation 工厂需要 client 做缓存失效。工厂若闭包一个模块单例，测试新建 client 时
+//      会去失效**另一个**缓存 —— 测试看着通过、线上却不刷新。所以工厂一律显式接收 client；
+//   2. 401 处理要单点：QueryCache / MutationCache 的 onError 走同一个回调。
+//
+// **本文件不依赖 `@/features/*`**：会话失效的真实副作用（清登录态、跳登录页）是应用层知识，
+// 由宿主通过 `onAuthExpired` 注入（见 `features/auth/session-expiry.ts`）。
+// `lib/` 只负责「什么时候该调用它」。
+// 单个请求可以用 `meta: { skipAuthRedirect: true }` 退出（`/api/user/self` 由守卫自处理）。
+
+import { MutationCache, QueryCache, QueryClient } from "@tanstack/react-query";
+import { isUnauthorized } from "./api/errors";
+
+export interface QueryClientOptions {
+  /**
+   * 收到 401 时要做什么（清登录态 + 清缓存 + 跳登录）。
+   * 应用层注入；不传则只做「不跳转」——测试与 SSR 场景用得上。
+   */
+  onAuthExpired?: (client: QueryClient) => void;
+}
+
+export function createQueryClient(options: QueryClientOptions = {}): QueryClient {
+  // onError 需要 client 做 `clear()`，但 client 在构造函数里才拿到，
+  // 所以用局部 holder 承接：只在请求出错时读取，那时 client 已就绪。
+  const holder: { client?: QueryClient } = {};
+  // 每个实例自己的幂等位（不放模块级：多实例测试时模块级会互相污染）
+  let redirecting = false;
+
+  const onError = (error: unknown, meta: Record<string, unknown> | undefined) => {
+    if (meta?.skipAuthRedirect === true) return;
+    if (!isUnauthorized(error)) return;
+    if (redirecting) return;
+
+    const client = holder.client;
+    if (!client) return;
+
+    redirecting = true;
+    options.onAuthExpired?.(client);
+  };
+
+  const client = new QueryClient({
+    queryCache: new QueryCache({
+      onError: (error, query) => onError(error, query.meta),
+    }),
+    mutationCache: new MutationCache({
+      onError: (error, _vars, _ctx, mutation) => onError(error, mutation.meta),
+    }),
+    defaultOptions: {
+      queries: {
+        // 私有数据：窗口聚焦不重拉，避免后台标签页反复打 backend
+        refetchOnWindowFocus: false,
+        refetchOnReconnect: true,
+        retry: 1,
+        staleTime: 30_000,
+        gcTime: 5 * 60_000,
+      },
+      mutations: {
+        retry: 0,
+      },
+    },
+  });
+
+  holder.client = client;
+  return client;
+}
