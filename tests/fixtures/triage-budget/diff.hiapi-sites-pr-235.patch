+++ b/apps/dashboard/src/lib/api/referral.ts
@@ -0,0 +1,298 @@
+// referral —— 邀请返佣（`/api/user/aff*`、`/api/user/aff_transfer`）。
+//
+// 12 个端点全部在 9 页闭包内。翻页参数是 **`p` / `page_size`**，不是 `page` / `per_page`
+// （见 docs/api-map.md D3）。
+//
+// `transfer` 与 `createWithdrawal` 会动余额/冻结额度 → 必须连带 `auth.self` 与 `overview.summary`。
+
+import { mutationOptions, queryOptions, type QueryClient } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { referralKeys, overviewKeys, type AffPageParams } from "./keys";
+import { BALANCE_KEYS, invalidate } from "./invalidate";
+
+export type AffAgentStatus = "pending" | "eligible" | "active" | "rejected" | "revoked";
+export type AffApplicationStatus = "pending" | "approved" | "rejected";
+
+/** `GET /api/user/aff` —— 邀请码与累计数据。 */
+export interface AffCodeInfo {
+  aff_code?: string;
+  aff_count?: number;
+  aff_quota?: number;
+  aff_history_quota?: number;
+  aff_withdrawal_reserved_quota?: number;
+}
+
+export interface AffCodeSettings {
+  can_set: boolean;
+  custom_code: string | null;
+  current_code: string;
+  generated_code?: string;
+}
+
+export interface AffAgentState {
+  status: AffAgentStatus | null;
+  requested_code: string | null;
+  active_code: string | null;
+  current_code: string | null;
+  reason: string | null;
+  preserve_codes: boolean;
+  updated_at: number | string | null;
+}
+
+export interface AffAgentApplication {
+  id: number;
+  user_id: number;
+  username: string;
+  email: string;
+  channels: string[];
+  account_links: string[];
+  audience_size: string;
+  proof_name: string;
+  promotion_plan: string;
+  contact: string;
+  notes: string;
+  status: AffApplicationStatus;
+  review_reason: string;
+  reviewed_at: number;
+  created_at: number;
+}
+
+export interface AffCommissionRule {
+  enabled: boolean;
+  is_custom: boolean;
+  rate_bps: number;
+  window_days: number;
+  window_enabled: boolean;
+  /** Unix 秒；定时规则切换时间 */
+  next_change_at: number | null;
+  /** 后端数据库时钟，避免客户端时钟偏差 */
+  server_time: number;
+}
+
+export interface AffWithdrawalPolicy {
+  withdraw_enabled: boolean;
+  channels: string;
+  min_withdraw_usd: number;
+  daily_limit_usd: number;
+  fee_bps: number;
+}
+
+export interface AffWithdrawalRequest {
+  id: number;
+  requested_usd: number;
+  fee_usd: number;
+  settlement_usd: number;
+  channel: string;
+  account_masked: string;
+  recipient_masked: string;
+  status: string;
+  created_at: number;
+  failure_reason?: string;
+}
+
+export interface AffWithdrawalData {
+  policy: AffWithdrawalPolicy;
+  profiles: Array<{ channel: string; account_masked: string; recipient_masked: string }>;
+  aff_quota: number;
+  reserved_quota: number;
+  withdrawable_usd: number;
+  items: AffWithdrawalRequest[];
+}
+
+export interface AffInviteeItem {
+  user: string;
+  converted: boolean;
+  /** quota 单位 */
+  total_commission: number;
+  /** Unix 秒，0 = 历史注册时间不可用 */
+  registered_at: number;
+}
+
+export interface AffCommissionItem {
+  user: string;
+  /** 触发返佣的充值美元金额 */
+  money: number;
+  /** 返佣额度（quota 单位） */
+  commission: number;
+  created_at: number;
+}
+
+export interface AffPage<T> {
+  page: number;
+  page_size: number;
+  total: number;
+  items: T[] | null;
+}
+
+// ---------------------------------------------------------------------------
+// 读
+// ---------------------------------------------------------------------------
+
+export function affCodeQuery() {
+  return queryOptions({
+    queryKey: referralKeys.code(),
+    queryFn: ({ signal }) => apiData<AffCodeInfo>("/api/user/aff", { signal }),
+    staleTime: 30_000,
+  });
+}
+
+export function affCodeSettingsQuery() {
+  return queryOptions({
+    queryKey: referralKeys.codeSettings(),
+    queryFn: ({ signal }) => apiData<AffCodeSettings>("/api/user/aff/code-settings", { signal }),
+    staleTime: 30_000,
+  });
+}
+
+export function affApplicationQuery() {
+  return queryOptions({
+    queryKey: referralKeys.application(),
+    queryFn: ({ signal }) =>
+      apiData<{ application: AffAgentApplication | null }>("/api/user/aff/application", {
+        signal,
+      }),
+    staleTime: 30_000,
+  });
+}
+
+export function affRuleQuery() {
+  return queryOptions({
+    queryKey: referralKeys.rule(),
+    queryFn: ({ signal }) => apiData<AffCommissionRule>("/api/user/aff/rule", { signal }),
+    staleTime: 60_000,
+  });
+}
+
+export function affWithdrawalQuery() {
+  return queryOptions({
+    queryKey: referralKeys.withdrawal(),
+    queryFn: ({ signal }) => apiData<AffWithdrawalData>("/api/user/aff/withdrawal", { signal }),
+    staleTime: 30_000,
+  });
+}
+
+export function affInviteesQuery(params: AffPageParams) {
+  return queryOptions({
+    queryKey: referralKeys.invitees(params),
+    queryFn: ({ signal }) =>
+      apiData<AffPage<AffInviteeItem>>("/api/user/aff/invitees", {
+        signal,
+        // 后端用 p / page_size
+        query: { p: params.page, page_size: params.page_size },
+      }),
+    staleTime: 30_000,
+  });
+}
+
+export function affCommissionsQuery(params: AffPageParams) {
+  return queryOptions({
+    queryKey: referralKeys.commissions(params),
+    queryFn: ({ signal }) =>
+      apiData<AffPage<AffCommissionItem>>("/api/user/aff/commissions", {
+        signal,
+        query: { p: params.page, page_size: params.page_size },
+      }),
+    staleTime: 30_000,
+  });
+}
+
+// ---------------------------------------------------------------------------
+// 写
+// ---------------------------------------------------------------------------
+
+export function setAffCodeMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (code: string) =>
+      apiData<AffCodeSettings>("/api/user/aff/code", { method: "POST", body: { code } }),
+    // 邀请码在概览页也展示 → 连带 overview
+    onSuccess: () =>
+      invalidate(client, [
+        referralKeys.code(),
+        referralKeys.codeSettings(),
+        overviewKeys.summary(),
+      ]),
+  });
+}
+
+/**
+ * 申请材料：**必须是 multipart**。
+ *
+ * backend `controller/aff_agent.go:55` 第一步就 `ParseMultipartForm`，`:69` 要求恰好一个
+ * 名为 `proof` 的文件；channels / account_links 用同名多次提交（`form.Value["channels"]`）。
+ * 发 JSON 会在读到任何字段之前直接 400。
+ */
+export interface AffApplicationRequest {
+  /** 账号归属证明截图（≤5MB） */
+  proof: File;
+  channels: string[];
+  account_links: string[];
+  audience_size: string;
+  promotion_plan: string;
+  contact: string;
+  notes?: string;
+}
+
+/** 把申请材料编成 multipart（单独导出便于测试，不依赖 mutation 生命周期）。 */
+export function buildAffApplicationForm(body: AffApplicationRequest): FormData {
+  const form = new FormData();
+  // 同名多次 append → 后端读成 []string
+  for (const channel of body.channels) form.append("channels", channel);
+  for (const link of body.account_links) form.append("account_links", link);
+  form.set("audience_size", body.audience_size);
+  form.set("promotion_plan", body.promotion_plan);
+  form.set("contact", body.contact);
+  if (body.notes) form.set("notes", body.notes);
+  form.set("proof", body.proof);
+  return form;
+}
+
+export function submitAffApplicationMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: AffApplicationRequest) =>
+      apiData<{ application: AffAgentApplication | null }>("/api/user/aff/application", {
+        method: "POST",
+        body: buildAffApplicationForm(body),
+      }),
+    onSuccess: () => invalidate(client, [referralKeys.all]),
+  });
+}
+
+/** 把邀请奖励转成余额。改变余额 → 连带 `auth.self` 与概览。 */
+export function transferAffQuotaMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (quota: number) =>
+      apiData<void>("/api/user/aff_transfer", { method: "POST", body: { quota } }),
+    onSuccess: () => invalidate(client, [referralKeys.all, ...BALANCE_KEYS]),
+  });
+}
+
+export interface WithdrawalProfileRequest {
+  channel: string;
+  account: string;
+  recipient_name: string;
+}
+
+export function updateWithdrawalProfileMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: WithdrawalProfileRequest) =>
+      apiData<void>("/api/user/aff/withdrawal-profile", { method: "PUT", body }),
+    onSuccess: () => invalidate(client, [referralKeys.withdrawal()]),
+  });
+}
+
+export interface CreateWithdrawalRequest {
+  /** 幂等键：同 payload 重放不会重复创建 */
+  idempotency_key: string;
+  amount_usd: number;
+  channel: string;
+  account: string;
+  recipient_name: string;
+}
+
+export function createWithdrawalMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: CreateWithdrawalRequest) =>
+      apiData<AffWithdrawalRequest>("/api/user/aff/withdrawals", { method: "POST", body }),
+    onSuccess: () => invalidate(client, [referralKeys.all, ...BALANCE_KEYS]),
+  });
+}
