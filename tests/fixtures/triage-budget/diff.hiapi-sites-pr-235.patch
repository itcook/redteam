+// billing —— 余额、充值、Stripe、自动充值与账单资料。
+//
+// 13 个端点 = 9 页闭包内的 12 个 + `GET /api/user/billing-profile`
+// （写入表单必须有读端点才有意义；interim 把它拆在别的组件里，闭包没抓到）。
+//
+// 两个易错点（见 docs/api-map.md D2/D3）：
+//   - 分页元数据在两个端点里都在 `data` **内**（`data:{items,page,page_size,total}`）；
+//   - 翻页参数走 `common.GetPageQuery` 的用 `p` / `page_size`（topup/self、redemptions/self），
+//     interim 给 topup 传的 `page`/`size` 后端根本不认。
+
+import { mutationOptions, queryOptions, type QueryClient } from "@tanstack/react-query";
+import { apiData, apiEnvelope } from "./http";
+import { billingKeys, type RedeemListParams, type TopupListParams } from "./keys";
+import { BALANCE_KEYS, invalidate } from "./invalidate";
+
+export interface TopupInfo {
+  stripe_enabled?: boolean;
+  redemption_enabled?: boolean;
+  min_amount?: number;
+  max_amount?: number;
+  enable_online_topup?: boolean;
+  enable_stripe_topup?: boolean;
+  stripe_embedded_checkout?: boolean;
+  stripe_pay_methods?: Array<"card" | "alipay" | "wechat_pay">;
+  stripe_wechat_max_amount?: number;
+  pay_methods?: Array<{ name: string; type: string; color?: string; min_topup?: string }>;
+  min_topup?: number;
+  stripe_min_topup?: number;
+}
+
+export interface TopupRecord {
+  id: number;
+  user_id: number;
+  amount: number;
+  money: number;
+  create_time: number;
+  complete_time: number;
+  trade_no: string;
+  payment_method: string;
+  payment_channel?: string;
+  status: string;
+  receipt_url?: string;
+  paid_currency?: string;
+  paid_amount_minor?: number;
+  /** 活动赠送额度（quota 单位） */
+  bonus_amount?: number;
+  bonus_credits?: string;
+}
+
+/**
+ * `/api/user/topup/self` 的响应：`common.ApiSuccess(c, pageInfo)`，
+ * 分页元数据在 `data` **内**（`PageInfo` 的 json tag 是 page/page_size/total/items）。
+ */
+export interface TopupRecordPage {
+  items: TopupRecord[];
+  page: number;
+  page_size: number;
+  total: number;
+}
+
+export interface RedemptionRecord {
+  id: number;
+  credited_credits: string | null;
+  redeemed_time: number;
+  code_suffix?: string;
+}
+
+export interface RedemptionPage {
+  items: RedemptionRecord[];
+  page: number;
+  page_size: number;
+  total: number;
+}
+
+export interface StripePaymentMethod {
+  id: string;
+  brand: string;
+  last4: string;
+  exp_month: number;
+  exp_year: number;
+  allow_redisplay?: string;
+}
+
+export interface AutoRechargeSetting {
+  enabled: boolean;
+  threshold_usd: number;
+  amount_usd: number;
+  payment_method_id?: string;
+  card_brand?: string;
+  card_last4?: string;
+  card_exp_month?: number;
+  card_exp_year?: number;
+  status: string;
+  last_error_code?: string;
+  last_error_message?: string;
+}
+
+export interface BillingProfile {
+  company_name: string;
+  address: string;
+  city: string;
+  state: string;
+  postal_code: string;
+  country: string;
+  tax_id: string;
+}
+
+export interface StripeEmbeddedCheckoutStatus {
+  session_id: string;
+  trade_no: string;
+  checkout_status: "open" | "complete" | "expired" | string;
+  payment_status: "paid" | "unpaid" | "no_payment_required" | string;
+  order_status: "pending" | "success" | "failed" | "expired" | string;
+  amount: number;
+  money: number;
+}
+
+export interface TopupConversionStatus {
+  trade_no: string;
+  status: "pending" | "success" | "failed" | "expired" | string;
+  value: number;
+  currency: string;
+  is_first_successful_topup: boolean;
+}
+
+// ---------------------------------------------------------------------------
+// 读
+// ---------------------------------------------------------------------------
+
+export function topupInfoQuery() {
+  return queryOptions({
+    queryKey: billingKeys.topupInfo(),
+    queryFn: ({ signal }) => apiData<TopupInfo>("/api/user/topup/info", { signal }),
+    staleTime: 30_000,
+  });
+}
+
+/**
+ * `/api/user/topup/self`：走 `common.GetPageQuery`，翻页参数是 `p` / `page_size`；
+ * 元数据在 `data` 内，所以用 `apiData`。
+ *
+ * 注意：interim 传的是 `page` / `size`（后端忽略，永远拿第 1 页），不要照抄。
+ */
+export function topupRecordsQuery(params: TopupListParams = {}) {
+  return queryOptions({
+    queryKey: billingKeys.topupRecords(params),
+    queryFn: ({ signal }) =>
+      apiData<TopupRecordPage>("/api/user/topup/self", { signal, query: params }),
+    staleTime: 30_000,
+  });
+}
+
+export function redemptionRecordsQuery(params: RedeemListParams = {}) {
+  return queryOptions({
+    queryKey: billingKeys.redemptions(params),
+    queryFn: ({ signal }) =>
+      apiData<RedemptionPage>("/api/user/redemptions/self", { signal, query: params }),
+    staleTime: 30_000,
+  });
+}
+
+export function paymentMethodsQuery() {
+  return queryOptions({
+    queryKey: billingKeys.paymentMethods(),
+    queryFn: ({ signal }) =>
+      apiData<StripePaymentMethod[]>("/api/user/stripe/payment-methods", { signal }),
+    staleTime: 60_000,
+  });
+}
+
+export function autoRechargeQuery() {
+  return queryOptions({
+    queryKey: billingKeys.autoRecharge(),
+    queryFn: ({ signal }) => apiData<AutoRechargeSetting>("/api/user/auto-recharge", { signal }),
+    staleTime: 60_000,
+  });
+}
+
+export function billingProfileQuery() {
+  return queryOptions({
+    queryKey: billingKeys.profile(),
+    queryFn: ({ signal }) => apiData<BillingProfile>("/api/user/billing-profile", { signal }),
+    staleTime: 5 * 60_000,
+  });
+}
+
+/** 支付回调页轮询用：`enabled` 由页面按 session 存活决定。 */
+export function embeddedCheckoutStatusQuery(sessionId: string) {
+  return queryOptions({
+    queryKey: billingKeys.embeddedSession(sessionId),
+    queryFn: ({ signal }) =>
+      apiData<StripeEmbeddedCheckoutStatus>(
+        `/api/user/stripe/embedded/session/${encodeURIComponent(sessionId)}`,
+        { signal },
+      ),
+    staleTime: 0,
+  });
+}
+
+export function topupConversionStatusQuery(tradeNo: string) {
+  return queryOptions({
+    queryKey: billingKeys.conversionStatus(tradeNo),
+    queryFn: ({ signal }) =>
+      apiData<TopupConversionStatus>("/api/user/topup/conversion-status", {
+        signal,
+        query: { trade_no: tradeNo },
+      }),
+    staleTime: 0,
+  });
+}
+
+// ---------------------------------------------------------------------------
+// 写
+// ---------------------------------------------------------------------------
+
+export interface RedeemCodeResult {
+  /** 兑换得到的额度（quota 单位） */
+  credited?: number;
+  credited_credits?: string;
+}
+
+export function redeemCodeMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (code: string) =>
+      apiEnvelope<RedeemCodeResult & { data?: number }>("/api/user/topup", {
+        method: "POST",
+        body: { code },
+      }),
+    onSuccess: () => invalidate(client, [billingKeys.all, ...BALANCE_KEYS]),
+  });
+}
+
+export interface CheckoutRequest {
+  amount: number;
+  payment_method?: string;
+}
+
+export function stripeCheckoutMutation() {
+  return mutationOptions({
+    mutationFn: (body: CheckoutRequest) =>
+      apiData<{ pay_link: string; trade_no: string }>("/api/user/stripe/pay", {
+        method: "POST",
+        body,
+      }),
+  });
+}
+
+export function stripeEmbeddedCheckoutMutation() {
+  return mutationOptions({
+    mutationFn: (body: CheckoutRequest) =>
+      apiData<{ client_secret: string; session_id: string; trade_no: string }>(
+        "/api/user/stripe/embedded/pay",
+        { method: "POST", body },
+      ),
+  });
+}
+
+export function createHostedSetupSessionMutation() {
+  return mutationOptions({
+    mutationFn: (body: { payment_method?: string } = {}) =>
+      apiData<{ url: string; session_id: string }>("/api/user/stripe/setup/hosted-session", {
+        method: "POST",
+        body,
+      }),
+  });
+}
+
+export function updateAutoRechargeMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: Partial<AutoRechargeSetting> & { enabled: boolean }) =>
+      apiData<{ status: string; client_secret?: string; setup_intent_id?: string }>(
+        "/api/user/auto-recharge",
+        { method: "PUT", body },
+      ),
+    onSuccess: () => invalidate(client, [billingKeys.autoRecharge()]),
+  });
+}
+
+export function updateBillingProfileMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: BillingProfile) =>
+      apiData<BillingProfile>("/api/user/billing-profile", { method: "PUT", body }),
+    onSuccess: () => invalidate(client, [billingKeys.profile()]),
+  });
+}
diff --git a/apps/dashboard/src/lib/api/errors.ts b/apps/dashboard/src/lib/api/errors.ts
new file mode 100644
index 00000000..5a0d9620
--- /dev/null
+++ b/apps/dashboard/src/lib/api/errors.ts
@@ -0,0 +1,74 @@
+// errors —— 全站统一的请求错误模型。
+//
+// 一个类 + 一个 kind 判别，而不是两个类：
+//   1. `instanceof ApiError` 是既有统一判断入口（守卫、页面都在用），
+//      拆两个类会让 401 判断分叉成两条链；
+//   2. `kind` 表达「HTTP 成功但业务失败」，`status` 仍保留 HTTP 语义。
+//
+// 归一来源（已对 backend 源码核实）：
+//   423 登录锁定  { success:false, code:"login_locked", message, retry_after }   backend/controller/user.go:68-72
+//   429 限流      c.Status(429) 空体 或 AbortWithStatusJSON(429,{code,...})      backend/middleware/rate-limit.go:61,363
+//   业务失败     200 { success:false, message }（session 族）
+//                200 { code:!==200, message }（storages 族）
+
+/** 错误来源：`http` = 非 2xx；`business` = 2xx 但业务失败。 */
+export type ApiErrorKind = "http" | "business";
+
+export interface ApiErrorInit {
+  kind?: ApiErrorKind;
+  /** backend 的 code（字符串，如 "login_locked"；storages 族的数字 code 会被转成字符串） */
+  code?: string;
+  /** 面向用户的文案，缺省回落 `api <status>` */
+  message?: string;
+  /** 秒；来自 423/429 的 `retry_after` */
+  retryAfter?: number;
+  /** 原始响应体，UI 需要透传时自行取用 */
+  body?: unknown;
+}
+
+export class ApiError extends Error {
+  readonly status: number;
+  readonly kind: ApiErrorKind;
+  readonly code?: string;
+  readonly retryAfter?: number;
+  readonly body: unknown;
+
+  /**
+   * 兼容既有调用形态 `new ApiError(403, body)`——第三个参数是可选扩展，
+   * 老调用点不必立刻改写。
+   */
+  constructor(status: number, body: unknown, init: ApiErrorInit = {}) {
+    super(init.message ?? `api ${status}`);
+    this.name = "ApiError";
+    this.status = status;
+    this.kind = init.kind ?? "http";
+    this.code = init.code;
+    this.retryAfter = init.retryAfter;
+    this.body = init.body !== undefined ? init.body : body;
+  }
+}
+
+/** 会话失效（未登录 / 过期）。 */
+export function isUnauthorized(error: unknown): error is ApiError {
+  return error instanceof ApiError && error.kind === "http" && error.status === 401;
+}
+
+/** 已登录但无权访问。 */
+export function isForbidden(error: unknown): error is ApiError {
+  return error instanceof ApiError && error.kind === "http" && error.status === 403;
+}
+
+/** 账号临时锁定（423），通常带 `retryAfter`（秒）。 */
+export function isLocked(error: unknown): error is ApiError {
+  return error instanceof ApiError && error.kind === "http" && error.status === 423;
+}
+
+/** 限流（429）。 */
+export function isRateLimited(error: unknown): error is ApiError {
+  return error instanceof ApiError && error.kind === "http" && error.status === 429;
+}
+
+/** 2xx 但业务失败（`success:false` 或 storages 族 `code !== 200`）。 */
+export function isBusinessError(error: unknown): error is ApiError {
+  return error instanceof ApiError && error.kind === "business";
+}
diff --git a/apps/dashboard/src/lib/api/http.test.ts b/apps/dashboard/src/lib/api/http.test.ts
new file mode 100644
index 00000000..4b3cf85a
--- /dev/null
+++ b/apps/dashboard/src/lib/api/http.test.ts
@@ -0,0 +1,260 @@
+// http 传输层契约测试。
+//
+// 覆盖 PRD R1 / R7：URL 与 method、`New-Api-User` 注入、query 序列化、
+// FormData 不设 content-type、两类信封族、五类错误归一。
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import {
+  apiData,
+  apiEnvelope,
+  apiPath,
+  apiRequest,
+  type ApiRequestOptions,
+} from "./http";
+import { ApiError, isBusinessError, isLocked, isRateLimited, isUnauthorized } from "./errors";
+
+const realFetch = globalThis.fetch;
+const realDocument = (globalThis as { document?: unknown }).document;
+
+interface Captured {
+  url: string;
+  init: RequestInit;
+}
+
+let captured: Captured[] = [];
+
+/** 取第 n 次调用（测试里都是单次调用，索引越界即测试失败）。 */
+function call(index = 0): Captured {
+  const item = captured[index];
+  if (!item) throw new Error(`expected fetch call #${index}, got ${captured.length}`);
+  return item;
+}
+
+function stubFetch(
+  handler: (url: string, init: RequestInit) => Response | Promise<Response>,
+): void {
+  globalThis.fetch = (async (input: RequestInfo | URL, init: RequestInit = {}) => {
+    const url = typeof input === "string" ? input : String(input);
+    captured.push({ url, init });
+    return handler(url, init);
+  }) as typeof fetch;
+}
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "content-type": "application/json" },
+  });
+}
+
+/** 断言 promise 抛出 ApiError 并返回它。 */
+async function rejects(promise: Promise<unknown>): Promise<ApiError> {
+  try {
+    await promise;
+  } catch (error) {
+    if (!(error instanceof ApiError)) throw new Error(`expected ApiError, got ${String(error)}`);
+    return error;
+  }
+  throw new Error("expected rejection, got success");
+}
+
+beforeEach(() => {
+  captured = [];
+  // readUserId 读 document.cookie；测试环境无 DOM，这里注入最小壳。
+  (globalThis as { document?: unknown }).document = {
+    cookie: "new-api-user-id=42",
+  };
+});
+
+afterEach(() => {
+  globalThis.fetch = realFetch;
+  if (realDocument === undefined) {
+    delete (globalThis as { document?: unknown }).document;
+  } else {
+    (globalThis as { document?: unknown }).document = realDocument;
+  }
+});
+
+describe("apiPath", () => {
+  test("/api/x 加 dashboard 前缀；其余原样", () => {
+    expect(apiPath("/api/user/self")).toBe("/dashboard-api/user/self");
+    expect(apiPath("/v1/models")).toBe("/v1/models");
+  });
+});
+
+describe("query 序列化", () => {
+  test("剔除 undefined/null，数组 repeat，布尔转字符串", async () => {
+    stubFetch(() => json({ success: true, data: null }));
+    await apiData("/api/tickets", {
+      query: { page: 2, status: "open", flag: true, skip: undefined, nil: null, ids: [1, 2] },
+    });
+    const url = call().url;
+    expect(url.startsWith("/dashboard-api/tickets?")).toBe(true);
+    expect(url).toContain("page=2");
+    expect(url).toContain("status=open");
+    expect(url).toContain("flag=true");
+    expect(url).toContain("ids=1");
+    expect(url).toContain("ids=2");
+    expect(url).not.toContain("skip=");
+    expect(url).not.toContain("nil=");
+  });
+});
+
+describe("请求头与 body", () => {
+  test("注入 New-Api-User 与 same-origin 凭据", async () => {
+    stubFetch(() => json({ success: true, data: 1 }));
+    await apiData("/api/user/self");
+    const headers = new Headers(call().init.headers);
+    expect(headers.get("New-Api-User")).toBe("42");
+    expect(call().init.credentials).toBe("same-origin");
+  });
+
+  test("对象 body → JSON + content-type", async () => {
+    stubFetch(() => json({ success: true, data: 1 }));
+    await apiData("/api/token/", { method: "POST", body: { name: "k" } });
+    const headers = new Headers(call().init.headers);
+    expect(headers.get("content-type")).toBe("application/json");
+    expect(call().init.body).toBe(JSON.stringify({ name: "k" }));
+  });
+
+  test("FormData 不设 content-type（交给浏览器补 boundary）", async () => {
+    stubFetch(() => json({ success: true, data: 1 }));
+    const fd = new FormData();
+    fd.append("file", new Blob(["x"]), "a.txt");
+    await apiData("/api/tickets/upload", { method: "POST", body: fd });
+    const headers = new Headers(call().init.headers);
+    expect(headers.has("content-type")).toBe(false);
+    expect(call().init.body).toBe(fd);
+  });
+
+  test("GET 带 body 直接报错（不静默丢弃）", async () => {
+    stubFetch(() => json({ success: true, data: 1 }));
+    expect(() => apiRequest("/api/x", { body: { a: 1 } })).toThrow(/不支持 body/);
+  });
+
+  test("signal 透传", async () => {
+    stubFetch(() => json({ success: true, data: 1 }));
+    const controller = new AbortController();
+    await apiData("/api/x", { signal: controller.signal });
+    expect(call().init.signal).toBe(controller.signal);
+  });
+});
+
+describe("错误归一", () => {
+  test("401 → isUnauthorized", async () => {
+    stubFetch(() => json({ success: false, message: "未登录" }, 401));
+    const err = await rejects(apiData("/api/user/self"));
+    expect(isUnauthorized(err)).toBe(true);
+    expect(err.message).toBe("未登录");
+  });
+
+  test("403 → 非 unauthorized（守卫要区分）", async () => {
+    stubFetch(() => json({ success: false, message: "无权限" }, 403));
+    const err = await rejects(apiData("/api/x"));
+    expect(isUnauthorized(err)).toBe(false);
+    expect(err.status).toBe(403);
+  });
+
+  test("423 → isLocked 且带 retryAfter", async () => {
+    stubFetch(() =>
+      json(
+        { success: false, code: "login_locked", message: "账号已锁定", retry_after: 87 },
+        423,
+      ),
+    );
+    const err = await rejects(apiData("/api/user/login"));
+    expect(isLocked(err)).toBe(true);
+    expect(err.retryAfter).toBe(87);
+    expect(err.code).toBe("login_locked");
+  });
+
+  test("429 空体 → isRateLimited，message 回落 api 429", async () => {
+    stubFetch(() => new Response(null, { status: 429 }));
+    const err = await rejects(apiData("/api/x"));
+    expect(isRateLimited(err)).toBe(true);
+    expect(err.message).toBe("api 429");
+  });
+
+  test("200 但 success:false → business 错误", async () => {
+    stubFetch(() => json({ success: false, message: "余额不足" }));
+    const err = await rejects(apiData("/api/token/", { method: "POST" }));
+    expect(isBusinessError(err)).toBe(true);
+    expect(err.status).toBe(200);
+    expect(err.message).toBe("余额不足");
+  });
+
+  test("非 JSON 错误体 → 保留原文，不抛解析错", async () => {
+    stubFetch(() => new Response("Bad Gateway", { status: 502 }));
+    const err = await rejects(apiData("/api/x"));
+    expect(err.status).toBe(502);
+    expect(err.body).toBe("Bad Gateway");
+  });
+});
+
+describe("信封族", () => {
+  test("session 族：apiData 解 data，apiEnvelope 返整包", async () => {
+    stubFetch(() => json({ success: true, data: { page: 1, total: 9, items: [] } }));
+    expect(
+      await apiData<{ page: number; total: number; items: unknown[] }>("/api/x"),
+    ).toEqual({ page: 1, total: 9, items: [] });
+
+    captured = [];
+    stubFetch(() => json({ success: true, data: [], page: 2, total: 9 }));
+    const body = await apiEnvelope<{ data: unknown[]; page: number; total: number }>("/api/x");
+    expect(body.page).toBe(2);
+    expect(body.total).toBe(9);
+  });
+
+  test("storages 族：code 200 通过，code 500 判业务失败", async () => {
+    stubFetch(() => json({ code: 200, message: "ok", data: { items: [] } }));
+    expect(await apiData<{ items: unknown[] }>("/api/user/storages", { envelope: "storages" }))
+      .toEqual({ items: [] });
+
+    stubFetch(() => json({ code: 500, message: "内部错误", data: null }));
+    const err = await rejects(apiData("/api/user/storages", { envelope: "storages" }));
+    expect(isBusinessError(err)).toBe(true);
+    expect(err.code).toBe("500");
+    expect(err.message).toBe("内部错误");
+  });
+
+  test("storages 族若只判 success 会漏抓——专项回归", async () => {
+    // 没有 success 字段、code 非 200：按 session 族判会被当成功
+    stubFetch(() => json({ code: 400, message: "bad", data: null }));
+    const asSession = await apiData("/api/user/storages").catch((e: unknown) => e);
+    expect(isBusinessError(asSession)).toBe(false); // 证明默认族抓不到
+
+    stubFetch(() => json({ code: 400, message: "bad", data: null }));
+    const asStorages = await rejects(apiData("/api/user/storages", { envelope: "storages" }));
+    expect(isBusinessError(asStorages)).toBe(true);
+  });
+
