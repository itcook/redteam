@@ -0,0 +1,61 @@
+// settings —— 设置页的通知与偏好（`/api/user/balance-alerts`、`/api/user/self/email-preferences`）。
+//
+// 只有 4 个端点。设置页的其他字段（资料、密码）在 `auth.ts`；2FA 不在本任务范围。
+//
+// 历史提醒：周报邮件的 `weekly-preview` / `weekly-snapshot` / `weekly-test` 已被
+// backend 删除（commit 88cfb1f3b），不要照搬 interim 的 4 个调用。
+
+import { mutationOptions, queryOptions, type QueryClient } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { settingsKeys } from "./keys";
+import { invalidate } from "./invalidate";
+
+export interface BalanceAlerts {
+  balance_alert_thresholds?: number[];
+  balance_alert_default_disabled?: boolean;
+}
+
+export interface EmailPreferences {
+  usage_digest_enabled: boolean;
+  product_updates_enabled: boolean;
+  locale: string;
+  timezone: string;
+  show_amount_in_subject: boolean;
+}
+
+export function balanceAlertsQuery() {
+  return queryOptions({
+    queryKey: settingsKeys.balanceAlerts(),
+    queryFn: ({ signal }) => apiData<BalanceAlerts>("/api/user/balance-alerts", { signal }),
+    staleTime: 60_000,
+  });
+}
+
+export function updateBalanceAlertsMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: (body: BalanceAlerts) =>
+      apiData<void>("/api/user/balance-alerts", { method: "PUT", body }),
+    onSuccess: () => invalidate(client, [settingsKeys.balanceAlerts()]),
+  });
+}
+
+export function emailPreferencesQuery() {
+  return queryOptions({
+    queryKey: settingsKeys.emailPreferences(),
+    queryFn: ({ signal }) =>
+      apiData<EmailPreferences>("/api/user/self/email-preferences", { signal }),
+    staleTime: 60_000,
+  });
+}
+
+export function updateEmailPreferencesMutation(client: QueryClient) {
+  return mutationOptions({
+    // 响应回显保存后的完整偏好，可直接写回缓存
+    mutationFn: (body: Partial<EmailPreferences>) =>
+      apiData<EmailPreferences>("/api/user/self/email-preferences", { method: "PUT", body }),
+    onSuccess: (data) => {
+      if (data) client.setQueryData(settingsKeys.emailPreferences(), data as EmailPreferences);
+    },
+  });
+}
+
