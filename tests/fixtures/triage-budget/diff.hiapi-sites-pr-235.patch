+// overview —— 概览页的聚合读。
+//
+// 概览是「汇总视图」：一次请求拿齐首屏字段，避免页面并发三个 query 各渲染一半。
+// 复用现有端点，不新增契约：`/api/user/self` + `/api/user/aff`。
+//
+// 最近消费明细不走这里 —— 页面直接用 `logListQuery()`，翻页/筛选语义与 logs 页一致。
+//
+// 注意：这里会与 `authSelfQuery()` 各存一份 `self`。这是刻意的：概览的独立性优先，
+// 而且写操作同时失效 `authKeys.self` 与 `overviewKeys.summary`（见 docs/api-map.md）。
+//
+// `task/progress` 与 `notice` 不在 57 个端点内（interim 概览未使用），父任务若要
+// 「新手任务入口 / 公告位」，页面实现时再按同样模式补。
+
+import { queryOptions } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { overviewKeys } from "./keys";
+import type { AuthUser } from "./auth";
+import type { AffCodeInfo } from "./referral";
+
+export interface OverviewSummary {
+  self: AuthUser;
+  aff: AffCodeInfo;
+}
+
+export function overviewSummaryQuery() {
+  return queryOptions({
+    queryKey: overviewKeys.summary(),
+    queryFn: async ({ signal }): Promise<OverviewSummary> => {
+      const [self, aff] = await Promise.all([
+        apiData<AuthUser>("/api/user/self", { signal }),
+        apiData<AffCodeInfo>("/api/user/aff", { signal }),
+      ]);
+      return { self, aff };
+    },
+    staleTime: 30_000,
+  });
+}
