@@ -0,0 +1,65 @@
+// mcp —— MCP 连接管理（`/api/oauth/mcp/connections*`）。
+//
+// api-keys 页用它展示「哪些 MCP 客户端拿着 Key」，并可一键撤销。
+//
+// **响应形状不保证有信封**：同一端点在不同后端版本下可能返回裸数组，
+// 也可能返回 `{success,data}`。`apiEnvelope` 已经放过两种情况（裸数组没有 `success` 字段），
+// 这里再做一次「有 data 取 data」的兼容，与 interim 的 `unwrapMcpResponse` 等价。
+
+import { mutationOptions, queryOptions, type QueryClient } from "@tanstack/react-query";
+import { apiEnvelope } from "./http";
+import { mcpKeys } from "./keys";
+import { invalidate } from "./invalidate";
+
+export type McpClientTrust = "trusted" | "untrusted" | string;
+
+export interface McpConnection {
+  token_id: number;
+  name: string;
+  client_name: string;
+  created_time: number;
+  accessed_time: number;
+  used_usd: number;
+  limit_usd: number;
+  expired_time: number;
+  expired?: boolean;
+  client_trust?: McpClientTrust | null;
+  /** 6 位授权编号，便于与客服核对 */
+  client_ref?: string | null;
+}
+
+/** 兼容「裸数组」与「`{success,data}`」两种响应。 */
+function unwrap<T>(value: T | { data?: T }): T {
+  if (value && typeof value === "object" && "data" in (value as object)) {
+    const inner = (value as { data?: T }).data;
+    if (inner !== undefined) return inner;
+  }
+  return value as T;
+}
+
+export function mcpConnectionsQuery() {
+  return queryOptions({
+    queryKey: mcpKeys.connections(),
+    queryFn: async ({ signal }) => {
+      const body = await apiEnvelope<McpConnection[] | { data?: McpConnection[] }>(
+        "/api/oauth/mcp/connections",
+        { signal, cache: "no-store" },
+      );
+      return unwrap<McpConnection[]>(body) ?? [];
+    },
+    staleTime: 30_000,
+  });
+}
+
+export function revokeAllMcpConnectionsMutation(client: QueryClient) {
+  return mutationOptions({
+    mutationFn: async () => {
+      const body = await apiEnvelope<{ revoked: number } | { data?: { revoked: number } }>(
+        "/api/oauth/mcp/connections/revoke_all",
+        { method: "POST" },
+      );
+      return unwrap<{ revoked: number }>(body);
+    },
+    onSuccess: () => invalidate(client, [mcpKeys.all]),
+  });
+}
