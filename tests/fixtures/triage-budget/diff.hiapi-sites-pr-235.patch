+// logs —— 调用日志（`/api/log/self`、`/api/log/self/calls`）。
+//
+// 分页形状是「`data` 里放 items」但版本不同：
+//   - `/api/log/self`        → `data:{items,page,page_size,total}`
+//   - `/api/log/self/calls`  → 同构
+// 所以列表返回 `apiData`（`data` 里已含完整分页）；**翻页参数都是 `p` 不是 `page`**，
+// 由 `LogListParams` / `CallLogParams` 显式表达（见 docs/api-map.md D3）。
+
+import { queryOptions } from "@tanstack/react-query";
+import { apiData } from "./http";
+import { logKeys, type CallLogParams, type LogListParams } from "./keys";
+
+export interface LogEntry {
+  id: number;
+  user_id: number;
+  created_at: number;
+  /** 1=充值，2=消费，3=管理，4=系统，5=错误，6=退款，7=奖励 */
+  type: number;
+  content: string;
+  username: string;
+  token_name: string;
+  model_name: string;
+  channel_name: string;
+  quota: number;
+  prompt_tokens: number;
+  completion_tokens: number;
+  use_time: number;
+  is_stream: boolean;
+  ip: string;
+  request_id?: string;
+  token_id?: number;
+  group?: string;
+  /** JSON 字符串：奖励/活动元数据 */
+  other?: string;
+}
+
+export interface LogPage {
+  items: LogEntry[];
+  page: number;
+  page_size: number;
+  total: number;
+}
+
+export type CallLogStatus = "success" | "failed" | "running";
+
+export interface CallLogEntry {
+  id: string;
+  created_at: number;
+  status: CallLogStatus;
+  status_code: number;
+  request_id?: string;
+  task_id?: string;
+  model_name: string;
+  token_name: string;
+  endpoint?: string;
+  method?: string;
+  public_code?: string;
+  public_message?: string;
+  content?: string;
+  request_input?: unknown;
+  /** 毫秒 */
+  use_time: number;
+  quota: number;
+  initial_quota?: number;
+  settled_quota?: number;
+  settlement_delta_quota?: number;
+  billing_status?: string;
+  charged_quota: number;
+  refund_quota: number;
+  refund_status?: string;
+  refunded: boolean;
+}
+
+export interface CallLogPage {
+  items: CallLogEntry[];
+  page: number;
+  page_size: number;
+  total: number;
+}
+
+export function logListQuery(params: LogListParams = {}) {
+  return queryOptions({
+    queryKey: logKeys.list(params),
+    queryFn: ({ signal }) => apiData<LogPage>("/api/log/self", { signal, query: params }),
+    staleTime: 30_000,
+  });
+}
+
+export function callLogListQuery(params: CallLogParams = {}) {
+  return queryOptions({
+    queryKey: logKeys.calls(params),
+    queryFn: ({ signal }) => apiData<CallLogPage>("/api/log/self/calls", { signal, query: params }),
+    staleTime: 30_000,
+  });
+}
