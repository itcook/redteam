+// invalidate —— mutation 成功后的统一失效入口。
+//
+// 抽出来的两个理由：
+//   1. 失效集合是「跨域契约」（写 A 要连带 B），集中成一处才好审阅；
+//   2. 返回 Promise，测试可以 await 后断言，不必用定时器猜。
+
+import type { QueryClient } from "@tanstack/react-query";
+import { authKeys, overviewKeys } from "./keys";
+
+/** TanStack Query 的 queryKey 形状（只读数组）。 */
+export type QueryKey = readonly unknown[];
+
+export function invalidate(client: QueryClient, keys: readonly QueryKey[]): Promise<void> {
+  return Promise.all(keys.map((queryKey) => client.invalidateQueries({ queryKey }))).then(
+    () => undefined,
+  );
+}
+
+/**
+ * 凡影响余额/配额的写操作必带这一组：否则 Header 余额与概览卡片停在旧值。
+ * 集中定义，避免 tokens / billing / referral 各写一份后漂移。
+ */
+export const BALANCE_KEYS: readonly QueryKey[] = [authKeys.self(), overviewKeys.summary()];
