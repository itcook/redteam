+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/setting"
+	lark "github.com/larksuite/oapi-sdk-go/v3"
+	larkcore "github.com/larksuite/oapi-sdk-go/v3/core"
+	larkim "github.com/larksuite/oapi-sdk-go/v3/service/im/v1"
+)
+
+// feishu_finance_agent_client.go —— 推广助手的两个外部依赖：
+//   - 飞书开放平台（官方 Go SDK：回复消息/卡片、更新卡片；长连接在 feishu_finance_agent_ws.go）
+//   - OpenAI 兼容 /chat/completions（strict json_schema 解析自然语言指令）
+
+const feishuFinanceAgentMaxRespBody = 1 << 20
+
+type feishuFinanceAgentMessenger interface {
+	ReplyText(ctx context.Context, messageID, text string) error
+	// ReplyCard 回复一张交互卡片，返回卡片消息自身的 message_id。
+	ReplyCard(ctx context.Context, messageID string, card map[string]any) (string, error)
+	// PatchCard 更新已发送卡片的内容（执行超过飞书回调时限后补发结果）。
+	PatchCard(ctx context.Context, messageID string, card map[string]any) error
+}
+
+var newFeishuFinanceAgentMessenger = func(s setting.FeishuFinanceAgentSetting) feishuFinanceAgentMessenger {
+	return &feishuFinanceAgentSDKMessenger{client: feishuFinanceAgentLarkClient(s)}
+}
+
+// 每个 app 复用同一个 lark.Client（内含 tenant_access_token 缓存）。
+var feishuFinanceAgentClients sync.Map
+
+func feishuFinanceAgentLarkClient(s setting.FeishuFinanceAgentSetting) *lark.Client {
+	key := s.AppID + "|" + s.OpenAPIBase
+	if c, ok := feishuFinanceAgentClients.Load(key); ok {
+		return c.(*lark.Client)
+	}
+	var opts []lark.ClientOptionFunc
+	if s.OpenAPIBase != "" {
+		opts = append(opts, lark.WithOpenBaseUrl(s.OpenAPIBase))
+	}
+	actual, _ := feishuFinanceAgentClients.LoadOrStore(key, lark.NewClient(s.AppID, s.AppSecret, opts...))
+	return actual.(*lark.Client)
+}
+
+// ResetFeishuFinanceAgentClientsForTest 清掉 SDK client 缓存（测试换配置时用）。
+func ResetFeishuFinanceAgentClientsForTest() {
+	feishuFinanceAgentClients.Range(func(k, _ any) bool { feishuFinanceAgentClients.Delete(k); return true })
+}
+
+type feishuFinanceAgentSDKMessenger struct {
+	client *lark.Client
+}
+
+func (m *feishuFinanceAgentSDKMessenger) reply(ctx context.Context, messageID, msgType string, content any) (string, error) {
+	raw, err := common.Marshal(content)
+	if err != nil {
+		return "", err
+	}
+	contentStr := string(raw)
+	msgTypeStr := msgType
+	resp, err := m.client.Im.V1.Message.Reply(ctx, larkim.NewReplyMessageReqBuilder().
+		MessageId(messageID).
+		Body(&larkim.ReplyMessageReqBody{MsgType: &msgTypeStr, Content: &contentStr}).
+		Build())
+	if err != nil {
+		return "", err
+	}
+	if !resp.Success() {
+		return "", fmt.Errorf("feishu reply %s: code %d %s", msgType, resp.Code, resp.Msg)
+	}
+	if resp.Data == nil {
+		return "", nil
+	}
+	return larkcore.StringValue(resp.Data.MessageId), nil
+}
+
+func (m *feishuFinanceAgentSDKMessenger) ReplyText(ctx context.Context, messageID, text string) error {
+	_, err := m.reply(ctx, messageID, "text", map[string]string{"text": text})
+	return err
+}
+
+func (m *feishuFinanceAgentSDKMessenger) ReplyCard(ctx context.Context, messageID string, card map[string]any) (string, error) {
+	return m.reply(ctx, messageID, "interactive", card)
+}
+
+func (m *feishuFinanceAgentSDKMessenger) PatchCard(ctx context.Context, messageID string, card map[string]any) error {
+	raw, err := common.Marshal(card)
+	if err != nil {
+		return err
+	}
+	content := string(raw)
+	resp, err := m.client.Im.V1.Message.Patch(ctx, larkim.NewPatchMessageReqBuilder().
+		MessageId(messageID).
+		Body(&larkim.PatchMessageReqBody{Content: &content}).
+		Build())
+	if err != nil {
+		return err
+	}
+	if !resp.Success() {
+		return fmt.Errorf("feishu patch message: code %d %s", resp.Code, resp.Msg)
+	}
+	return nil
+}
+
+func feishuFinanceAgentHTTP() *http.Client {
+	if c := GetHttpClient(); c != nil {
+		return c
+	}
+	return &http.Client{Timeout: 30 * time.Second}
+}
+
+// ---------------------------------------------------------------------------
+// LLM 解析
+// ---------------------------------------------------------------------------
+
+// feishuFinanceAgentCommand 是 LLM 的结构化输出。数值字段全部可空：null = 指令里没提，
+// 由服务端按确定性规则补默认值，绝不让模型「猜」一个数字出来。
+type feishuFinanceAgentCommand struct {
+	Intent                string   `json:"intent"` // execute | clarify | help
+	Question              string   `json:"question"`
+	TargetAccount         string   `json:"target_account"`
+	AddPromotion          bool     `json:"add_promotion"`
+	CommissionRatePercent *float64 `json:"commission_rate_percent"`
+	CommissionWindowDays  *int     `json:"commission_window_days"`
+	WithdrawEnabled       *bool    `json:"withdraw_enabled"`
+	GiftCredits           *int64   `json:"gift_credits"`
+}
+
+const feishuFinanceAgentSystemPrompt = `你是 HiAPI 推广助手的指令解析器。管理员会用一句中文指令，让你为某个 HiAPI 用户做以下操作中的一项或多项：
+1. 加入推广用户（add_promotion）
+2. 设置单独分佣比例（commission_rate_percent，百分数，如 10% → 10）
+3. 设置返佣有效期天数（commission_window_days，如「365 天有效期」→ 365；没提就填 null）
+4. 开启或关闭提现（withdraw_enabled：开启 true / 关闭 false / 没提 null）
+5. 赠送积分（gift_credits，整数积分。「10w」「10万」= 100000，「5k」「5千」= 5000，「1.5w」= 15000；没提就填 null）
+
+规则：
+- target_account 必须原样照抄指令里的用户标识（邮箱 / 用户名 / 数字用户 ID），不要改写、补全或猜测。
+- 只要提到了分佣、提现、推广任一项，add_promotion 就是 true；只送积分时 add_promotion 为 false。
+- 指令里找不到明确的用户标识、数字含义有歧义（例如「送点积分」「分佣高一点」）、或包含上述 5 项之外的操作时，intent=clarify，并在 question 里用一句中文说明缺什么或为什么不能做。
+- 用户只是在问怎么用、打招呼、或说「帮助」时，intent=help。
+- 其它情况 intent=execute，question 填空字符串。
+- 不在指令里的字段一律填 null，不要自行补默认值。
+- 只输出一个 JSON 对象，不要输出解释、Markdown 代码块或其它文字。`
+
+// feishuFinanceAgentCommandFields 是模型输出必须且仅允许出现的字段，与 strict schema 对齐。
+var feishuFinanceAgentCommandFields = map[string]struct{}{
+	"intent": {}, "question": {}, "target_account": {}, "add_promotion": {},
+	"commission_rate_percent": {}, "commission_window_days": {},
+	"withdraw_enabled": {}, "gift_credits": {},
+}
+
+// validateFeishuFinanceAgentCommandJSON 对模型输出做与 strict schema 等价的字段级校验：
+// 拒绝未知字段、要求全部字段存在（可空字段允许 null）、类型严格匹配、整数字段不允许小数。
+// 降级到 json_object 后这是唯一的 schema 兜底。
+func validateFeishuFinanceAgentCommandJSON(content string) error {
+	var raw map[string]json.RawMessage
+	if err := common.UnmarshalJsonStr(content, &raw); err != nil {
+		return fmt.Errorf("decode command JSON: %w", err)
+	}
+	for key := range raw {
+		if _, ok := feishuFinanceAgentCommandFields[key]; !ok {
+			return fmt.Errorf("command JSON has unexpected field %q", key)
+		}
+	}
+	for key := range feishuFinanceAgentCommandFields {
+		if _, ok := raw[key]; !ok {
+			return fmt.Errorf("command JSON missing field %q", key)
+		}
+	}
+	isNull := func(key string) bool { return string(raw[key]) == "null" }
+	// 只有 intent 必须非空；其余字段允许 null（json_object 模式下模型在追问场景会输出 null，
+	// 语义上与「未提及」一致，由下游按零值处理）。
+	if isNull("intent") {
+		return fmt.Errorf("field %q must not be null", "intent")
+	}
+	asString := func(key string) (string, error) {
+		if isNull(key) {
+			return "", nil
+		}
+		var v string
+		if err := common.UnmarshalJsonStr(string(raw[key]), &v); err != nil {
+			return "", fmt.Errorf("field %q must be a string", key)
+		}
+		return v, nil
+	}
+	asBool := func(key string) (bool, error) {
+		if isNull(key) {
+			return false, nil
+		}
+		var v bool
+		if err := common.UnmarshalJsonStr(string(raw[key]), &v); err != nil {
+			return false, fmt.Errorf("field %q must be a boolean", key)
+		}
+		return v, nil
+	}
+	asNumber := func(key string, integer bool) error {
+		if isNull(key) {
+			return nil
+		}
+		f, err := strconv.ParseFloat(strings.TrimSpace(string(raw[key])), 64)
+		if err != nil || math.IsNaN(f) || math.IsInf(f, 0) {
+			return fmt.Errorf("field %q must be a number", key)
+		}
+		if integer && math.Trunc(f) != f {
+			return fmt.Errorf("field %q must be an integer", key)
+		}
+		return nil
+	}
+
+	intent, err := asString("intent")
+	if err != nil {
+		return err
+	}
+	switch intent {
+	case "execute", "clarify", "help":
+	default:
+		return fmt.Errorf("field %q has invalid value %q", "intent", intent)
+	}
+	if _, err := asString("question"); err != nil {
+		return err
+	}
+	if _, err := asString("target_account"); err != nil {
+		return err
+	}
+	if _, err := asBool("add_promotion"); err != nil {
+		return err
+	}
+	if err := asNumber("commission_rate_percent", false); err != nil {
+		return err
+	}
+	if err := asNumber("commission_window_days", true); err != nil {
+		return err
+	}
+	if !isNull("withdraw_enabled") {
+		if _, err := asBool("withdraw_enabled"); err != nil {
+			return err
+		}
+	}
+	return asNumber("gift_credits", true)
+}
+
+func feishuFinanceAgentCommandSchema() map[string]any {
+	nullable := func(t string) map[string]any { return map[string]any{"type": []string{t, "null"}} }
+	return map[string]any{
+		"type":                 "object",
+		"additionalProperties": false,
+		"required": []string{
+			"intent", "question", "target_account", "add_promotion",
+			"commission_rate_percent", "commission_window_days", "withdraw_enabled", "gift_credits",
+		},
+		"properties": map[string]any{
+			"intent":                  map[string]any{"type": "string", "enum": []string{"execute", "clarify", "help"}},
+			"question":                map[string]any{"type": "string"},
+			"target_account":          map[string]any{"type": "string"},
+			"add_promotion":           map[string]any{"type": "boolean"},
+			"commission_rate_percent": nullable("number"),
+			"commission_window_days":  nullable("integer"),
+			"withdraw_enabled":        nullable("boolean"),
+			"gift_credits":            nullable("integer"),
+		},
+	}
+}
+
+var parseFeishuFinanceAgentCommand = parseFeishuFinanceAgentCommandLLM
+
+func parseFeishuFinanceAgentCommandLLM(ctx context.Context, text string) (*feishuFinanceAgentCommand, error) {
+	cfg := setting.GetFeishuFinanceAgentSetting()
+	if cfg.LLMBaseURL == "" || cfg.LLMAPIKey == "" || cfg.LLMModel == "" {
+		return nil, errors.New("FEISHU_FINANCE_AGENT_LLM_BASE_URL / LLM_API_KEY / LLM_MODEL not configured")
+	}
+	messages := []map[string]string{
+		{"role": "system", "content": feishuFinanceAgentSystemPrompt},
+		{"role": "user", "content": text},
+	}
+	// 首选 json_schema 严格模式；部分模型（如 DeepSeek）只支持 json_object，
+	// 上游明确拒绝 response_format 时自动降级重试一次。
+	body, status, err := feishuFinanceAgentChatCompletion(ctx, cfg, messages, map[string]any{
+		"type": "json_schema",
+		"json_schema": map[string]any{
+			"name":   "promotion_command",
+			"strict": true,
+			"schema": feishuFinanceAgentCommandSchema(),
+		},
+	})
+	if err == nil && status >= 400 && feishuFinanceAgentRejectedResponseFormat(body) {
+		common.SysLog("[feishu-finance-agent] LLM rejected json_schema, falling back to json_object")
+		body, status, err = feishuFinanceAgentChatCompletion(ctx, cfg, messages, map[string]any{"type": "json_object"})
+	}
+	if err != nil {
+		return nil, err
+	}
+	if status >= 400 {
+		return nil, fmt.Errorf("LLM upstream %d: %s", status, truncateRunes(string(body), 500))
+	}
+	var parsed struct {
+		Choices []struct {
+			Message struct {
+				Content string `json:"content"`
+			} `json:"message"`
+		} `json:"choices"`
+	}
+	if err := common.Unmarshal(body, &parsed); err != nil {
+		return nil, fmt.Errorf("decode LLM response: %w", err)
+	}
+	if len(parsed.Choices) == 0 {
+		return nil, errors.New("LLM returned no choices")
+	}
+	content := strings.TrimSpace(parsed.Choices[0].Message.Content)
+	content = strings.TrimPrefix(content, "```json")
+	content = strings.TrimPrefix(content, "```")
+	content = strings.TrimSuffix(content, "```")
+	content = strings.TrimSpace(content)
+	// json_object 降级后没有 schema 约束，必须自己做字段级校验（未知字段/缺字段/类型）。
+	if err := validateFeishuFinanceAgentCommandJSON(content); err != nil {
+		return nil, err
+	}
+	var cmd feishuFinanceAgentCommand
+	if err := common.UnmarshalJsonStr(strings.TrimSpace(content), &cmd); err != nil {
+		return nil, fmt.Errorf("decode command JSON: %w", err)
+	}
+	return &cmd, nil
+}
+
+// feishuFinanceAgentChatCompletion 发一次 chat/completions，返回原始 body 与 HTTP 状态。
+func feishuFinanceAgentChatCompletion(ctx context.Context, cfg setting.FeishuFinanceAgentSetting,
+	messages []map[string]string, responseFormat map[string]any) ([]byte, int, error) {
+	payload := map[string]any{
+		"model":           cfg.LLMModel,
+		"messages":        messages,
+		"response_format": responseFormat,
+	}
+	raw, err := common.Marshal(payload)
+	if err != nil {
+		return nil, 0, err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, cfg.LLMBaseURL+"/chat/completions", bytes.NewReader(raw))
+	if err != nil {
+		return nil, 0, err
+	}
+	req.Header.Set("Authorization", "Bearer "+cfg.LLMAPIKey)
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := feishuFinanceAgentHTTP().Do(req)
+	if err != nil {
+		return nil, 0, fmt.Errorf("LLM HTTP error: %w", err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, feishuFinanceAgentMaxRespBody))
+	if err != nil {
+		return nil, 0, err
+	}
+	return body, resp.StatusCode, nil
+}
+
+// feishuFinanceAgentRejectedResponseFormat 判断 4xx 是否因为不支持该 response_format。
+func feishuFinanceAgentRejectedResponseFormat(body []byte) bool {
+	lower := strings.ToLower(string(body))
+	return strings.Contains(lower, "response_format") ||
+		strings.Contains(lower, "json_schema") ||
+		strings.Contains(lower, "unavailable")
+}
