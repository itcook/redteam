@@ -0,0 +1,213 @@
+package service
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+)
+
+// feishu_finance_agent_card.go —— 推广助手的飞书消息卡片（v1 JSON，与字码账本同款结构）。
+
+var feishuLarkMDEscaper = strings.NewReplacer(
+	`\`, `\\`, `*`, `\*`, `_`, `\_`, `~`, `\~`, "`", "\\`", `[`, `\[`, `]`, `\]`, `<`, `&lt;`, `>`, `&gt;`,
+)
+
+func feishuMD(s string) string { return feishuLarkMDEscaper.Replace(s) }
+
+func formatFeishuCredits(n int64) string {
+	neg := n < 0
+	if neg {
+		n = -n
+	}
+	s := strconv.FormatInt(n, 10)
+	var b strings.Builder
+	for i, c := range s {
+		if i > 0 && (len(s)-i)%3 == 0 {
+			b.WriteByte(',')
+		}
+		b.WriteRune(c)
+	}
+	if neg {
+		return "-" + b.String()
+	}
+	return b.String()
+}
+
+func feishuPercent(bps int) string {
+	return strconv.FormatFloat(float64(bps)/100, 'f', -1, 64) + "%"
+}
+
+// feishuCreditsText 把原始 quota 格式化为卡片展示的积分（格式化属于展示层，不下沉到 model）。
+func feishuCreditsText(quota int) string {
+	return common.FormatCreditsFromQuota(int64(quota), common.QuotaPerUnit)
+}
+
+func feishuDiv(md string) map[string]any {
+	return map[string]any{"tag": "div", "text": map[string]any{"tag": "lark_md", "content": md}}
+}
+
+func feishuCard(template, title string, elements []map[string]any) map[string]any {
+	return map[string]any{
+		"config": map[string]any{"wide_screen_mode": true, "update_multi": true},
+		"header": map[string]any{
+			"template": template,
+			"title":    map[string]any{"tag": "plain_text", "content": title},
+		},
+		"elements": elements,
+	}
+}
+
+func feishuTargetLine(state *model.FeishuFinanceAgentTargetState) string {
+	parts := []string{fmt.Sprintf("ID %d", state.UserID)}
+	if state.Username != "" {
+		parts = append(parts, feishuMD(state.Username))
+	}
+	if state.Email != "" {
+		parts = append(parts, feishuMD(state.Email))
+	}
+	return "**目标用户**：" + strings.Join(parts, " · ")
+}
+
+func feishuCommissionText(view model.AffAgentCommissionView) string {
+	e := view.Effective
+	text := "未开启"
+	if e.Enabled {
+		source := "全局"
+		if e.Source == model.AffCommissionRuleSourceUser {
+			source = "单独"
+		}
+		text = fmt.Sprintf("%s（%s）", feishuPercent(e.RateBps), source)
+		if e.WindowEnabled {
+			text += fmt.Sprintf("，有效期 %d 天", e.WindowDays)
+		}
+	}
+	// 全局「限制返佣有效期」关闭时单独规则只落库不生效；明示出来，免得执行后看到的仍是全局比例而误以为没改成。
+	if o := view.Override; o != nil && e.Source != model.AffCommissionRuleSourceUser && o.CommissionRateBps != nil {
+		text += fmt.Sprintf("；单独规则 %s 已保存未生效", feishuPercent(*o.CommissionRateBps))
+	}
+	return text
+}
+
+func feishuOnOff(v bool) string {
+	if v {
+		return "开启"
+	}
+	return "关闭"
+}
+
+func feishuYesNo(v bool) string {
+	if v {
+		return "是"
+	}
+	return "否"
+}
+
+// feishuPlanLines 渲染「当前值 → 改后值」。只列计划里会改的项，不改的项不出现，避免误读。
+func feishuPlanLines(before *model.FeishuFinanceAgentTargetState, plan *feishuFinanceAgentPlan) []string {
+	lines := make([]string, 0, 4)
+	if plan.AddPromotion {
+		lines = append(lines, fmt.Sprintf("• 推广用户：%s → **是**", feishuYesNo(before.PromotionActive)))
+	}
+	if plan.CommissionRateBps != nil {
+		lines = append(lines, fmt.Sprintf("• 分佣：%s → **%s（单独），有效期 %d 天**",
+			feishuCommissionText(before.Commission), feishuPercent(*plan.CommissionRateBps), *plan.CommissionWindow))
+	}
+	if plan.WithdrawEnabled != nil {
+		lines = append(lines, fmt.Sprintf("• 提现：%s → **%s**", feishuOnOff(before.Withdrawal.Enabled), feishuOnOff(*plan.WithdrawEnabled)))
+	}
+	if plan.GiftCredits > 0 {
+		lines = append(lines, fmt.Sprintf("• 积分：余额 %s → **赠送 +%s**", feishuCreditsText(before.Quota), formatFeishuCredits(plan.GiftCredits)))
+	}
+	return lines
+}
+
+func feishuFinanceAgentConfirmCard(actionID, operatorName, rawText string, before *model.FeishuFinanceAgentTargetState, plan *feishuFinanceAgentPlan) map[string]any {
+	elements := []map[string]any{
+		feishuDiv(feishuTargetLine(before)),
+		feishuDiv(strings.Join(feishuPlanLines(before, plan), "\n")),
+	}
+	notes := make([]string, 0, len(plan.Defaults)+len(plan.Warnings))
+	for _, d := range plan.Defaults {
+		notes = append(notes, "ℹ️ "+d)
+	}
+	for _, w := range plan.Warnings {
+		notes = append(notes, "⚠️ "+w)
+	}
+	if len(notes) > 0 {
+		elements = append(elements, feishuDiv(strings.Join(notes, "\n")))
+	}
+	elements = append(elements,
+		map[string]any{"tag": "hr"},
+		feishuDiv(fmt.Sprintf("指令：%s\n发起人：%s · 30 分钟内有效，仅发起人可确认 · 请核对指令原文与改后值", feishuMD(rawText), feishuMD(operatorName))),
+		map[string]any{
+			"tag": "action",
+			"actions": []map[string]any{
+				{
+					"tag":  "button",
+					"text": map[string]any{"tag": "plain_text", "content": "确认执行"},
+					"type": "primary",
+					"value": map[string]any{
+						"action_id": actionID, "decision": "confirm",
+					},
+				},
+				{
+					"tag":  "button",
+					"text": map[string]any{"tag": "plain_text", "content": "取消"},
+					"type": "default",
+					"value": map[string]any{
+						"action_id": actionID, "decision": "cancel",
+					},
+				},
+			},
+		},
+	)
+	return feishuCard("orange", "请确认推广操作", elements)
+}
+
+func feishuFinanceAgentClosedCard(action *model.FeishuFinanceAgentAction, before *model.FeishuFinanceAgentTargetState, title, template string) map[string]any {
+	elements := []map[string]any{
+		feishuDiv(feishuTargetLine(before)),
+		feishuDiv("指令：" + feishuMD(action.RawText)),
+	}
+	if warning := feishuFinanceAgentInjectionWarningText(action.RawText); warning != "" {
+		elements = append(elements, feishuDiv("⚠️ "+feishuMD(warning)))
+	}
+	return feishuCard(template, title, elements)
+}
+
+func feishuFinanceAgentDoneCard(action *model.FeishuFinanceAgentAction, before, after *model.FeishuFinanceAgentTargetState, steps []feishuFinanceAgentStep, status string) map[string]any {
+	lines := make([]string, 0, len(steps))
+	for _, s := range steps {
+		mark := "✅"
+		if !s.OK {
+			mark = "❌"
+		}
+		lines = append(lines, fmt.Sprintf("%s %s：%s", mark, s.Name, feishuMD(s.Detail)))
+	}
+	elements := []map[string]any{
+		feishuDiv(feishuTargetLine(before)),
+		feishuDiv(strings.Join(lines, "\n")),
+	}
+	if after != nil {
+		elements = append(elements, feishuDiv(fmt.Sprintf(
+			"**执行后**：推广用户 %s · 分佣 %s · 提现 %s · 积分余额 %s",
+			feishuYesNo(after.PromotionActive), feishuCommissionText(after.Commission),
+			feishuOnOff(after.Withdrawal.Enabled), feishuCreditsText(after.Quota),
+		)))
+	}
+	if warning := feishuFinanceAgentInjectionWarningText(action.RawText); warning != "" {
+		elements = append(elements, feishuDiv("⚠️ "+feishuMD(warning)))
+	}
+	elements = append(elements, map[string]any{"tag": "hr"}, feishuDiv("指令："+feishuMD(action.RawText)))
+	template, title := "green", "已执行"
+	switch status {
+	case model.FeishuFinanceAgentActionPartial:
+		template, title = "orange", "部分执行成功"
+	case model.FeishuFinanceAgentActionFailed:
+		template, title = "red", "执行失败"
+	}
+	return feishuCard(template, title, elements)
+}
