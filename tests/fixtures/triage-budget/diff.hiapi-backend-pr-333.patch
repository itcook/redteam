+// ClaimFeishuFinanceAgentAction atomically moves an action from -> to and bumps ExecVersion.
+// staleBefore > 0 additionally requires updated_at < staleBefore (recovery claim).
+// Returns the new fencing version; won=false means someone else already claimed it.
+func ClaimFeishuFinanceAgentAction(id, from, to string, staleBefore int64, fields map[string]any) (version int, won bool, err error) {
+	if fields == nil {
+		fields = map[string]any{}
+	}
+	err = DB.Transaction(func(tx *gorm.DB) error {
+		var action FeishuFinanceAgentAction
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("id = ?", id).First(&action).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return nil
+			}
+			return err
+		}
+		if action.Status != from || (staleBefore > 0 && action.UpdatedAt >= staleBefore) {
+			return nil
+		}
+		version = action.ExecVersion + 1
+		fields["status"] = to
+		fields["exec_version"] = version
+		fields["updated_at"] = common.GetTimestamp()
+		res := tx.Model(&FeishuFinanceAgentAction{}).
+			Where("id = ? AND status = ? AND exec_version = ?", id, from, action.ExecVersion).
+			Updates(fields)
+		if res.Error != nil {
+			return res.Error
+		}
+		won = res.RowsAffected == 1
+		return nil
+	})
+	return version, won, err
+}
+
+// TransitionFeishuFinanceAgentActionVersioned writes a terminal state only if the caller still
+// owns the current execution version; a superseded (hung) executor loses and writes nothing.
+func TransitionFeishuFinanceAgentActionVersioned(id, from string, version int, to string, fields map[string]any) (bool, error) {
+	if fields == nil {
+		fields = map[string]any{}
+	}
+	fields["status"] = to
+	fields["updated_at"] = common.GetTimestamp()
+	res := DB.Model(&FeishuFinanceAgentAction{}).
+		Where("id = ? AND status = ? AND exec_version = ?", id, from, version).
+		Updates(fields)
+	if res.Error != nil {
+		return false, res.Error
+	}
+	return res.RowsAffected == 1, nil
+}
+
+// ListStaleFeishuFinanceAgentExecuting returns actions stuck in executing whose
+// last update is older than the cutoff (process crash / restart leftovers).
+func ListStaleFeishuFinanceAgentExecuting(updatedBefore int64, limit int) ([]FeishuFinanceAgentAction, error) {
+	var actions []FeishuFinanceAgentAction
+	err := DB.Where("status = ? AND updated_at < ?", FeishuFinanceAgentActionExecuting, updatedBefore).
+		Order("created_at asc").Limit(limit).Find(&actions).Error
+	return actions, err
+}
+
+// ListStaleFeishuFinanceAgentParsing returns rows that were accepted but never got a plan
+// (process died between insert and LLM parse). They are safe to reparse because no card was sent.
+func ListStaleFeishuFinanceAgentParsing(updatedBefore int64, limit int) ([]FeishuFinanceAgentAction, error) {
+	var actions []FeishuFinanceAgentAction
+	err := DB.Where("status = ? AND plan_json = ? AND updated_at < ?", FeishuFinanceAgentActionParsing, "", updatedBefore).
+		Order("created_at asc").Limit(limit).Find(&actions).Error
+	return actions, err
+}
+
+// ListFeishuFinanceAgentUnpatchedActions returns terminal rows whose result card was never
+// successfully updated, so the periodic sweeper can retry the patch.
+func ListFeishuFinanceAgentUnpatchedActions(executedAfter int64, limit int) ([]FeishuFinanceAgentAction, error) {
+	var actions []FeishuFinanceAgentAction
+	err := DB.Where("status IN ? AND card_message_id <> ? AND card_patched = ? AND executed_at >= ?",
+		[]string{FeishuFinanceAgentActionExecuted, FeishuFinanceAgentActionPartial, FeishuFinanceAgentActionFailed},
+		"", false, executedAfter).
+		Order("executed_at asc").Limit(limit).Find(&actions).Error
+	return actions, err
+}
