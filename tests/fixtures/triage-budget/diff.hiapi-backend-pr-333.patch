+func TestFeishuFinanceAgentExecutionFencingRejectsStaleWriter(t *testing.T) {
+	fx := setupFeishuFinanceAgentTest(t, feishuFullCommand())
+	require.NoError(t, processFeishuFinanceAgentMessage(context.Background(),
+		feishuTestEvent("om_fence", feishuTestOperatorOpenID, "p2p", "target@example.com 送 10w 积分", false)))
+	action := feishuActionByMessage(t, "om_fence")
+
+	v1, won, err := model.ClaimFeishuFinanceAgentAction(action.Id,
+		model.FeishuFinanceAgentActionPending, model.FeishuFinanceAgentActionExecuting, 0, nil)
+	require.NoError(t, err)
+	require.True(t, won)
+	require.Equal(t, 1, v1)
+
+	cutoff := common.GetTimestamp() - int64(feishuFinanceAgentStaleExecuting.Seconds())
+	require.NoError(t, model.DB.Model(&model.FeishuFinanceAgentAction{}).Where("id = ?", action.Id).
+		Update("updated_at", cutoff-60).Error)
+	v2, won, err := model.ClaimFeishuFinanceAgentAction(action.Id,
+		model.FeishuFinanceAgentActionExecuting, model.FeishuFinanceAgentActionExecuting, cutoff, nil)
+	require.NoError(t, err)
+	require.True(t, won)
+	require.Equal(t, 2, v2)
+
+	won, err = model.TransitionFeishuFinanceAgentActionVersioned(action.Id, model.FeishuFinanceAgentActionExecuting, v1,
+		model.FeishuFinanceAgentActionExecuted, map[string]any{"result_json": "stale"})
+	require.NoError(t, err)
+	require.False(t, won, "被接管的旧执行不能覆盖终态")
+	won, err = model.TransitionFeishuFinanceAgentActionVersioned(action.Id, model.FeishuFinanceAgentActionExecuting, v2,
+		model.FeishuFinanceAgentActionExecuted, map[string]any{"result_json": "fresh"})
+	require.NoError(t, err)
+	require.True(t, won)
+	_ = fx
+}
