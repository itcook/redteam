+func TestFeishuFinanceAgentConfirmExecutesOnce(t *testing.T) {
+	fx := setupFeishuFinanceAgentTest(t, feishuFullCommand())
+	text := "target@example.com 送 10w 积分，10%分佣"
+	require.NoError(t, processFeishuFinanceAgentMessage(context.Background(),
+		feishuTestEvent("om_1", feishuTestOperatorOpenID, "group", text, true)))
+	require.Len(t, fx.messenger.cards, 1)
+	action := feishuActionByMessage(t, "om_1")
+	require.Equal(t, model.FeishuFinanceAgentActionPending, action.Status)
+	require.Equal(t, fx.targetID, action.TargetUserId)
+	require.Equal(t, "om_card", action.CardMessageId)
+
+	// 飞书重投同一条消息不会产生第二张卡片。
+	require.NoError(t, processFeishuFinanceAgentMessage(context.Background(),
+		feishuTestEvent("om_1", feishuTestOperatorOpenID, "group", text, true)))
+	require.Len(t, fx.messenger.cards, 1)
+
+	var before model.User
+	require.NoError(t, model.DB.First(&before, fx.targetID).Error)
+
+	resp, err := HandleFeishuFinanceAgentCard(feishuTestCardBody(t, feishuTestOperatorOpenID, action.Id, "confirm"))
+	require.NoError(t, err)
+	require.Equal(t, "success", resp["toast"].(map[string]any)["type"], feishuActionByMessage(t, "om_1").ResultJson)
+	require.NotNil(t, resp["card"])
+
+	// 再点一次：返回同一结果卡片（不是只弹「已处理过」），且不会重复执行。
+	resp, err = HandleFeishuFinanceAgentCard(feishuTestCardBody(t, feishuTestOperatorOpenID, action.Id, "confirm"))
+	require.NoError(t, err)
+	require.Equal(t, "success", resp["toast"].(map[string]any)["type"])
+	require.NotNil(t, resp["card"])
+
+	var after model.User
+	require.NoError(t, model.DB.First(&after, fx.targetID).Error)
+	grantQuota, err := common.CreditsToQuota(100000, common.QuotaPerUnit)
+	require.NoError(t, err)
+	require.Equal(t, before.Quota+grantQuota, after.Quota)
+	var grants int64
+	require.NoError(t, model.DB.Model(&model.RewardGrant{}).Count(&grants).Error)
+	require.EqualValues(t, 1, grants)
+
+	state, err := model.GetFeishuFinanceAgentTargetState(fx.targetID)
+	require.NoError(t, err)
+	require.True(t, state.PromotionActive)
+	// 全局「限制返佣有效期」默认关：单独规则落库但不生效，卡片上有对应警告。
+	require.NotNil(t, state.Commission.Override)
+	require.Equal(t, 1000, *state.Commission.Override.CommissionRateBps)
+	require.Equal(t, 365, *state.Commission.Override.WindowDays)
+	require.Contains(t, feishuCommissionText(state.Commission), "已保存未生效")
+	require.True(t, state.ExistingWithdraw != nil && state.ExistingWithdraw.Enabled)
+	require.Equal(t, model.FeishuFinanceAgentActionExecuted, feishuActionByMessage(t, "om_1").Status)
+}
