+			"updated_at": common.GetTimestamp() - int64(feishuFinanceAgentStaleExecuting.Seconds()) - 60,
+		}).Error)
+
+	recoverFeishuFinanceAgentExecutingRows()
+
+	recovered := feishuActionByMessage(t, "om_crash")
+	require.Equal(t, model.FeishuFinanceAgentActionExecuted, recovered.Status)
+	require.NotZero(t, recovered.ExecutedAt)
