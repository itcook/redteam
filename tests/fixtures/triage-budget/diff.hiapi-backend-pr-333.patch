+type fakeFeishuMessenger struct {
+	mu      sync.Mutex
+	texts   []string
+	cards   []map[string]any
+	patched []map[string]any
+}
+
+func (f *fakeFeishuMessenger) ReplyText(_ context.Context, _ string, text string) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.texts = append(f.texts, text)
+	return nil
+}
+
+func (f *fakeFeishuMessenger) ReplyCard(_ context.Context, _ string, card map[string]any) (string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.cards = append(f.cards, card)
+	return "om_card", nil
+}
+
+func (f *fakeFeishuMessenger) PatchCard(_ context.Context, _ string, card map[string]any) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.patched = append(f.patched, card)
+	return nil
+}
