+package setting
+
+import (
+	"os"
+	"strings"
+	"sync/atomic"
+)
+
+// FeishuFinanceAgentSetting 飞书「HiAPI推广助手」机器人配置，全部来自环境变量，
+// 不入库、不进代码仓库（App Secret / LLM Key / HMAC keyring 都属于部署密钥）。
+type FeishuFinanceAgentSetting struct {
+	// AppID / AppSecret 换 tenant_access_token，用于回复消息、发确认卡片。
+	AppID     string
+	AppSecret string
+	// OpenAPIBase 默认 https://open.feishu.cn/open-apis；本地冒烟可指向假服务。
+	OpenAPIBase string
+	// LLMBaseURL 形如 https://<hiapi 域名>/v1，走 OpenAI 兼容 /chat/completions 解析自然语言指令。
+	LLMBaseURL string
+	LLMAPIKey  string
+	LLMModel   string
+}
+
+var cachedFeishuFinanceAgentSetting atomic.Pointer[FeishuFinanceAgentSetting]
+
+func GetFeishuFinanceAgentSetting() FeishuFinanceAgentSetting {
+	if p := cachedFeishuFinanceAgentSetting.Load(); p != nil {
+		return *p
+	}
+	s := FeishuFinanceAgentSetting{
+		AppID:       strings.TrimSpace(os.Getenv("FEISHU_FINANCE_AGENT_APP_ID")),
+		AppSecret:   strings.TrimSpace(os.Getenv("FEISHU_FINANCE_AGENT_APP_SECRET")),
+		OpenAPIBase: strings.TrimRight(strings.TrimSpace(os.Getenv("FEISHU_FINANCE_AGENT_OPENAPI_BASE")), "/"),
+		LLMBaseURL:  strings.TrimRight(strings.TrimSpace(os.Getenv("FEISHU_FINANCE_AGENT_LLM_BASE_URL")), "/"),
+		LLMAPIKey:   strings.TrimSpace(os.Getenv("FEISHU_FINANCE_AGENT_LLM_API_KEY")),
+		LLMModel:    strings.TrimSpace(os.Getenv("FEISHU_FINANCE_AGENT_LLM_MODEL")),
+	}
+	cachedFeishuFinanceAgentSetting.Store(&s)
+	return s
+}
+
+// SetFeishuFinanceAgentSettingForTest 仅供测试注入配置快照，返回 restore 闭包。
+func SetFeishuFinanceAgentSettingForTest(s FeishuFinanceAgentSetting) (restore func()) {
+	prev := cachedFeishuFinanceAgentSetting.Load()
+	cachedFeishuFinanceAgentSetting.Store(&s)
+	return func() { cachedFeishuFinanceAgentSetting.Store(prev) }
+}
