+	require.NoError(t, err)
+	doneCard := resp["card"].(map[string]any)["data"].(map[string]any)
+	var doneTexts []string
+	for _, e := range doneCard["elements"].([]map[string]any) {
+		if e["tag"] == "div" {
+			doneTexts = append(doneTexts, e["text"].(map[string]any)["content"].(string))
+		}
+	}
+	require.Contains(t, joinStrings(doneTexts), "提示注入")
+}
+
+func joinStrings(parts []string) string {
+	out := ""
+	for _, p := range parts {
+		out += p + "\n"
+	}
+	return out
+}
