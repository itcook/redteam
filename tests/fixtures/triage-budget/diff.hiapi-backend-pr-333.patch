+			texts = append(texts, e["text"].(map[string]any)["content"].(string))
+		}
+	}
+	require.Contains(t, joinStrings(texts), "提示注入")
+
+	// 执行完成后，结果卡片仍保留注入警示（不能只在确认卡上提示）。
+	action := feishuActionByMessage(t, "om_inject")
