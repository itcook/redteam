+
+func ptr[T any](v T) *T { return &v }
+
+// buildLarkMessageEvent 构造飞书 SDK 的真实事件结构，验证转换层而不是只测内部信封。
+func buildLarkMessageEvent(messageID, openID, chatType, text string) *larkim.P2MessageReceiveV1 {
+	content, _ := common.Marshal(map[string]string{"text": "@_user_1 " + text})
+	return &larkim.P2MessageReceiveV1{Event: &larkim.P2MessageReceiveV1Data{
+		Sender: &larkim.EventSender{
+			SenderType: ptr("user"),
+			SenderId:   &larkim.UserId{OpenId: ptr(openID)},
+		},
+		Message: &larkim.EventMessage{
+			MessageId:   ptr(messageID),
+			ChatId:      ptr("oc_ws"),
+			ChatType:    ptr(chatType),
+			MessageType: ptr("text"),
+			Content:     ptr(string(content)),
+			Mentions: []*larkim.MentionEvent{{
+				Id:            &larkim.UserId{OpenId: ptr(feishuTestBotOpenID)},
+				MentionedType: ptr("bot"),
+			}},
+		},
+	}}
+}
+
+func TestFeishuFinanceAgentWSMessageConversionAndProcessing(t *testing.T) {
+	fx := setupFeishuFinanceAgentTest(t, feishuFullCommand())
+	event := buildLarkMessageEvent("om_ws_1", feishuTestOperatorOpenID, "group",
+		"target@example.com 送 10w 积分，10%分佣")
+
+	env := feishuFinanceAgentEnvelopeFromMessage(event)
+	require.Equal(t, "im.message.receive_v1", env.Header.EventType)
+	require.Equal(t, feishuTestOperatorOpenID, env.Event.Sender.SenderID.OpenID)
+	require.Equal(t, "bot", env.Event.Message.Mentions[0].MentionedType)
+
+	// 走一次完整事件流程：转换 → 鉴权 → 落库 → 出确认卡片。
+	require.NoError(t, processFeishuFinanceAgentMessage(context.Background(), env))
+	require.Len(t, fx.messenger.cards, 1)
+	require.Equal(t, model.FeishuFinanceAgentActionPending, feishuActionByMessage(t, "om_ws_1").Status)
+}
+
+func TestFeishuFinanceAgentWSCardTriggerConversion(t *testing.T) {
+	fx := setupFeishuFinanceAgentTest(t, feishuFullCommand())
+	require.NoError(t, processFeishuFinanceAgentMessage(context.Background(),
+		feishuTestEvent("om_ws_2", feishuTestOperatorOpenID, "p2p", "target@example.com 送 10w 积分", false)))
+	action := feishuActionByMessage(t, "om_ws_2")
+
+	event := &callback.CardActionTriggerEvent{Event: &callback.CardActionTriggerRequest{
+		Operator: &callback.Operator{OpenID: feishuTestOperatorOpenID},
+		Action: &callback.CallBackAction{Value: map[string]interface{}{
+			"action_id": action.Id, "decision": "confirm",
+		}},
+		Context: &callback.Context{OpenMessageID: "om_card"},
+	}}
+	resp, err := handleFeishuFinanceAgentCardTrigger(event)
+	require.NoError(t, err)
+	require.NotNil(t, resp.Toast)
+	require.Equal(t, "success", resp.Toast.Type)
+	require.NotNil(t, resp.Card)
+	require.Equal(t, "raw", resp.Card.Type)
+	require.Equal(t, model.FeishuFinanceAgentActionExecuted, feishuActionByMessage(t, "om_ws_2").Status)
+	require.NotNil(t, fx)
+}
