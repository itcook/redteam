+func feishuTestEvent(messageID, openID, chatType, text string, mentionBot bool) *feishuFinanceAgentEventEnvelope {
+	env := &feishuFinanceAgentEventEnvelope{}
+	env.Header.EventType = "im.message.receive_v1"
+	env.Event.Sender.SenderType = "user"
+	env.Event.Sender.SenderID.OpenID = openID
+	env.Event.Message.MessageID = messageID
+	env.Event.Message.ChatID = "oc_chat"
+	env.Event.Message.ChatType = chatType
+	env.Event.Message.MessageType = "text"
+	content, _ := common.Marshal(map[string]string{"text": "@_user_1 " + text})
+	env.Event.Message.Content = string(content)
+	if mentionBot {
+		env.Event.Message.Mentions = append(env.Event.Message.Mentions, feishuFinanceAgentMention{
+			MentionedType: "bot",
+		})
+		env.Event.Message.Mentions[0].ID.OpenID = feishuTestBotOpenID
+	}
+	return env
+}
