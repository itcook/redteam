+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/setting"
+	"github.com/bytedance/gopkg/util/gopool"
+	larkcore "github.com/larksuite/oapi-sdk-go/v3/core"
+	"github.com/larksuite/oapi-sdk-go/v3/event/dispatcher"
+	"github.com/larksuite/oapi-sdk-go/v3/event/dispatcher/callback"
+	larkim "github.com/larksuite/oapi-sdk-go/v3/service/im/v1"
+	larkws "github.com/larksuite/oapi-sdk-go/v3/ws"
+)
+
+// feishu_finance_agent_ws.go —— 后端直连飞书长连接（官方 SDK）。
+//
+// 事件与卡片回调都由本进程主动连出 open.feishu.cn 接收，不需要公网回调地址，
+// 也不需要中间的 worker / HMAC 转发。未配置 App ID/Secret 时不启动，对其它环境零影响。
+//
+// 可靠性约定：
+//   - 消息事件在回调里先完成鉴权与落库（accept），再异步解析，保证「先落库再 ack」；
+//   - 卡片回调在同一进程内处理，执行超过飞书时限先回「执行中」，完成后补更新卡片；
+//   - 崩溃遗留的 parsing/executing 记录与未更新的结果卡片由维护循环周期收敛。
+
+var feishuFinanceAgentWSOnce sync.Once
+
+// StartFeishuFinanceAgentWS 在 main 里调用；多次调用只启动一次。
+func StartFeishuFinanceAgentWS() {
+	cfg := setting.GetFeishuFinanceAgentSetting()
+	if cfg.AppID == "" || cfg.AppSecret == "" {
+		common.SysLog("[feishu-finance-agent] disabled: FEISHU_FINANCE_AGENT_APP_ID / APP_SECRET not set")
+		return
+	}
+	feishuFinanceAgentWSOnce.Do(func() {
+		gopool.Go(func() { runFeishuFinanceAgentWS(cfg) })
+		gopool.Go(feishuFinanceAgentMaintenanceLoop)
+	})
+}
+
+// runFeishuFinanceAgentWS 外层重试环包住「构造 + 连接」全过程：构造期 panic 也会重启，
+// 而不是让监听器在 sync.Once 之后永久静默。
+func runFeishuFinanceAgentWS(cfg setting.FeishuFinanceAgentSetting) {
+	for {
+		err := runFeishuFinanceAgentWSSession(cfg)
+		if err == nil || errors.Is(err, context.Canceled) {
+			common.SysError("[feishu-finance-agent] websocket stopped, restarting in 5s")
+		} else {
+			common.SysError("[feishu-finance-agent] websocket stopped: " + err.Error() + ", restarting in 5s")
+		}
+		time.Sleep(5 * time.Second)
+	}
+}
+
+func runFeishuFinanceAgentWSSession(cfg setting.FeishuFinanceAgentSetting) (err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("websocket panic: %v", r)
+		}
+	}()
+
+	d := dispatcher.NewEventDispatcher("", "")
+	d.OnP2MessageReceiveV1(func(ctx context.Context, e *larkim.P2MessageReceiveV1) error {
+		// 落库失败要返回错误，让飞书重投；其它情况已自行回复，正常 ack。
+		return handleFeishuFinanceAgentMessageEvent(ctx, e)
+	})
+	d.OnP2CardActionTrigger(func(ctx context.Context, e *callback.CardActionTriggerEvent) (resp *callback.CardActionTriggerResponse, err error) {
+		defer func() {
+			if r := recover(); r != nil {
+				common.SysError(fmt.Sprintf("[feishu-finance-agent] card handler panic: %v", r))
+				resp, err = &callback.CardActionTriggerResponse{
+					Toast: &callback.Toast{Type: "error", Content: "处理失败，请稍后再试"},
+				}, nil
+			}
+		}()
+		return handleFeishuFinanceAgentCardTrigger(e)
+	})
+
+	opts := []larkws.ClientOption{
+		larkws.WithEventHandler(d),
+		larkws.WithLogLevel(larkcore.LogLevelInfo),
+		larkws.WithAutoReconnect(true),
+		larkws.WithOnReady(func() {
+			common.SysLog("[feishu-finance-agent] websocket connected to open.feishu.cn")
+		}),
+		larkws.WithOnError(func(err error) {
+			common.SysError("[feishu-finance-agent] websocket error: " + err.Error())
+		}),
+		larkws.WithOnReconnecting(func() {
+			common.SysLog("[feishu-finance-agent] websocket reconnecting")
+		}),
+		larkws.WithOnReconnected(func() {
+			common.SysLog("[feishu-finance-agent] websocket reconnected")
+		}),
+	}
+	if domain := feishuFinanceAgentWSDomain(cfg.OpenAPIBase); domain != "" {
+		opts = append(opts, larkws.WithDomain(domain))
+	}
+
+	client := larkws.NewClient(cfg.AppID, cfg.AppSecret, opts...)
+	return client.Start(context.Background())
+}
+
+// feishuFinanceAgentWSDomain 把 OpenAPI base（…/open-apis）还原成长连接使用的域名；
+// 默认（未配置）由 SDK 使用 https://open.feishu.cn。
+func feishuFinanceAgentWSDomain(openAPIBase string) string {
+	base := strings.TrimSpace(openAPIBase)
+	if base == "" {
+		return ""
+	}
+	base = strings.TrimSuffix(base, "/")
+	base = strings.TrimSuffix(base, "/open-apis")
+	return base
+}
+
+// ---------------------------------------------------------------------------
+// SDK 事件 → 内部信封
+// ---------------------------------------------------------------------------
+
+func feishuFinanceAgentEnvelopeFromMessage(e *larkim.P2MessageReceiveV1) *feishuFinanceAgentEventEnvelope {
+	env := &feishuFinanceAgentEventEnvelope{}
+	env.Header.EventType = "im.message.receive_v1"
+	if e == nil || e.Event == nil {
+		return env
+	}
+	if s := e.Event.Sender; s != nil {
+		env.Event.Sender.SenderType = larkcore.StringValue(s.SenderType)
+		if s.SenderId != nil {
+			env.Event.Sender.SenderID.OpenID = larkcore.StringValue(s.SenderId.OpenId)
+		}
+	}
+	if m := e.Event.Message; m != nil {
+		env.Event.Message.MessageID = larkcore.StringValue(m.MessageId)
+		env.Event.Message.ChatID = larkcore.StringValue(m.ChatId)
+		env.Event.Message.ChatType = larkcore.StringValue(m.ChatType)
+		env.Event.Message.MessageType = larkcore.StringValue(m.MessageType)
+		env.Event.Message.Content = larkcore.StringValue(m.Content)
+		for _, mention := range m.Mentions {
+			if mention == nil {
+				continue
+			}
+			item := feishuFinanceAgentMention{MentionedType: larkcore.StringValue(mention.MentionedType)}
+			if mention.Id != nil {
+				item.ID.OpenID = larkcore.StringValue(mention.Id.OpenId)
+			}
+			env.Event.Message.Mentions = append(env.Event.Message.Mentions, item)
+		}
+	}
+	return env
+}
+
+func feishuFinanceAgentCardEnvelopeFromEvent(e *callback.CardActionTriggerEvent) *feishuFinanceAgentCardEnvelope {
+	env := &feishuFinanceAgentCardEnvelope{}
+	if e == nil || e.Event == nil {
+		return env
+	}
+	if op := e.Event.Operator; op != nil {
+		env.Event.Operator.OpenID = op.OpenID
+	}
+	if action := e.Event.Action; action != nil {
+		env.Event.Action.Value = action.Value
+	}
+	if c := e.Event.Context; c != nil {
+		env.Event.Context.OpenMessageID = c.OpenMessageID
+	}
+	return env
+}
+
+func feishuFinanceAgentCardTriggerResponse(resp map[string]any) *callback.CardActionTriggerResponse {
+	out := &callback.CardActionTriggerResponse{}
+	if t, ok := resp["toast"].(map[string]any); ok {
+		toastType, _ := t["type"].(string)
+		toastContent, _ := t["content"].(string)
+		out.Toast = &callback.Toast{Type: toastType, Content: toastContent}
+	}
+	if c, ok := resp["card"].(map[string]any); ok {
+		cardType, _ := c["type"].(string)
+		out.Card = &callback.Card{Type: cardType, Data: c["data"]}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// 长连接回调
+// ---------------------------------------------------------------------------
+
+func handleFeishuFinanceAgentMessageEvent(ctx context.Context, e *larkim.P2MessageReceiveV1) error {
+	env := feishuFinanceAgentEnvelopeFromMessage(e)
+	action, operatorName, proceed, err := acceptFeishuFinanceAgentMessage(ctx, env)
+	if err != nil {
+		// 落库失败：返回错误让飞书重投（source_message_id 唯一索引保证重投安全）。
+		common.SysError("[feishu-finance-agent] accept message failed: " + err.Error())
+		return err
+	}
+	if !proceed {
+		return nil
+	}
+	// 记录已落库，异步做 LLM 解析/查库/发卡片；飞书这边立即 ack。
+	gopool.Go(func() {
+		rctx, cancel := context.WithTimeout(context.Background(), feishuFinanceAgentProcessTimeout)
+		defer cancel()
+		if err := runFeishuFinanceAgentAction(rctx, action, operatorName); err != nil {
+			common.SysError("[feishu-finance-agent] process message failed: " + err.Error())
+		}
+	})
+	return nil
+}
+
+func handleFeishuFinanceAgentCardTrigger(e *callback.CardActionTriggerEvent) (*callback.CardActionTriggerResponse, error) {
+	env := feishuFinanceAgentCardEnvelopeFromEvent(e)
+	body, err := common.Marshal(env)
+	if err != nil {
+		return &callback.CardActionTriggerResponse{
+			Toast: &callback.Toast{Type: "error", Content: "处理失败，请稍后再试"},
+		}, nil
+	}
+	resp, err := HandleFeishuFinanceAgentCard(body)
+	if err != nil {
+		common.SysError("[feishu-finance-agent] card callback failed: " + err.Error())
+		return &callback.CardActionTriggerResponse{
+			Toast: &callback.Toast{Type: "error", Content: "处理失败，请稍后再试"},
+		}, nil
+	}
+	return feishuFinanceAgentCardTriggerResponse(resp), nil
+}
