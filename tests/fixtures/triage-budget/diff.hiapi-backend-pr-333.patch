diff --git a/model/feishu_finance_agent.go b/model/feishu_finance_agent.go
new file mode 100644
index 000000000..8954ea0ba
--- /dev/null
+++ b/model/feishu_finance_agent.go
@@ -0,0 +1,308 @@
+package model
+
+import (
+	"errors"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// Feishu 推广助手：飞书里 @机器人 的自然语言指令 → 确认卡片 → 执行
+// 「加入推广用户 / 单独分佣 / 开启提现 / 赠送积分」。
+//
+// 本文件只落两张表：
+//   - operators：飞书 open_id → hiapi 现有 root 用户的白名单。执行时用该用户 id 做审计操作人，
+//     且每次确认都实时校验其角色仍 ≥ Root，不单独发放任何服务凭证。
+//   - actions：一条指令一行，既是待确认意图的服务端存储（卡片按钮只回传 id，参数不经客户端），
+//     也是审计日志；状态机只允许 pending → executing 被抢占一次，天然防重复点击。
+
+const (
+	FeishuFinanceAgentActionParsing   = "parsing"
+	FeishuFinanceAgentActionPending   = "pending"
+	FeishuFinanceAgentActionExecuting = "executing"
+	FeishuFinanceAgentActionExecuted  = "executed"
+	FeishuFinanceAgentActionPartial   = "partial"
+	FeishuFinanceAgentActionFailed    = "failed"
+	FeishuFinanceAgentActionCancelled = "cancelled"
+	FeishuFinanceAgentActionIgnored   = "ignored"
+)
+
+type FeishuFinanceAgentOperator struct {
+	OpenId      string `json:"open_id" gorm:"primaryKey;type:varchar(64)"`
+	HiapiUserId int    `json:"hiapi_user_id" gorm:"not null;index"`
+	Name        string `json:"name" gorm:"type:varchar(64);not null;default:''"`
+	Active      bool   `json:"active" gorm:"not null;default:true"`
+	CreatedAt   int64  `json:"created_at" gorm:"not null"`
+	UpdatedAt   int64  `json:"updated_at" gorm:"not null"`
+}
+
+func (FeishuFinanceAgentOperator) TableName() string { return "feishu_finance_agent_operators" }
+
+type FeishuFinanceAgentAction struct {
+	Id              string `json:"id" gorm:"primaryKey;type:varchar(32)"`
+	SourceMessageId string `json:"source_message_id" gorm:"type:varchar(64);not null;uniqueIndex"`
+	ChatId          string `json:"chat_id" gorm:"type:varchar(64);not null;default:''"`
+	CardMessageId   string `json:"card_message_id" gorm:"type:varchar(64);not null;default:''"`
+	OperatorOpenId  string `json:"operator_open_id" gorm:"type:varchar(64);not null;index"`
+	OperatorUserId  int    `json:"operator_user_id" gorm:"not null;default:0"`
+	TargetUserId    int    `json:"target_user_id" gorm:"not null;default:0;index"`
+	TargetAccount   string `json:"target_account" gorm:"type:varchar(255);not null;default:''"`
+	RawText         string `json:"raw_text" gorm:"type:text"`
+	PlanJson        string `json:"plan_json" gorm:"type:text"`
+	BeforeJson      string `json:"before_json" gorm:"type:text"`
+	ResultJson      string `json:"result_json" gorm:"type:text"`
+	Status          string `json:"status" gorm:"type:varchar(16);not null;index"`
+	// ExecVersion 是执行权代次（fencing token）：每次 claim 递增，终态写必须带当前代次，
+	// 防止挂起的旧执行在恢复重放之后覆盖新结果。
+	ExecVersion int `json:"exec_version" gorm:"not null;default:0"`
+	// CardPatched 标记结果卡片是否已成功更新；patch 失败的终态记录由周期任务重试。
+	CardPatched bool   `json:"card_patched" gorm:"not null;default:false"`
+	ConfirmedBy string `json:"confirmed_by" gorm:"type:varchar(64);not null;default:''"`
+	CreatedAt   int64  `json:"created_at" gorm:"not null;index"`
+	UpdatedAt   int64  `json:"updated_at" gorm:"not null"`
+	ExecutedAt  int64  `json:"executed_at" gorm:"not null;default:0"`
+}
