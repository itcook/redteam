+}
+
+type feishuFinanceAgentUserError struct{ msg string }
+
+func (e feishuFinanceAgentUserError) Error() string { return e.msg }
+
+func userErrorf(format string, args ...any) error {
+	return feishuFinanceAgentUserError{msg: fmt.Sprintf(format, args...)}
+}
+
+// buildFeishuFinanceAgentPlan 把 LLM 结构化输出转成可执行计划。所有数值边界、
+// 默认值都在这里确定性地决定，并写进 Defaults 让卡片明示「哪些是系统补的」。
+func buildFeishuFinanceAgentPlan(cmd *feishuFinanceAgentCommand, state *model.FeishuFinanceAgentTargetState) (*feishuFinanceAgentPlan, error) {
+	plan := &feishuFinanceAgentPlan{TargetUserID: state.UserID, AddPromotion: cmd.AddPromotion}
+	if cmd.CommissionWindowDays != nil && cmd.CommissionRatePercent == nil {
+		return nil, userErrorf("只给了返佣有效期，没给分佣比例，请补充比例（例如 10%%）")
+	}
+	if cmd.CommissionRatePercent != nil {
+		pct := *cmd.CommissionRatePercent
+		bps := int(math.Round(pct * 100))
+		if math.IsNaN(pct) || bps <= 0 || bps > feishuFinanceAgentMaxRateBps {
+			return nil, userErrorf("分佣比例必须在 0%% 到 50%% 之间，解析到的是 %s%%", strconv.FormatFloat(pct, 'f', -1, 64))
+		}
+		days := feishuFinanceAgentDefaultWindow
+		if cmd.CommissionWindowDays != nil {
+			days = *cmd.CommissionWindowDays
+		} else {
+			plan.Defaults = append(plan.Defaults, fmt.Sprintf("返佣有效期未指定，默认 %d 天", feishuFinanceAgentDefaultWindow))
+		}
+		if days < 1 || days > 365 {
+			return nil, userErrorf("返佣有效期必须在 1 到 365 天之间，解析到的是 %d 天", days)
+		}
+		plan.CommissionRateBps = &bps
+		plan.CommissionWindow = &days
+		plan.AddPromotion = true
+	}
+	if cmd.WithdrawEnabled != nil {
+		v := *cmd.WithdrawEnabled
+		plan.WithdrawEnabled = &v
+		plan.AddPromotion = true
+	}
+	if plan.AddPromotion && plan.WithdrawEnabled == nil && !state.PromotionActive {
+		v := true
+		plan.WithdrawEnabled = &v
+		plan.Defaults = append(plan.Defaults, "新加入推广用户，提现默认开启")
+	}
+	if cmd.GiftCredits != nil {
+		credits := *cmd.GiftCredits
+		if credits <= 0 || credits > feishuFinanceAgentMaxGiftCredits {
+			return nil, userErrorf("单次赠送积分必须在 1 到 %s 之间，解析到的是 %s",
+				formatFeishuCredits(feishuFinanceAgentMaxGiftCredits), formatFeishuCredits(credits))
+		}
+		plan.GiftCredits = credits
+	}
+	if !plan.AddPromotion && plan.GiftCredits == 0 {
+		return nil, userErrorf("没识别到要做的操作。可以说：加入推广、x%% 分佣、N 天有效期、开启提现、送 N 积分")
+	}
+
+	if state.Status != common.UserStatusEnabled {
+		plan.Warnings = append(plan.Warnings, "目标账号当前不是启用状态")
+	}
+	if state.Role >= common.RoleAdminUser {
+		plan.Warnings = append(plan.Warnings, "目标账号是管理员/Root 账号")
+	}
+	if plan.CommissionRateBps != nil && !state.GlobalCommission {
+		plan.Warnings = append(plan.Warnings, "全局返佣总开关关闭，单独分佣暂不会产生返佣")
+	} else if plan.CommissionRateBps != nil && !state.GlobalWindowOn {
+		plan.Warnings = append(plan.Warnings, "全局「限制返佣有效期」未开启，单独分佣规则暂不生效")
+	}
+	if plan.WithdrawEnabled != nil && *plan.WithdrawEnabled && !state.GlobalWithdrawOn {
+		plan.Warnings = append(plan.Warnings, "全局提现开关关闭，用户侧开启后仍无法提现")
+	}
+	return plan, nil
+}
+
+func feishuFinanceAgentTargetMentioned(rawText, account string) bool {
+	account = strings.TrimSpace(account)
+	return account != "" && strings.Contains(strings.ToLower(rawText), strings.ToLower(account))
+}
+
+// ---------------------------------------------------------------------------
+// 鉴权：白名单 + 实时 Root
+// ---------------------------------------------------------------------------
+
+func authorizeFeishuFinanceAgentOperator(openID string) (*model.FeishuFinanceAgentOperator, *model.User, error) {
+	operator, err := model.GetActiveFeishuFinanceAgentOperator(openID)
+	if err != nil || operator == nil {
+		return nil, nil, err
+	}
+	user, err := model.GetUserById(operator.HiapiUserId, false)
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil, nil
+		}
+		// DB 故障不能伪装成「无权限」，否则排查时看不到真正原因。
+		return nil, nil, err
+	}
+	if user.Role < common.RoleRootUser || user.Status != common.UserStatusEnabled {
+		return nil, nil, nil
+	}
+	return operator, user, nil
+}
+
+// ---------------------------------------------------------------------------
+// 事件处理
+// ---------------------------------------------------------------------------
+
+// acceptFeishuFinanceAgentMessage 在飞书事件回调里同步执行：鉴权、去重落库、必要的短回复。
+// 先落库再 ack，后端重启时没处理完的消息飞书会重推，靠 source_message_id 去重。
+// 返回 proceed=false 表示这条消息不需要继续处理。
+func acceptFeishuFinanceAgentMessage(ctx context.Context, env *feishuFinanceAgentEventEnvelope) (action *model.FeishuFinanceAgentAction, operatorName string, proceed bool, err error) {
+	msg := env.Event.Message
+	openID := env.Event.Sender.SenderID.OpenID
+	if env.Event.Sender.SenderType != "user" || msg.MessageID == "" || openID == "" {
+		return nil, "", false, nil
+	}
+	cfg := setting.GetFeishuFinanceAgentSetting()
+	messenger := newFeishuFinanceAgentMessenger(cfg)
+	isGroup := msg.ChatType != "p2p"
+	if isGroup {
+		// 权限只申请了 im:message.group_at_msg:readonly，飞书本就只推 @ 机器人的群消息；
+		// 这里再确认一次被 @ 的是机器人（同一条消息可能 @ 多人）。
+		mentioned := false
+		for _, m := range msg.Mentions {
+			if m.MentionedType == "bot" || (m.MentionedType == "" && m.ID.OpenID != "") {
+				mentioned = true
+				break
+			}
+		}
+		if !mentioned {
+			return nil, "", false, nil
+		}
+	}
+
+	operator, operatorUser, err := authorizeFeishuFinanceAgentOperator(openID)
+	if err != nil {
+		return nil, "", false, err
+	}
+	if operator == nil {
+		common.SysLog("[feishu-finance-agent] ignored message from non-operator open_id=" + openID)
+		if !isGroup {
+			// 私聊给出 open_id，方便 Root 把自己加入白名单；群里保持静默，不给探测入口。
+			return nil, "", false, messenger.ReplyText(ctx, msg.MessageID,
+				"你还没有使用推广助手的权限。请 Root 管理员把你的飞书 open_id 加入白名单：\n"+openID)
+		}
+		return nil, "", false, nil
+	}
+
+	if msg.MessageType != "text" {
+		return nil, "", false, messenger.ReplyText(ctx, msg.MessageID, "目前只支持文字指令。发送「帮助」查看用法。")
+	}
+	var content struct {
+		Text string `json:"text"`
+	}
+	_ = common.UnmarshalJsonStr(msg.Content, &content)
+	text := strings.TrimSpace(feishuMentionPlaceholder.ReplaceAllString(content.Text, ""))
+	if text == "" || text == "帮助" || strings.EqualFold(text, "help") {
+		return nil, "", false, messenger.ReplyText(ctx, msg.MessageID, feishuFinanceAgentHelpText)
+	}
+	if len([]rune(text)) > feishuFinanceAgentMaxTextRunes {
+		return nil, "", false, messenger.ReplyText(ctx, msg.MessageID, "指令太长了，请一次只处理一个用户，用一句话说清楚。")
+	}
+
+	action = &model.FeishuFinanceAgentAction{
+		Id:              common.GetUUID(),
+		SourceMessageId: msg.MessageID,
+		ChatId:          msg.ChatID,
+		OperatorOpenId:  openID,
+		OperatorUserId:  operatorUser.Id,
+		RawText:         text,
+		Status:          model.FeishuFinanceAgentActionParsing,
+	}
+	created, err := model.CreateFeishuFinanceAgentActionOnce(action)
+	if err != nil {
+		return nil, "", false, err
+	}
+	if !created {
+		return nil, "", false, nil // 飞书重投同一条消息
+	}
+	return action, operator.Name, true, nil
+}
+
+// runFeishuFinanceAgentAction 是耗时的下半段：LLM 解析 → 查目标现状 → 出确认卡片。
+func runFeishuFinanceAgentAction(ctx context.Context, action *model.FeishuFinanceAgentAction, operatorName string) error {
+	messenger := newFeishuFinanceAgentMessenger(setting.GetFeishuFinanceAgentSetting())
+	text := action.RawText
+
+	ignore := func(reply string) error {
+		_ = model.UpdateFeishuFinanceAgentAction(action.Id, map[string]any{
+			"status": model.FeishuFinanceAgentActionIgnored, "result_json": reply,
+		})
+		return messenger.ReplyText(ctx, action.SourceMessageId, reply)
+	}
+
+	cmd, err := parseFeishuFinanceAgentCommand(ctx, text)
+	if err != nil {
+		common.SysError("[feishu-finance-agent] parse command failed: " + err.Error())
+		return ignore("指令解析失败，请重新发送指令。")
+	}
+	switch cmd.Intent {
+	case "help":
+		_ = model.UpdateFeishuFinanceAgentAction(action.Id, map[string]any{"status": model.FeishuFinanceAgentActionIgnored})
+		return messenger.ReplyText(ctx, action.SourceMessageId, feishuFinanceAgentHelpText)
+	case "execute":
+	default:
+		question := strings.TrimSpace(cmd.Question)
+		if question == "" {
+			question = "没看懂这条指令，请说明用户账号和要做的操作。"
+		}
+		return ignore(question)
+	}
+	if !feishuFinanceAgentTargetMentioned(text, cmd.TargetAccount) {
+		return ignore("没在指令里找到明确的用户账号（邮箱 / 用户名 / 用户 ID），请补充。")
+	}
+	targetID, err := model.ResolveFeishuFinanceAgentTarget(strings.TrimSpace(cmd.TargetAccount))
+	switch {
+	case errors.Is(err, model.ErrAffAgentAccountNotFound), errors.Is(err, model.ErrAffAgentNotFound):
+		return ignore("找不到用户：" + cmd.TargetAccount)
+	case errors.Is(err, model.ErrAffAgentAccountAmbiguous):
+		return ignore("「" + cmd.TargetAccount + "」匹配到多个用户，请改用邮箱或用户 ID。")
+	case err != nil:
+		return err
+	}
+	state, err := model.GetFeishuFinanceAgentTargetState(targetID)
+	if err != nil {
+		return err
+	}
+	plan, err := buildFeishuFinanceAgentPlan(cmd, state)
+	var userErr feishuFinanceAgentUserError
+	if errors.As(err, &userErr) {
+		return ignore(userErr.msg)
+	}
+	if err != nil {
+		return err
+	}
+	if warning := feishuFinanceAgentInjectionWarningText(text); warning != "" {
+		plan.Warnings = append(plan.Warnings, warning)
+	}
+	planJSON, err := common.Marshal(plan)
+	if err != nil {
+		return err
+	}
+	beforeJSON, err := common.Marshal(state)
+	if err != nil {
+		return err
+	}
+	if err := model.UpdateFeishuFinanceAgentAction(action.Id, map[string]any{
+		"status":         model.FeishuFinanceAgentActionPending,
+		"target_user_id": targetID,
+		"target_account": strings.TrimSpace(cmd.TargetAccount),
+		"plan_json":      string(planJSON),
+		"before_json":    string(beforeJSON),
+	}); err != nil {
+		return err
+	}
+	cardMessageID, err := messenger.ReplyCard(ctx, action.SourceMessageId,
+		feishuFinanceAgentConfirmCard(action.Id, operatorName, text, state, plan))
+	if err != nil {
+		_ = model.UpdateFeishuFinanceAgentAction(action.Id, map[string]any{
+			"status": model.FeishuFinanceAgentActionFailed, "result_json": "send card failed: " + err.Error(),
+		})
+		return err
+	}
+	return model.UpdateFeishuFinanceAgentAction(action.Id, map[string]any{"card_message_id": cardMessageID})
+}
+
+// processFeishuFinanceAgentMessage 同步跑完接受 + 处理（测试与本地调试用）。
+func processFeishuFinanceAgentMessage(ctx context.Context, env *feishuFinanceAgentEventEnvelope) error {
+	action, operatorName, proceed, err := acceptFeishuFinanceAgentMessage(ctx, env)
+	if err != nil || !proceed {
+		return err
+	}
+	return runFeishuFinanceAgentAction(ctx, action, operatorName)
+}
+
+// ---------------------------------------------------------------------------
+// 卡片回调
+// ---------------------------------------------------------------------------
+
+func feishuToast(kind, content string) map[string]any {
+	return map[string]any{"toast": map[string]any{"type": kind, "content": content}}
+}
+
+// HandleFeishuFinanceAgentCard 返回值经长连接原样回给飞书（toast + 可选新卡片）。
+func HandleFeishuFinanceAgentCard(body []byte) (map[string]any, error) {
+	var env feishuFinanceAgentCardEnvelope
+	if err := common.Unmarshal(body, &env); err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrFeishuFinanceAgentBadCallback, err)
+	}
+	actionID, _ := env.Event.Action.Value["action_id"].(string)
+	decision, _ := env.Event.Action.Value["decision"].(string)
+	openID := env.Event.Operator.OpenID
+	if actionID == "" || openID == "" {
+		return map[string]any{}, nil
+	}
+	action, err := model.GetFeishuFinanceAgentAction(actionID)
+	if errors.Is(err, model.ErrFeishuFinanceAgentActionNotFound) {
+		return feishuToast("error", "找不到这条指令"), nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if action.CardMessageId != "" && env.Event.Context.OpenMessageID != "" &&
+		action.CardMessageId != env.Event.Context.OpenMessageID {
+		return feishuToast("error", "卡片与指令不匹配"), nil
+	}
+	if action.OperatorOpenId != openID {
+		return feishuToast("warning", "只有发起这条指令的人可以确认"), nil
+	}
+	operator, operatorUser, err := authorizeFeishuFinanceAgentOperator(openID)
+	if err != nil {
+		return nil, err
+	}
+	if operator == nil {
+		return feishuToast("error", "你当前没有执行权限（需要白名单 + Root 角色）"), nil
+	}
+	if action.Status != model.FeishuFinanceAgentActionPending {
+		return feishuFinanceAgentSettledResponse(action)
+	}
+
+	var plan feishuFinanceAgentPlan
+	var before model.FeishuFinanceAgentTargetState
+	if err := common.UnmarshalJsonStr(action.PlanJson, &plan); err != nil {
+		return nil, err
+	}
+	if err := common.UnmarshalJsonStr(action.BeforeJson, &before); err != nil {
+		return nil, err
+	}
+
+	if decision == "cancel" {
+		won, err := model.TransitionFeishuFinanceAgentAction(action.Id, model.FeishuFinanceAgentActionPending,
+			model.FeishuFinanceAgentActionCancelled, map[string]any{"confirmed_by": openID})
+		if err != nil {
+			return nil, err
+		}
+		if !won {
+			return feishuToast("info", "这条指令已处理过"), nil
+		}
+		resp := feishuToast("info", "已取消")
+		resp["card"] = map[string]any{"type": "raw", "data": feishuFinanceAgentClosedCard(action, &before, "已取消", "grey")}
+		return resp, nil
+	}
+	if decision != "confirm" {
+		return map[string]any{}, nil
+	}
+	if time.Since(time.Unix(action.CreatedAt, 0)) > feishuFinanceAgentActionTTL {
+		_, _ = model.TransitionFeishuFinanceAgentAction(action.Id, model.FeishuFinanceAgentActionPending,
+			model.FeishuFinanceAgentActionCancelled, map[string]any{"result_json": "expired"})
+		resp := feishuToast("warning", "卡片已超过 30 分钟，请重新发指令")
+		resp["card"] = map[string]any{"type": "raw", "data": feishuFinanceAgentClosedCard(action, &before, "已过期", "grey")}
+		return resp, nil
+	}
+
+	execVersion, won, err := model.ClaimFeishuFinanceAgentAction(action.Id,
+		model.FeishuFinanceAgentActionPending, model.FeishuFinanceAgentActionExecuting, 0,
+		map[string]any{"confirmed_by": openID})
+	if err != nil {
+		return nil, err
+	}
+	if !won {
+		// 并发点按：这条已经被别人（或同一人的另一次点击）抢到执行权，回最新状态。
+		return feishuFinanceAgentSettledResponse(action)
+	}
+
+	// 飞书要求 3 秒内返回。执行通常几毫秒，超时则先回「执行中」，完成后补更新卡片，
+	// 用户再次点击也能看到最终结果（见 feishuFinanceAgentSettledResponse）。
+	done := make(chan map[string]any, 1)
+	go func() { done <- runFeishuFinanceAgentExecution(action, &plan, &before, operatorUser.Id, execVersion) }()
+	select {
+	case resp := <-done:
+		// 只有终态写成功（resp 带结果卡片）才标记；终态写失败时行仍是 executing，
+		// 留给恢复重放，避免提前标记导致补卡 sweeper 不再重试。
+		if _, hasCard := resp["card"].(map[string]any); hasCard {
+			if err := model.MarkFeishuFinanceAgentCardPatched(action.Id); err != nil {
+				common.SysLog("[feishu-finance-agent] mark card patched failed for action " + action.Id + ": " + err.Error())
+			}
+		}
+		return resp, nil
+	case <-time.After(feishuFinanceAgentCallbackBudget):
+		go func() {
+			resp := <-done
+			feishuFinanceAgentPatchDoneCard(action, resp)
+		}()
+		return feishuToast("info", "已开始执行，完成后卡片会自动更新"), nil
+	}
+}
+
+// runFeishuFinanceAgentExecution 执行计划并按 fencing 版本写终态；只被 confirm 与恢复重放调用。
+// execVersion 是 claim 时拿到的执行权代次，被恢复重放抢先后本函数的终态写会被拒绝。
+func runFeishuFinanceAgentExecution(action *model.FeishuFinanceAgentAction, plan *feishuFinanceAgentPlan,
+	before *model.FeishuFinanceAgentTargetState, operatorUserID, execVersion int) map[string]any {
+	steps := executeFeishuFinanceAgentPlan(action.Id, plan, before, operatorUserID)
+	status := model.FeishuFinanceAgentActionExecuted
+	failed := 0
+	for _, s := range steps {
+		if !s.OK {
+			failed++
+		}
+	}
+	if failed == len(steps) {
+		status = model.FeishuFinanceAgentActionFailed
+	} else if failed > 0 {
+		status = model.FeishuFinanceAgentActionPartial
+	}
+	resultJSON, _ := common.Marshal(steps)
+	won, err := model.TransitionFeishuFinanceAgentActionVersioned(action.Id,
+		model.FeishuFinanceAgentActionExecuting, execVersion, status,
+		map[string]any{"result_json": string(resultJSON), "executed_at": common.GetTimestamp()})
+	if err != nil {
+		common.SysError("[feishu-finance-agent] persist result failed for action " + action.Id + ": " + err.Error())
+		return feishuToast("warning", "结果保存失败，系统会自动重试")
+	}
+	if !won {
+		// 执行权已被恢复重放接管（或另一实例胜出）：丢弃本次结果，返回数据库中的真实状态。
+		common.SysLog("[feishu-finance-agent] execution superseded for action " + action.Id)
+		if settled, sErr := feishuFinanceAgentSettledResponse(action); sErr == nil {
+			return settled
+		}
+		return feishuToast("info", "执行结果已由其它实例记录")
+	}
+	after, err := model.GetFeishuFinanceAgentTargetState(plan.TargetUserID)
+	if err != nil {
+		after = nil
+	}
+	toastKind, toastText := "success", "已执行"
+	if status == model.FeishuFinanceAgentActionPartial {
+		toastKind, toastText = "warning", "部分执行失败，请看卡片"
+	} else if status == model.FeishuFinanceAgentActionFailed {
+		toastKind, toastText = "error", "执行失败，请看卡片"
+	}
+	resp := feishuToast(toastKind, toastText)
+	resp["card"] = map[string]any{"type": "raw", "data": feishuFinanceAgentDoneCard(action, before, after, steps, status)}
+	return resp
+}
+
+// feishuFinanceAgentPatchDoneCard 把结果卡片写回原消息；失败时留给周期任务重试。
+func feishuFinanceAgentPatchDoneCard(action *model.FeishuFinanceAgentAction, resp map[string]any) {
+	card, _ := resp["card"].(map[string]any)
+	data, _ := card["data"].(map[string]any)
+	if action.CardMessageId == "" || data == nil {
+		_ = model.MarkFeishuFinanceAgentCardPatched(action.Id)
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	if err := newFeishuFinanceAgentMessenger(setting.GetFeishuFinanceAgentSetting()).
+		PatchCard(ctx, action.CardMessageId, data); err != nil {
+		common.SysError("[feishu-finance-agent] patch done card failed for action " + action.Id + ": " + err.Error())
+		return
+	}
+	if err := model.MarkFeishuFinanceAgentCardPatched(action.Id); err != nil {
+		common.SysLog("[feishu-finance-agent] mark card patched failed for action " + action.Id + ": " + err.Error())
+	}
+}
+
+// feishuFinanceAgentSettledResponse 用在「已不是 pending」的点击上：返回当前真实结果，
+// 而不是只弹一句「已处理过」。这样回调超时后用户再点一次，就能看到最终结果。
+func feishuFinanceAgentSettledResponse(action *model.FeishuFinanceAgentAction) (map[string]any, error) {
+	latest, err := model.GetFeishuFinanceAgentAction(action.Id)
+	if err != nil {
+		return nil, err
+	}
+	var before model.FeishuFinanceAgentTargetState
+	_ = common.UnmarshalJsonStr(latest.BeforeJson, &before)
+	switch latest.Status {
+	case model.FeishuFinanceAgentActionExecuted, model.FeishuFinanceAgentActionPartial, model.FeishuFinanceAgentActionFailed:
+		var steps []feishuFinanceAgentStep
+		_ = common.UnmarshalJsonStr(latest.ResultJson, &steps)
+		after, afterErr := model.GetFeishuFinanceAgentTargetState(latest.TargetUserId)
+		if afterErr != nil {
+			after = nil
+		}
+		toastKind, toastText := "success", "已执行"
+		if latest.Status == model.FeishuFinanceAgentActionPartial {
+			toastKind, toastText = "warning", "部分执行失败，请看卡片"
+		} else if latest.Status == model.FeishuFinanceAgentActionFailed {
+			toastKind, toastText = "error", "执行失败，请看卡片"
+		}
+		resp := feishuToast(toastKind, toastText)
+		resp["card"] = map[string]any{"type": "raw",
+			"data": feishuFinanceAgentDoneCard(latest, &before, after, steps, latest.Status)}
+		return resp, nil
+	case model.FeishuFinanceAgentActionCancelled:
+		resp := feishuToast("info", "已取消")
+		if latest.ResultJson == "expired" {
+			resp = feishuToast("warning", "卡片已超过 30 分钟，已失效")
+		}
+		resp["card"] = map[string]any{"type": "raw",
+			"data": feishuFinanceAgentClosedCard(latest, &before, feishuFinanceAgentStatusText(latest.Status), "grey")}
+		return resp, nil
+	case model.FeishuFinanceAgentActionExecuting:
+		return feishuToast("info", "正在执行，完成后卡片会自动更新"), nil
+	default:
+		return feishuToast("info", "这条指令还在处理中（"+feishuFinanceAgentStatusText(latest.Status)+"）"), nil
+	}
+}
+
+// executeFeishuFinanceAgentPlan 是整个机器人唯一的「写」入口：只有这两个 model 调用。
+func executeFeishuFinanceAgentPlan(actionID string, plan *feishuFinanceAgentPlan, before *model.FeishuFinanceAgentTargetState, operatorUserID int) []feishuFinanceAgentStep {
+	steps := make([]feishuFinanceAgentStep, 0, 2)
+	if plan.AddPromotion {
+		var commission *model.AffCommissionRule
+		if plan.CommissionRateBps != nil {
+			rate, days := *plan.CommissionRateBps, *plan.CommissionWindow
+			commission = &model.AffCommissionRule{
+				CommissionEnabled: true, CommissionRateBps: &rate, WindowDays: &days,
+				Reason: feishuFinanceAgentReason,
+			}
+		}
+		var withdrawal *model.AffWithdrawalPolicy
+		if plan.WithdrawEnabled != nil {
+			// 执行时重读现值：渠道/门槛/限额/手续费以执行时刻的数据库值为准，
+			// 计划里的 before 快照只用于卡片展示，避免覆盖管理员在确认间隙做的修改。
+			view := before.Withdrawal
+			if current, err := model.GetFeishuFinanceAgentTargetState(plan.TargetUserID); err == nil {
+				view = current.Withdrawal
+			} else {
+				common.SysError("[feishu-finance-agent] reload withdrawal view failed, fallback to snapshot: " + err.Error())
+			}
+			withdrawal = feishuFinanceAgentWithdrawalPolicy(*plan.WithdrawEnabled, view)
+		}
+		_, err := model.AddAffPromotionUsers([]int{plan.TargetUserID}, nil, commission, withdrawal, operatorUserID)
+		step := feishuFinanceAgentStep{Name: "推广用户 / 分佣 / 提现", OK: err == nil, Detail: "已生效"}
+		if err != nil {
+			step.Detail = err.Error()
+			common.SysError(fmt.Sprintf("[feishu-finance-agent] action %s promotion settings failed: %v", actionID, err))
+		}
+		steps = append(steps, step)
+	}
+	if plan.GiftCredits > 0 {
+		grant, _, err := model.GrantAdminCredits("feishu-"+actionID, plan.TargetUserID, operatorUserID,
+			plan.GiftCredits, feishuFinanceAgentGiftTitle)
+		step := feishuFinanceAgentStep{Name: "赠送积分", OK: err == nil, Detail: "+" + formatFeishuCredits(plan.GiftCredits)}
+		if err != nil {
+			step.Detail = err.Error()
+			common.SysError(fmt.Sprintf("[feishu-finance-agent] action %s grant credits failed: %v", actionID, err))
+		} else if syncErr := model.SyncAdminCreditGrantLogs(grant.Id); syncErr != nil {
+			// 钱包与赠送账本已原子提交；日志投影由后台同步器按 request_id 幂等补写。
+			common.SysLog(fmt.Sprintf("[feishu-finance-agent] sync grant %d logs failed: %v", grant.Id, syncErr))
+		}
+		steps = append(steps, step)
+	}
+	return steps
+}
+
+// feishuFinanceAgentWithdrawalPolicy 只改开关，渠道/门槛/限额/手续费沿用用户现值
+// （没有单独策略时即全局值），与后台页面「只切开关」的效果一致。
+func feishuFinanceAgentWithdrawalPolicy(enabled bool, view model.AffAgentWithdrawalView) *model.AffWithdrawalPolicy {
+	channels := strings.TrimSpace(view.Channels)
+	if channels == "" {
+		channels = "alipay"
+	}
+	minUSD := view.MinWithdrawUSD
+	if minUSD <= 0 {
+		minUSD = 10
+	}
+	daily := view.DailyLimitUSD
+	if daily != 0 && daily < minUSD {
+		daily = 0
+	}
+	return &model.AffWithdrawalPolicy{
+		Enabled: enabled, Channels: channels, MinWithdrawUSD: minUSD,
+		DailyLimitUSD: daily, FeeBps: view.FeeBps, Reason: feishuFinanceAgentReason,
+	}
+}
+
+// feishuFinanceAgentMaintenanceLoop 周期处理三类遗留：parsing 未解析、executing 卡死、
+// 结果卡片补更新失败。启动时立刻跑一轮，之后每 5 分钟一次。
+func feishuFinanceAgentMaintenanceLoop() {
+	ticker := time.NewTicker(5 * time.Minute)
+	defer ticker.Stop()
+	for {
+		feishuFinanceAgentSafeSweep("parsing", recoverFeishuFinanceAgentParsingRows)
+		feishuFinanceAgentSafeSweep("executing", recoverFeishuFinanceAgentExecutingRows)
+		feishuFinanceAgentSafeSweep("card-patch", feishuFinanceAgentRetryCardPatches)
+		<-ticker.C
+	}
+}
+
+// feishuFinanceAgentSafeSweep 保证单条 sweep panic 不会杀死唯一的维护循环。
+func feishuFinanceAgentSafeSweep(name string, fn func()) {
+	defer func() {
+		if r := recover(); r != nil {
+			common.SysError(fmt.Sprintf("[feishu-finance-agent] %s sweep panic: %v", name, r))
+		}
+	}()
+	fn()
+}
+
+// recoverFeishuFinanceAgentExecutingRows 重放进程崩溃/重启留下的 executing 记录。
+// 两类写操作都幂等（推广设置 upsert、赠送积分按 request_id 去重），重放安全。
+func recoverFeishuFinanceAgentExecutingRows() {
+	cutoff := common.GetTimestamp() - int64(feishuFinanceAgentStaleExecuting.Seconds())
+	for batch := 0; batch < 10; batch++ {
+		actions, err := model.ListStaleFeishuFinanceAgentExecuting(cutoff, 100)
+		if err != nil {
+			common.SysError("[feishu-finance-agent] scan stale executing actions failed: " + err.Error())
+			return
+		}
+		if len(actions) == 0 {
+			return
+		}
+		common.SysLog(fmt.Sprintf("[feishu-finance-agent] recovering %d stale executing action(s)", len(actions)))
+		for i := range actions {
+			feishuFinanceAgentRecoverExecutingAction(&actions[i], cutoff)
+		}
+		if len(actions) < 100 {
+			return
+		}
+	}
+}
+
+func feishuFinanceAgentRecoverExecutingAction(action *model.FeishuFinanceAgentAction, cutoff int64) {
+	version, won, err := model.ClaimFeishuFinanceAgentAction(action.Id,
+		model.FeishuFinanceAgentActionExecuting, model.FeishuFinanceAgentActionExecuting, cutoff, nil)
+	if err != nil || !won {
+		return
+	}
+	// F5：恢复重放也必须重新鉴权——操作员可能在 confirm 之后被降级/停用。
+	operator, user, authErr := authorizeFeishuFinanceAgentOperator(action.OperatorOpenId)
+	if authErr != nil {
+		// DB 瞬态故障：保留行，下一轮 sweep 再试，不能误标为「操作员已降级」终态。
+		common.SysError("[feishu-finance-agent] skip recovery, auth lookup failed: " + authErr.Error())
+		return
+	}
+	if operator == nil || user.Id != action.OperatorUserId {
+		common.SysLog("[feishu-finance-agent] skip recovery, operator no longer authorized: " + action.Id)
+		feishuFinanceAgentFailExecution(action, model.FeishuFinanceAgentActionExecuting, version,
+			[]feishuFinanceAgentStep{{Name: "恢复执行", OK: false, Detail: "操作员已降级或停用，跳过重放"}})
+		return
+	}
+	var plan feishuFinanceAgentPlan
+	if err := common.UnmarshalJsonStr(action.PlanJson, &plan); err != nil || plan.TargetUserID == 0 {
+		feishuFinanceAgentFailExecution(action, model.FeishuFinanceAgentActionExecuting, version,
+			[]feishuFinanceAgentStep{{Name: "恢复执行", OK: false, Detail: "执行计划缺失，跳过重放"}})
+		return
+	}
+	var before model.FeishuFinanceAgentTargetState
+	_ = common.UnmarshalJsonStr(action.BeforeJson, &before)
+
+	done := make(chan map[string]any, 1)
+	go func() { done <- runFeishuFinanceAgentExecution(action, &plan, &before, action.OperatorUserId, version) }()
+	select {
+	case resp := <-done:
+		feishuFinanceAgentPatchDoneCard(action, resp)
+	case <-time.After(feishuFinanceAgentRecoveryTimeout):
+		// 本次重放超时：行仍是 executing，下一轮会以新版本再次 claim；
+		// 迟到的旧执行写终态时版本已过期，会被拒绝。
+		common.SysError("[feishu-finance-agent] recovery execution timed out for action " + action.Id)
+	}
+}
+
+// feishuFinanceAgentFailExecution 把已 claim 的执行标记为失败（带版本谓词），并更新卡片。
+func feishuFinanceAgentFailExecution(action *model.FeishuFinanceAgentAction, from string, version int, steps []feishuFinanceAgentStep) {
+	resultJSON, _ := common.Marshal(steps)
+	if _, err := model.TransitionFeishuFinanceAgentActionVersioned(action.Id, from, version,
+		model.FeishuFinanceAgentActionFailed, map[string]any{
+			"result_json": string(resultJSON), "executed_at": common.GetTimestamp(),
+		}); err != nil {
+		common.SysError("[feishu-finance-agent] mark recovered action failed: " + err.Error())
+		return
+	}
+	var before model.FeishuFinanceAgentTargetState
+	_ = common.UnmarshalJsonStr(action.BeforeJson, &before)
+	after, _ := model.GetFeishuFinanceAgentTargetState(action.TargetUserId)
+	resp := feishuToast("error", "执行失败，请看卡片")
+	resp["card"] = map[string]any{"type": "raw",
+		"data": feishuFinanceAgentDoneCard(action, &before, after, steps, model.FeishuFinanceAgentActionFailed)}
+	feishuFinanceAgentPatchDoneCard(action, resp)
+}
+
+// recoverFeishuFinanceAgentParsingRows 重试已落库但没来得及解析的记录（进程崩溃窗口）。
+// 只处理 plan_json 为空的行：此时还没有发过卡片，重跑不会重复出卡。
+func recoverFeishuFinanceAgentParsingRows() {
+	cutoff := common.GetTimestamp() - int64(feishuFinanceAgentStaleExecuting.Seconds())
+	for batch := 0; batch < 10; batch++ {
+		actions, err := model.ListStaleFeishuFinanceAgentParsing(cutoff, 100)
+		if err != nil {
+			common.SysError("[feishu-finance-agent] scan stale parsing actions failed: " + err.Error())
+			return
+		}
+		if len(actions) == 0 {
+			return
+		}
+		for i := range actions {
+			action := &actions[i]
+			version, won, err := model.ClaimFeishuFinanceAgentAction(action.Id,
+				model.FeishuFinanceAgentActionParsing, model.FeishuFinanceAgentActionParsing, cutoff, nil)
+			if err != nil || !won {
+				continue
+			}
+			operator, _, authErr := authorizeFeishuFinanceAgentOperator(action.OperatorOpenId)
+			if authErr != nil {
+				common.SysError("[feishu-finance-agent] skip reparse, auth lookup failed: " + authErr.Error())
+				continue
+			}
+			if operator == nil {
+				feishuFinanceAgentFailExecution(action, model.FeishuFinanceAgentActionParsing, version,
+					[]feishuFinanceAgentStep{{Name: "恢复解析", OK: false, Detail: "操作员已降级或停用"}})
+				continue
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), feishuFinanceAgentProcessTimeout)
+			if err := runFeishuFinanceAgentAction(ctx, action, operator.Name); err != nil {
+				common.SysError("[feishu-finance-agent] reparse action failed: " + err.Error())
+			}
+			cancel()
+		}
+		if len(actions) < 100 {
+			return
+		}
+	}
+}
+
+// feishuFinanceAgentRetryCardPatches 补更新终态卡片（飞书 3 秒回调时限内没来得及 patch 的）。
+func feishuFinanceAgentRetryCardPatches() {
+	actions, err := model.ListFeishuFinanceAgentUnpatchedActions(
+		common.GetTimestamp()-int64((24*time.Hour).Seconds()), 100)
+	if err != nil {
+		common.SysError("[feishu-finance-agent] scan unpatched actions failed: " + err.Error())
+		return
+	}
+	for i := range actions {
+		action := &actions[i]
+		var steps []feishuFinanceAgentStep
+		_ = common.UnmarshalJsonStr(action.ResultJson, &steps)
+		var before model.FeishuFinanceAgentTargetState
+		_ = common.UnmarshalJsonStr(action.BeforeJson, &before)
+		after, _ := model.GetFeishuFinanceAgentTargetState(action.TargetUserId)
+		resp := feishuToast("info", "结果已更新")
+		resp["card"] = map[string]any{"type": "raw",
+			"data": feishuFinanceAgentDoneCard(action, &before, after, steps, action.Status)}
+		feishuFinanceAgentPatchDoneCard(action, resp)
+	}
+}
+
+func feishuFinanceAgentStatusText(status string) string {
+	switch status {
+	case model.FeishuFinanceAgentActionParsing:
+		return "解析中"
+	case model.FeishuFinanceAgentActionPending:
+		return "待确认"
+	case model.FeishuFinanceAgentActionExecuting:
+		return "执行中"
+	case model.FeishuFinanceAgentActionExecuted:
+		return "已执行"
+	case model.FeishuFinanceAgentActionPartial:
+		return "部分成功"
+	case model.FeishuFinanceAgentActionFailed:
+		return "执行失败"
+	case model.FeishuFinanceAgentActionCancelled:
+		return "已取消"
+	case model.FeishuFinanceAgentActionIgnored:
+		return "无需执行"
+	default:
+		return status
+	}
+}
+
+const feishuFinanceAgentHelpText = `HiAPI 推广助手用法（群里需要 @我）：
+一句话写清楚用户账号 + 要做的事，例如：
+• user@example.com 加入推广，10% 分佣，365 天有效期，开启提现，送 10w 积分
+• user@example.com 送 5 万积分
+• 12345 分佣改成 15%，有效期 180 天
+我会先回一张「当前值 → 改后值」的确认卡片，你点「确认执行」后才会真正生效。
+说明：新加入推广的用户默认开启提现；分佣没写有效期默认 365 天；单次最多送 100 万积分。`
diff --git a/service/feishu_finance_agent_card.go b/service/feishu_finance_agent_card.go
