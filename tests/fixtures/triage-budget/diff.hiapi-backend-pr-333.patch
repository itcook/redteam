+func GetFeishuFinanceAgentTargetState(userID int) (*FeishuFinanceAgentTargetState, error) {
+	state := &FeishuFinanceAgentTargetState{}
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var user User
+		if err := tx.Select("id", "username", "email", "role", "status", "quota").
+			Where("id = ?", userID).First(&user).Error; err != nil {
+			return err
+		}
+		state.UserID = user.Id
+		state.Username = user.Username
+		state.Email = user.Email
+		state.Role = user.Role
+		state.Status = user.Status
+		state.Quota = user.Quota
+
+		var member AffPromotionUser
+		err := tx.Where("user_id = ?", userID).First(&member).Error
+		if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		state.PromotionActive = err == nil && member.Active
+
+		commission, err := listAffCommissionViewsTx(tx, []int{userID})
+		if err != nil {
+			return err
+		}
+		state.Commission = commission[userID]
+		withdrawal, err := listAffWithdrawalViewsTx(tx, []int{userID})
+		if err != nil {
+			return err
+		}
+		state.Withdrawal = withdrawal[userID]
+
+		var config AffCommissionConfig
+		if err := tx.First(&config, affCommissionConfigId).Error; err != nil {
+			return err
+		}
+		state.GlobalWindowOn = config.WindowEnabled
+		state.GlobalCommission = config.CommissionEnabled
+
+		global := defaultGlobalAffWithdrawalPolicy()
+		if err := tx.Where("user_id = 0").First(&global).Error; err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		state.GlobalWithdrawOn = global.Enabled
+
+		var existing AffWithdrawalPolicy
+		err = tx.Where("user_id = ?", userID).First(&existing).Error
+		if err == nil {
+			state.ExistingWithdraw = &existing
+		} else if !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return state, nil
+}
