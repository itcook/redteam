+func TestBuildFeishuFinanceAgentPlan(t *testing.T) {
+	f := func(v float64) *float64 { return &v }
+	i := func(v int) *int { return &v }
+	i64 := func(v int64) *int64 { return &v }
+	b := func(v bool) *bool { return &v }
+	fresh := &model.FeishuFinanceAgentTargetState{UserID: 7, Status: common.UserStatusEnabled, Role: common.RoleCommonUser,
+		GlobalCommission: true, GlobalWindowOn: true, GlobalWithdrawOn: true}
+	member := *fresh
+	member.PromotionActive = true
+
+	plan, err := buildFeishuFinanceAgentPlan(&feishuFinanceAgentCommand{CommissionRatePercent: f(10)}, fresh)
+	require.NoError(t, err)
+	require.True(t, plan.AddPromotion)
+	require.Equal(t, 1000, *plan.CommissionRateBps)
+	require.Equal(t, 365, *plan.CommissionWindow)
+	require.True(t, *plan.WithdrawEnabled, "new promotion users default to withdrawal on")
+	require.Len(t, plan.Defaults, 2)
+	require.Empty(t, plan.Warnings)
+
+	plan, err = buildFeishuFinanceAgentPlan(&feishuFinanceAgentCommand{CommissionRatePercent: f(12.5), CommissionWindowDays: i(90)}, &member)
+	require.NoError(t, err)
+	require.Equal(t, 1250, *plan.CommissionRateBps)
+	require.Nil(t, plan.WithdrawEnabled, "existing members keep their withdrawal setting")
+
+	plan, err = buildFeishuFinanceAgentPlan(&feishuFinanceAgentCommand{GiftCredits: i64(100000)}, fresh)
+	require.NoError(t, err)
+	require.False(t, plan.AddPromotion)
+	require.EqualValues(t, 100000, plan.GiftCredits)
+
+	for name, cmd := range map[string]*feishuFinanceAgentCommand{
+		"window without rate": {CommissionWindowDays: i(30)},
+		"rate too high":       {CommissionRatePercent: f(60)},
+		"rate zero":           {CommissionRatePercent: f(0)},
+		"window too long":     {CommissionRatePercent: f(10), CommissionWindowDays: i(400)},
+		"gift over cap":       {GiftCredits: i64(1_000_001)},
+		"gift negative":       {GiftCredits: i64(-5)},
+		"nothing to do":       {},
+	} {
+		_, err := buildFeishuFinanceAgentPlan(cmd, fresh)
+		var userErr feishuFinanceAgentUserError
+		require.ErrorAs(t, err, &userErr, name)
+	}
+
+	off := *fresh
+	off.GlobalWindowOn, off.GlobalWithdrawOn, off.Role = false, false, common.RoleRootUser
+	plan, err = buildFeishuFinanceAgentPlan(&feishuFinanceAgentCommand{CommissionRatePercent: f(10), WithdrawEnabled: b(true)}, &off)
+	require.NoError(t, err)
+	require.Len(t, plan.Warnings, 3)
+}
