+// 计划（服务端存储的「改后值」）
+// ---------------------------------------------------------------------------
+
+type feishuFinanceAgentPlan struct {
+	TargetUserID      int      `json:"target_user_id"`
+	AddPromotion      bool     `json:"add_promotion"`
+	CommissionRateBps *int     `json:"commission_rate_bps,omitempty"`
+	CommissionWindow  *int     `json:"commission_window_days,omitempty"`
+	WithdrawEnabled   *bool    `json:"withdraw_enabled,omitempty"`
+	GiftCredits       int64    `json:"gift_credits,omitempty"`
+	Defaults          []string `json:"defaults,omitempty"`
+	Warnings          []string `json:"warnings,omitempty"`
+}
+
+type feishuFinanceAgentStep struct {
+	Name   string `json:"name"`
+	OK     bool   `json:"ok"`
