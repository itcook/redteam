+
+// feishu_finance_agent.go —— 飞书「HiAPI推广助手」主流程。
+//
+// 事件（im.message.receive_v1，飞书长连接直推本进程，见 feishu_finance_agent_ws.go）：
+//   白名单 + 实时 Root 校验 → LLM 解析 → 服务端确定性补默认值/校验 → 读目标用户现状 →
+//   落 pending action → 回复「当前值 → 改后值」确认卡片（按钮只带 action id）。
+// 卡片回调（card.action.trigger，同一条长连接）：
+//   只有发起人本人可点 + 再次实时 Root 校验 → pending→executing 抢占（防双击）→
+//   同进程直接调 model 层：AddAffPromotionUsers（推广/分佣/提现，同一事务）+
+//   GrantAdminCredits（积分，request_id=action 派生，天然幂等）→ 返回结果卡片。
+// 执行侧不持有任何 root token：能做的事在代码层面就只有这两个 model 调用。
+//
+// 威胁模型（信任边界）：
+//   - 消息原文不可信：群里的任何内容、以及操作员可能粘贴的第三方内容，都可能试图注入 LLM。
+//   - LLM 只产出「计划」，不直接写库。唯一的执行门是确认卡片：计划先落库，由发起人
+//     （每次确认实时校验仍为 Root）在卡片上逐项比对「当前值 → 改后值」并点击确认才执行。
+//   - 卡片始终回显指令原文；含链接 / @提及 / 引用块 / 代码块时额外给出注入警示。
+//   - 按钮只携带 action id，参数全部来自服务端存储，客户端无法篡改。
+// 可靠性：事件先落库再 ack；执行超过飞书回调时限则先回「执行中」，完成后补更新卡片；
+// 进程崩溃遗留的 executing 记录在启动时自动重放（所有写操作本身幂等）。
+
+const (
+	feishuFinanceAgentActionTTL      = 30 * time.Minute
+	feishuFinanceAgentMaxGiftCredits = int64(1_000_000)
+	feishuFinanceAgentDefaultWindow  = 365
+	feishuFinanceAgentMaxRateBps     = 5000
+	feishuFinanceAgentReason         = "飞书推广助手"
+	feishuFinanceAgentGiftTitle      = "飞书推广助手赠送"
+	feishuFinanceAgentMaxTextRunes   = 500
+	feishuFinanceAgentProcessTimeout = 90 * time.Second
+	// 飞书卡片回调要求 3 秒内返回；留一点余量，超时先回「执行中」，完成后补更新卡片。
+	feishuFinanceAgentCallbackBudget = 2500 * time.Millisecond
+	// 执行中记录超过这么久仍未落结果，视为进程崩溃遗留，启动时重放。
+	feishuFinanceAgentStaleExecuting = 5 * time.Minute
+	// 单个恢复重放的等待上限；超时留给下一轮（fencing 保证迟到的旧执行不会覆盖结果）。
+	feishuFinanceAgentRecoveryTimeout = 60 * time.Second
+)
+
+var (
+	feishuMentionPlaceholder = regexp.MustCompile(`@_user_\d+`)
+	feishuLinkPattern        = regexp.MustCompile(`(?i)https?://|www\.`)
+	feishuQuotePattern       = regexp.MustCompile(`(?m)^\s*>`)
+	// 只把「独立出现的 @」当作提及；邮箱里的 @ 不算（目标账号经常就是邮箱）。
+	feishuAtMentionPattern = regexp.MustCompile(`(?:^|[\s，。、,;：:])@[^\s@]`)
+	// 纯语言注入（没有链接/引用等载体）也给出警示。
+	feishuSemanticInjectionPattern = regexp.MustCompile(`(?i)忽略(之前|上述|前面|以上).{0,8}(指令|规则|提示)|ignore\s+(all\s+)?(previous|above)\s+instructions|system\s*prompt|你现在是`)
+)
+
+// feishuFinanceAgentInjectionHints 标出指令里常见的提示注入载体，在确认卡上显式警示。
+func feishuFinanceAgentInjectionHints(text string) []string {
+	hints := make([]string, 0, 4)
+	if feishuLinkPattern.MatchString(text) {
+		hints = append(hints, "链接")
+	}
+	if feishuAtMentionPattern.MatchString(text) {
+		hints = append(hints, "@提及")
+	}
+	if feishuQuotePattern.MatchString(text) {
+		hints = append(hints, "引用块")
+	}
+	if strings.Contains(text, "```") {
+		hints = append(hints, "代码块")
+	}
+	if feishuSemanticInjectionPattern.MatchString(text) {
+		hints = append(hints, "疑似指令注入")
+	}
+	return hints
+}
+
+// feishuFinanceAgentInjectionWarningText 返回卡片上展示的注入警示（无警示时为空）。
+func feishuFinanceAgentInjectionWarningText(text string) string {
+	hints := feishuFinanceAgentInjectionHints(text)
+	if len(hints) == 0 {
+		return ""
+	}
+	return "指令包含" + strings.Join(hints, "、") + "，可能存在提示注入，请逐项核对目标账号与数值"
+}
