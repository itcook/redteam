{
  "$id": "urn:redteam:config/1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "GroupingCfg": {
      "description": "`review.grouping`：ocr 双阈值门起步值（4 / 200 / 10，D3）；`semantic` 默认关（R8）。",
      "properties": {
        "bundleLineThreshold": {
          "default": 200,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxFilesPerGroup": {
          "default": 10,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "minFiles": {
          "default": 4,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "semantic": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Language": {
      "description": "输出语言枚举（serde 严格枚举：非法值 → 配置解析失败）。",
      "enum": [
        "zh_CN",
        "en_US"
      ],
      "type": "string"
    },
    "MaxCells": {
      "oneOf": [
        {
          "enum": [
            "auto"
          ],
          "type": "string"
        },
        {
          "minimum": 1.0,
          "type": "integer"
        }
      ]
    },
    "ModelConfig": {
      "description": "模型（`providers.<name>.models.<id>`）：固有属性只写一次；`roles` 键即该模型参与的角色。",
      "properties": {
        "apiKeyEnv": {
          "description": "模型级 key env（覆盖 provider.apiKeyEnv）。",
          "type": [
            "string",
            "null"
          ]
        },
        "contextWindow": {
          "description": "context window（token），pack 预算护墙；缺省保守 128K；下限 `MIN_CONTEXT_WINDOW`。",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "displayName": {
          "description": "人读显示名（`model list` / 将来报告用）；**不是**身份串——身份串固定为 `provider/id`〔D12 定案 3〕。",
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "description": "家族；缺省取 id 首段（deepseek / gemini / glm / kimi）。",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProviderKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "覆盖 provider.kind；两层都缺 → validate 报错。"
        },
        "maxOutputTokens": {
          "description": "输出上限（max_tokens，≥ 1）：> REDTEAM_MAX_TOKENS env > 32768 默认。",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "perTurnTimeoutSecs": {
          "description": "单轮超时（秒，≥ 1）：> REDTEAM_PER_TURN_SECS > 公式（见 `EffectiveModel::per_turn_secs`）。",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reasoning": {
          "default": false,
          "description": "思考型模型（thinking token 计入输出额度——预算与截断判定参考）。",
          "type": "boolean"
        },
        "roles": {
          "additionalProperties": {
            "$ref": "#/definitions/RoleAttrs"
          },
          "default": {},
          "description": "角色 map：键必须显式枚举（P17：schema 也要拦住 `roles.gerbil` 这类拼写错误， 不能只靠运行期 serde 报错）。schemars 对 `BTreeMap<Role, _>` 只生成 `additionalProperties`，故手写键枚举（与 `MaxCells` 同理由）。",
          "propertyNames": {
            "enum": [
              "scanner",
              "reviewer",
              "refuter",
              "verifier"
            ]
          }
        }
      },
      "type": "object"
    },
    "PackBody": {
      "description": "`review.pack.body`：scanner 组 pack 装包形态；缺省 `slice`〔D8〕，pack 侧实现在批 E。",
      "enum": [
        "full",
        "slice"
      ],
      "type": "string"
    },
    "PackCfg": {
      "properties": {
        "anchorWindow": {
          "default": 30,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "body": {
          "allOf": [
            {
              "$ref": "#/definitions/PackBody"
            }
          ],
          "default": "slice"
        },
        "findingWindow": {
          "default": 30,
          "description": "finding 判定半径（design §10.4，M21d 批 B-2）：锚点离最近改动行超过 N 行即「窗外」。 **与 `anchorWindow` 是两回事**——那个是装包的禁真空窗半径，调参方向相反（装包半径大一点更安全， 判定半径大一点更宽松），共用一个键会让调任一方都要跑两套回归〔批 B 开工裁定 1〕。 0 = 连观测都关。",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "findingWindowEnforce": {
          "default": false,
          "description": "窗外 finding 是否**降级**（移出 findings、只进披露）。默认 false = 只观测不改产出 〔批 B 开工裁定 2：先拿真实分布再定阈值；直接丢 = 静默少报〕。",
          "type": "boolean"
        },
        "sliceMinBytes": {
          "default": 8192,
          "description": "文件 ≤ 此字节数不切片直接全文（design §10.2）。",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ProviderConfig": {
      "description": "`providers.<name>`：通道层。`maxConcurrency` = 该 provider 在途上限（缺省继承 `review.maxConcurrency`；在途锁批 F 接线）。",
      "properties": {
        "apiKeyEnv": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProviderKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxConcurrency": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/definitions/ModelConfig"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "ProviderKind": {
      "description": "各变体的 `#[serde(alias = ...)]` 是别名的唯一真相源；`model::validate_setup` 的报错文案 手工抄了一份人读版本（serde alias 列表运行时不可反射）——改这里的别名记得同步改那边的文案。",
      "enum": [
        "anthropic",
        "openai",
        "openai-compatible",
        "google"
      ],
      "type": "string"
    },
    "ReasoningEffort": {
      "description": "推理强度（角色属性：同一模型可在 scanner 位 low、reviewer 位 high）。backend 消费在批 F。 值原样透传给上游；`off` / `none` 不再建模——只有极少数模型支持关推理，需要时由模型默认行为决定。",
      "enum": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ],
      "type": "string"
    },
    "RefutersCfg": {
      "description": "`review.refuters`：评审内 finding 验真（refute）开关。**缺省关**——批 D-4 的离线基线按预登记阈值裁定 （误驳 ≤ 5% ∧ 驳回 ≥ 30% 才默认开）：异族 deepseek-flash 驳回 31.2% / 误驳 12.0%、 同族 glm-5.3 驳回 18.8% / 误驳 8.0%，两臂的误驳都超门槛 → 默认关，要开显式写 `\"enabled\": true`。 （数字为收口修掉「角色尾未 render」后的重跑值；修前那版见 research 的对照表。） 数字与归因见 `.next/research/2026-09-21-redteam-verifier-offline-baseline-research.md`（历史文档，保留原名）。 缺省关 = `bool` 的 `Default`，故直接 derive：serde 缺省与 `Default` 只此一个来源，不会各说各话 （`refuters_enabled_defaults_off` 钉住两条路径同值）。",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ReviewConfig": {
      "properties": {
        "blockThreshold": {
          "allOf": [
            {
              "$ref": "#/definitions/Severity"
            }
          ],
          "default": "medium"
        },
        "confFloor": {
          "default": 0.5,
          "format": "float",
          "type": "number"
        },
        "grouping": {
          "allOf": [
            {
              "$ref": "#/definitions/GroupingCfg"
            }
          ],
          "default": {
            "bundleLineThreshold": 200,
            "maxFilesPerGroup": 10,
            "minFiles": 4,
            "semantic": false
          }
        },
        "maxConcurrency": {
          "default": 10,
          "description": "全局在途上限缺省（10，D13）；provider 级 `maxConcurrency` 缺省继承它。provider 在途门是唯一一道闸（design §12.3）： 无角色级 workers；> `MAX_CONCURRENCY_SANE` 只 warning（像是把 maxOutputTokens 填错了字段）。",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "pack": {
          "allOf": [
            {
              "$ref": "#/definitions/PackCfg"
            }
          ],
          "default": {
            "anchorWindow": 30,
            "body": "slice",
            "findingWindow": 30,
            "findingWindowEnforce": false,
            "sliceMinBytes": 8192
          }
        },
        "refuters": {
          "allOf": [
            {
              "$ref": "#/definitions/RefutersCfg"
            }
          ],
          "default": {
            "enabled": false
          },
          "description": "评审内 finding 验真开关（角色 `refuter`）。**缺省关**（数值依据见 `RefutersCfg`）。"
        },
        "reviewers": {
          "allOf": [
            {
              "$ref": "#/definitions/ReviewersCfg"
            }
          ],
          "default": {
            "maxCells": "auto",
            "reenqueue": false
          }
        },
        "scanners": {
          "allOf": [
            {
              "$ref": "#/definitions/ScannersCfg"
            }
          ],
          "default": {
            "samples": 1
          }
        },
        "tools": {
          "allOf": [
            {
              "$ref": "#/definitions/ToolsMode"
            }
          ],
          "default": "two-stage",
          "description": "工具档位：off | two-stage（默认）| on。"
        }
      },
      "type": "object"
    },
    "ReviewersCfg": {
      "properties": {
        "maxCells": {
          "allOf": [
            {
              "$ref": "#/definitions/MaxCells"
            }
          ],
          "default": "auto"
        },
        "reenqueue": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RoleAttrs": {
      "description": "角色属性（`models.<id>.roles.<role>`）。将来的角色级旋钮只加在这里。",
      "properties": {
        "reasoningEffort": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ScannersCfg": {
      "description": "角色节（design §12.1〔D13〕）：无角色级 `workers`——并发只看 provider `maxConcurrency`（唯一闸，§12.3）。",
      "properties": {
        "samples": {
          "default": 1,
          "description": "同模型多 lens 采样并集（E3：方差对冲旋钮）。",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "ToolsMode": {
      "description": "评审工具档位（design 2026-07-13 §2.4）：off / two-stage（默认）/ on。M21b 定工具分层前保留不动。",
      "enum": [
        "off",
        "two-stage",
        "on"
      ],
      "type": "string"
    }
  },
  "properties": {
    "language": {
      "anyOf": [
        {
          "$ref": "#/definitions/Language"
        },
        {
          "type": "null"
        }
      ],
      "description": "输出语言（P15 / 计划 1.4）：顶层键，`zh_CN` | `en_US`。 缺省（None）时：本地模式沿用 locale 探测，job 模式固定 `en_US` 且**不读 env**。"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/definitions/ProviderConfig"
      },
      "default": {},
      "type": "object"
    },
    "review": {
      "allOf": [
        {
          "$ref": "#/definitions/ReviewConfig"
        }
      ],
      "default": {
        "blockThreshold": "medium",
        "confFloor": 0.5,
        "grouping": {
          "bundleLineThreshold": 200,
          "maxFilesPerGroup": 10,
          "minFiles": 4,
          "semantic": false
        },
        "maxConcurrency": 10,
        "pack": {
          "anchorWindow": 30,
          "body": "slice",
          "findingWindow": 30,
          "findingWindowEnforce": false,
          "sliceMinBytes": 8192
        },
        "refuters": {
          "enabled": false
        },
        "reviewers": {
          "maxCells": "auto",
          "reenqueue": false
        },
        "scanners": {
          "samples": 1
        },
        "tools": "two-stage"
      }
    }
  },
  "schemaVersion": 1,
  "title": "redteam executor config",
  "type": "object"
}
