+    const data = { modelId: original.modelId, granularity: original.granularity,
+      ...(original.modelName !== undefined ? { modelName: original.modelName } : {}), ...changes };
+    const result = await ModelContentService.transcribeInfoDraft({ ...draft, data }, tx);
+    if (result.entityId !== target.entityId) throw new UnprocessableError('修订模型身份与正式内容不一致');
