+/// Server-owned acceptance association. Never supplied through ingest data/source.
+model IngestDraftAcceptance {
+  draftId     String      @id @map("draft_id")
+  entityId    String      @map("entity_id")
+  createdAt   DateTime    @default(now()) @map("created_at")
+  draft       IngestDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
+
+  @@map("ingest_draft_acceptance")
+}
+
+/// Immutable revision receipt. The candidate content lives in its ordinary pending draft.
+model IngestDraftRevision {
+  draftId            String      @id @map("draft_id")
