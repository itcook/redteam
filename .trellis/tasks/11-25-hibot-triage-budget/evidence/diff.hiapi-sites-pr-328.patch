@@ -0,0 +1,245 @@
+import { beforeEach, describe, expect, test } from 'bun:test';
+import { dbUnscoped } from '../../../src/db/client';
+import { ReviewService } from '../../../src/modules/review/service';
+import { DraftRevisionService } from '../../../src/modules/review/revision-service';
+import { DraftUpdateService } from '../../../src/modules/review/update-service';
+import { DraftModifyService } from '../../../src/modules/review/modify-service';
+import { ConflictError, UnprocessableError } from '../../../src/utils/errors';
+import { resetAndSeed } from '../../db-harness';
+import { seedModelFixtures, SEED } from '../model/fixtures';
+import { handle, json } from '../../support/http';
+import { staffCookie } from '../../support/auth';
+
+beforeEach(async () => { await resetAndSeed(); await seedModelFixtures(); });
+const c = () => dbUnscoped();
+const seed = (contentType: string, data: object, extra: object = {}) => c().ingestDraft.create({ data: {
+  contentType, locale: 'zh', data, source: { producer: 'test', contractVersion: 'v1' },
+  idempotencyKey: crypto.randomUUID(), ...extra,
+} });
+const faqData = { question: '长图比例如何设置？', answer: '不支持', modelRef: 'gpt-4', familyRef: 'gpt-4', sequence: 7 };
+const blogData = { slug: 'revision-blog', title: '旧标题', bodyHtml: '<p>旧正文</p>', summary: ['旧摘要'], modelRefs: ['gpt-4'] };
+async function accepted(type = 'faq', data: object = faqData, extra: object = {}) {
+  const row = await seed(type, data, extra);
+  const result = await ReviewService.accept(row.id);
+  return { row: await c().ingestDraft.findUniqueOrThrow({ where: { id: row.id } }), entityId: result.entityId };
+}
+const propose = (row: { id: string; updatedAt: Date }, data: Record<string, unknown>, key = crypto.randomUUID(), targetEntityId?: string) =>
+  DraftRevisionService.revise(row.id, { data, expectedUpdatedAt: row.updatedAt.toISOString(), idempotencyKey: key, targetEntityId });
+
+describe('Showcase 文案补丁', () => {
+  test('仅改展示文案；保留历史输入、媒体和 hash，并检测并发版本', async () => {
+    const data = { title: '旧标题', introduce: '旧介绍', prompt: 'original', input: { prompt: 'original' },
+      artifact: 'https://static.hiapi.ai/artifact.png', inputSchemaHash: 'historical-hash', modelRef: 'gpt-4', routeKey: '' };
+    const media = [{ role: 'artifact', ref: { artifactId: '123', url: data.artifact } }];
+    const row = await seed('showcase', data, { media });
+    const result = await DraftUpdateService.update(row.id, { data: { title: '新标题', introduce: '新介绍' }, expectedUpdatedAt: row.updatedAt.toISOString() });
+    expect(result.row.id).toBe(row.id);
+    expect(result.row.status).toBe('pending');
+    expect(result.row.data).toEqual({ ...data, title: '新标题', introduce: '新介绍' });
+    expect(result.row.media).toEqual(media);
+    expect(result.row.source).toEqual(row.source);
+    expect(result.row.updatedAt.getTime()).toBeGreaterThan(row.updatedAt.getTime());
+    await expect(DraftUpdateService.update(row.id, { data: { title: 'stale' }, expectedUpdatedAt: row.updatedAt.toISOString() })).rejects.toBeInstanceOf(ConflictError);
+    expect(await c().agentJob.count()).toBe(0);
+  });
+
+  test('保护字段和 media/locale 整体拒绝，不部分更新', async () => {
+    const row = await seed('showcase', { title: '旧', introduce: '介绍', prompt: 'original' });
+    for (const body of [
+      { data: { title: '新', prompt: 'edited' } }, { data: { input: {} } }, { data: { inputSchemaHash: 'new' } },
+      { data: { title: null } }, { data: { title: '新' }, media: null }, { data: { title: '新' }, locale: 'zh' as const },
+    ]) {
+      await expect(DraftUpdateService.update(row.id, { ...body, expectedUpdatedAt: row.updatedAt.toISOString() })).rejects.toBeInstanceOf(UnprocessableError);
+      expect(await c().ingestDraft.findUnique({ where: { id: row.id } })).toEqual(row);
+    }
+  });
+});
+
+describe('accepted 内容修订', () => {
+  test('FAQ 派生、编辑、接受更新原实体，保留原稿、发布时间与另一语言；不触发作业', async () => {
+    const { row, entityId } = await accepted();
+    const original = await c().faqI18n.findFirstOrThrow({ where: { faqId: entityId, locale: 'zh' } });
+    const en = await c().faqI18n.create({ data: { faqId: entityId, locale: 'en', question: 'Ratio?', answer: 'auto only', publishedAt: new Date() } });
+    const beforeCount = await c().faq.count();
+    const revision = await propose(row, { answer: '仅支持 auto' });
+    expect(revision.row.parentDraftId).toBe(row.id);
+    expect(revision.row.status).toBe('pending');
+    expect(await c().ingestDraft.findUnique({ where: { id: row.id } })).toEqual(row);
+    expect(await c().faqI18n.findUnique({ where: { id: original.id } })).toEqual(original);
+    const edited = await DraftUpdateService.update(revision.row.id, {
+      data: { answer: '长图仅支持 auto' }, expectedUpdatedAt: revision.row.updatedAt.toISOString(),
+    });
+    let jobs = 0;
+    const result = await ReviewService.accept(edited.row.id, {
+      enqueueImpl: async () => { jobs++; }, enqueueTranslationImpl: async () => { jobs++; }, enqueueImageImpl: async () => { jobs++; },
+    });
+    expect(result.entityId).toBe(entityId);
+    expect(await c().faq.count()).toBe(beforeCount);
+    expect((await c().faqI18n.findUniqueOrThrow({ where: { id: original.id } })).answer).toBe('长图仅支持 auto');
+    expect((await c().faqI18n.findUniqueOrThrow({ where: { id: original.id } })).publishedAt).toEqual(original.publishedAt);
+    expect(await c().faqI18n.findUnique({ where: { id: en.id } })).toEqual(en);
+    expect(await c().ingestDraft.findUnique({ where: { id: row.id } })).toEqual(row);
+    expect(jobs).toBe(0);
+  });
+
+  test('同 key 并发重放复用同一稿；编辑和接受后仍复用；不同 payload 冲突', async () => {
+    const { row } = await accepted();
+    const key = crypto.randomUUID();
+    const [a, b] = await Promise.all([propose(row, { answer: 'auto' }, key), propose(row, { answer: 'auto' }, key)]);
+    expect(a.row.id).toBe(b.row.id);
+    await DraftUpdateService.update(a.row.id, { data: { answer: 'auto only' }, expectedUpdatedAt: a.row.updatedAt.toISOString() });
+    expect((await propose(row, { answer: 'auto' }, key)).row.data).toMatchObject({ answer: 'auto only' });
+    await ReviewService.accept(a.row.id);
+    expect((await propose(row, { answer: 'auto' }, key)).row.status).toBe('accepted');
+    await expect(propose(row, { answer: 'different' }, key)).rejects.toBeInstanceOf(ConflictError);
+    expect(await c().ingestDraftRevision.count()).toBe(1);
+  });
+
+  test('请求重放先于版本校验：源版本变化和重新读取版本都返回原修订', async () => {
+    const { row, entityId } = await accepted();
+    const key = crypto.randomUUID();
+    const data = { answer: 'auto only' };
+    const revision = await propose(row, data, key, entityId);
+    // Simulate an out-of-band version change; ordinary API edits of accepted sources remain forbidden.
+    const changed = await c().ingestDraft.update({
+      where: { id: row.id }, data: { updatedAt: new Date(row.updatedAt.getTime() + 1000) },
+    });
+    const staleReplay = await propose(row, data, key, entityId);
+    const refreshedReplay = await propose(changed, data, key, entityId);
+    expect(staleReplay.reused).toBe(true);
+    expect(refreshedReplay.reused).toBe(true);
+    expect(staleReplay.row.id).toBe(revision.row.id);
+    expect(refreshedReplay.row.id).toBe(revision.row.id);
+    expect(await c().ingestDraftRevision.count()).toBe(1);
+    expect(await c().ingestDraft.count({ where: { parentDraftId: row.id } })).toBe(1);
+    // A new operation still checks freshness, and an existing key still rejects changed intent.
+    await expect(propose(row, data, crypto.randomUUID(), entityId)).rejects.toBeInstanceOf(ConflictError);
+    await expect(propose(changed, { answer: 'different' }, key, entityId)).rejects.toBeInstanceOf(ConflictError);
+  });
+
+  test('英文原稿修订保留中文译文，驳回后同 key 回读已有 rejected 稿', async () => {
+    const { row, entityId } = await accepted('faq', { ...faqData, question: 'Ratio?', answer: 'unsupported' }, { locale: 'en' });
+    const zh = await c().faqI18n.create({ data: { faqId: entityId, locale: 'zh', question: '中文', answer: '保留', publishedAt: new Date() } });
+    const key = crypto.randomUUID();
+    const revision = await propose(row, { answer: 'auto only' }, key);
+    await ReviewService.reject(revision.row.id);
+    const replay = await propose(row, { answer: 'auto only' }, key);
+    expect(replay.row.id).toBe(revision.row.id);
+    expect(replay.row.status).toBe('rejected');
+    const next = await propose(row, { answer: 'auto only' });
+    await ReviewService.accept(next.row.id);
+    expect(await c().faqI18n.findUnique({ where: { id: zh.id } })).toEqual(zh);
+    expect((await c().faqI18n.findFirstOrThrow({ where: { faqId: entityId, locale: 'en' } })).answer).toBe('auto only');
+  });
+
+  test('并发正式内容更新使 accept 回滚且稿留 pending', async () => {
+    const { row, entityId } = await accepted();
+    const revision = await propose(row, { answer: '修订' });
