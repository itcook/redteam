diff --git a/apps/content-api/src/modules/review/revision-rules.ts b/apps/content-api/src/modules/review/revision-rules.ts
new file mode 100644
index 00000000..4ccf3608
--- /dev/null
+++ b/apps/content-api/src/modules/review/revision-rules.ts
@@ -0,0 +1,48 @@
+import { Value } from '@sinclair/typebox/value';
+import type { IngestDraft } from '../../../generated/prisma/client';
+import { ConflictError, UnprocessableError } from '../../utils/errors';
+import { DRAFT_EDIT_RULES, mergeJsonPatch } from './draft-rules';
+import { canonicalJson } from '../model-watch/detect';
+
+export function revisionFields(type: string, data: Record<string, unknown>): readonly string[] {
+  switch (type) {
+    case 'blog': return ['title', 'subtitle', 'bodyHtml', 'summary', 'takeaways', 'keywords', 'heroStats', 'seo', 'readingTime'];
+    case 'faq': case 'model-faq': return ['question', 'answer'];
+    case 'changelog': return ['title', 'bodyHtml'];
+    case 'model-info': return data.granularity === 'family' ? ['brief'] : ['overview'];
+    default: throw new UnprocessableError(`contentType 不支持 revise：${type}`);
+  }
+}
+
+export function assertDraftVersion(row: IngestDraft, expected?: string, required = false): void {
+  if (!expected && required) throw new UnprocessableError('该操作需要 expectedUpdatedAt（先读取 draft info）');
+  if (expected !== undefined) {
+    const time = Date.parse(expected);
+    if (!Number.isFinite(time)) throw new UnprocessableError('expectedUpdatedAt 须为 ISO 8601');
+    if (row.updatedAt.getTime() !== time) throw new ConflictError('draft 版本已变化，请回读后重试');
+  }
+}
+
+export function reviseData(type: string, base: Record<string, unknown>, patch: Record<string, unknown>): Record<string, unknown> {
+  const fields = revisionFields(type, base);
+  if (!Object.keys(patch).length) throw new UnprocessableError('修订补丁不能为空');
+  for (const key of Object.keys(patch)) {
+    if (!fields.includes(key)) throw new UnprocessableError(`修订不可修改字段：${key}；可写字段：${fields.join(', ')}`);
+    if (type === 'model-info' && patch[key] === null) throw new UnprocessableError('模型介绍修订不可删除内容字段');
+  }
+  const merged = mergeJsonPatch(base, patch);
+  const rule = DRAFT_EDIT_RULES[type]!;
+  if (!Value.Check(rule.schema, merged)) throw new UnprocessableError('修订 data 不符合内容契约');
+  if (canonicalJson(merged) === canonicalJson(base)) throw new UnprocessableError('修订没有实际变更');
+  return merged;
+}
+
+/** Diff the complete reviewed candidate, including deletions of optional editorial fields. */
+export function revisionChanges(type: string, base: Record<string, unknown>, candidate: Record<string, unknown>): Record<string, unknown> {
+  const changes: Record<string, unknown> = {};
+  for (const key of new Set([...Object.keys(base), ...Object.keys(candidate)])) {
+    if (canonicalJson(base[key] ?? null) !== canonicalJson(candidate[key] ?? null)) changes[key] = candidate[key] ?? null;
+  }
+  reviseData(type, base, changes);
+  return changes;
+}
diff --git a/apps/content-api/src/modules/review/revision-service.ts b/apps/content-api/src/modules/review/revision-service.ts
new file mode 100644
index 00000000..f46da2c3
--- /dev/null
+++ b/apps/content-api/src/modules/review/revision-service.ts
@@ -0,0 +1,66 @@
+import type { AdminDraftReviseRequest } from '@hiapi/content-sdk';
+import { Prisma, type IngestDraft } from '../../../generated/prisma/client';
+import { db } from '../../db/client';
+import { ConflictError, NotFoundError, UnprocessableError } from '../../utils/errors';
+import { withDeadlockRetry } from '../media/retry';
+import type { Tx } from '../media/service';
+import { refreshDraftTargets } from '../ingest/targets';
+import { toJsonObject } from '../playground/model';
+import { assertDraftVersion, reviseData, revisionChanges } from './revision-rules';
+import { readRevisionTarget, resolveRevisionTarget, revisionHash, revisionKind } from './revision-target';
+import { applyRevision } from './revision-write';
+
+export abstract class DraftRevisionService {
+  static async revise(id: string, body: AdminDraftReviseRequest) {
+    const requestKey = revisionHash([id, body.idempotencyKey]);
+    const requestFingerprint = revisionHash({ data: body.data, targetEntityId: body.targetEntityId ?? null });
+    const result = await withDeadlockRetry(() => db().$transaction(async (rawTx) => {
+      const tx = rawTx as Tx;
+      await tx.$queryRaw`SELECT id FROM ingest_draft WHERE id = ${id} FOR UPDATE`;
+      const source = await tx.ingestDraft.findUnique({ where: { id } });
+      if (!source) throw new NotFoundError(`draft 不存在：${id}`);
+      const replay = await tx.ingestDraftRevision.findUnique({ where: { requestKey }, include: { draft: true } });
+      if (replay) {
+        if (replay.requestFingerprint !== requestFingerprint) throw new ConflictError('idempotencyKey 已用于不同修订请求');
+        return { row: replay.draft, derivedFrom: id, reused: true };
+      }
+      if (source.status !== 'accepted') throw new ConflictError('revise 只接受 accepted 原稿；pending/rejected 请用 update');
+      assertDraftVersion(source, body.expectedUpdatedAt, true);
+      revisionKind(source);
+      const origin = toJsonObject(source.source);
+      if (origin.overviewRefill !== undefined) {
+        throw new UnprocessableError('该介绍由专用 overview 修订流程管理，请继续使用该流程');
+      }
+      if (Array.isArray(source.media) && source.media.length) throw new UnprocessableError('该内容修订不接受 draft.media');
+      const entityId = await resolveRevisionTarget(tx, source, body.targetEntityId);
+      const target = await readRevisionTarget(tx, source, entityId);
+      const data = reviseData(source.contentType, target.data, body.data);
+      const row = await tx.ingestDraft.create({ data: {
+        contentType: source.contentType, locale: source.locale, source: source.source as Prisma.InputJsonValue,
+        data: data as Prisma.InputJsonValue, media: source.media === null ? Prisma.DbNull : source.media as Prisma.InputJsonValue,
+        parentDraftId: source.id, status: 'pending', idempotencyKey: `revision:${requestKey}`,
+      } });
+      await tx.ingestDraftRevision.create({ data: {
+        draftId: row.id, sourceDraftId: id, requestKey, requestFingerprint,
+        targetKind: target.kind, targetEntityId: entityId, targetFingerprint: target.fingerprint,
+        baseData: target.data as Prisma.InputJsonValue,
+      } });
+      return { row, derivedFrom: id, reused: false };
+    }, { timeout: 30_000 }), { owns: true });
+    await refreshDraftTargets(result.row);
+    return result;
+  }
+
+  /** Called inside the existing pending -> accepted transaction. */
+  static async accept(draft: IngestDraft, tx: Tx): Promise<{ entityId: string } | null> {
+    const receipt = await tx.ingestDraftRevision.findUnique({ where: { draftId: draft.id } });
+    if (!receipt) return null;
+    const target = await readRevisionTarget(tx, draft, receipt.targetEntityId);
+    if (target.kind !== receipt.targetKind || target.fingerprint !== receipt.targetFingerprint) {
+      throw new ConflictError('正式内容已变化，请从原稿重新派生修订；当前修订仍为 pending');
+    }
+    const changes = revisionChanges(draft.contentType, toJsonObject(receipt.baseData), toJsonObject(draft.data));
+    await applyRevision(tx, draft, target, changes);
+    return { entityId: receipt.targetEntityId };
+  }
+}
diff --git a/apps/content-api/src/modules/review/revision-target.ts b/apps/content-api/src/modules/review/revision-target.ts
new file mode 100644
index 00000000..346ce908
--- /dev/null
+++ b/apps/content-api/src/modules/review/revision-target.ts
@@ -0,0 +1,110 @@
+import { createHash } from 'node:crypto';
+import { Prisma, type IngestDraft } from '../../../generated/prisma/client';
+import { ConflictError } from '../../utils/errors';
+import type { Tx } from '../media/service';
+import { canonicalJson } from '../model-watch/detect';
+import { toJsonObject } from '../playground/model';
+import { revisionFields } from './revision-rules';
+import { sanitizeRichText } from '../media/codec';
+
+export type RevisionKind = 'blog' | 'faq' | 'changelog' | 'model' | 'family';
+export interface RevisionTarget {
+  kind: RevisionKind;
+  entityId: string;
+  rowId: string;
+  fingerprint: string;
+  data: Record<string, unknown>;
+}
+export const revisionHash = (value: unknown) => createHash('sha256').update(canonicalJson(value)).digest('hex');
+
+export function revisionKind(draft: IngestDraft): RevisionKind {
+  revisionFields(draft.contentType, toJsonObject(draft.data));
+  if (draft.contentType === 'model-info') return toJsonObject(draft.data).granularity === 'family' ? 'family' : 'model';
+  return draft.contentType === 'model-faq' ? 'faq' : draft.contentType as RevisionKind;
+}
+
+/** Parameterized values; table identifiers come only from the closed mapping below. */
+async function lockTarget(tx: Tx, kind: RevisionKind, id: string, locale: string): Promise<void> {
+  if (kind === 'model' || kind === 'family') {
+    const table = Prisma.raw(kind === 'model' ? 'model_info' : 'model_family_info');
+    await tx.$queryRaw(Prisma.sql`SELECT id FROM ${table} WHERE id = ${id} FOR UPDATE`);
+    return;
+  }
+  const table = Prisma.raw(kind);
+  const i18n = Prisma.raw(`${kind}_i18n`);
+  const fk = Prisma.raw(`${kind}_id`);
+  await tx.$queryRaw(Prisma.sql`SELECT id FROM ${table} WHERE id = ${id} FOR UPDATE`);
+  await tx.$queryRaw(Prisma.sql`SELECT id FROM ${i18n} WHERE ${fk} = ${id} AND locale = ${locale} AND deleted_at IS NULL FOR UPDATE`);
+}
+
+export async function readRevisionTarget(tx: Tx, draft: IngestDraft, entityId: string): Promise<RevisionTarget> {
+  const kind = revisionKind(draft);
+  await lockTarget(tx, kind, entityId, draft.locale);
+  const where = { locale: draft.locale, deletedAt: null };
+  const row = kind === 'blog'
+    ? await tx.blogI18n.findFirst({ where: { ...where, blogId: entityId, blog: { deletedAt: null } }, include: { blog: true } })
+    : kind === 'faq'
+      ? await tx.faqI18n.findFirst({ where: { ...where, faqId: entityId, faq: { deletedAt: null } }, include: { faq: true } })
+      : kind === 'changelog'
+        ? await tx.changelogI18n.findFirst({ where: { ...where, changelogId: entityId, changelog: { deletedAt: null } }, include: { changelog: true } })
+        : kind === 'family'
+          ? await tx.modelFamilyInfo.findFirst({ where: { id: entityId, locale: draft.locale } })
+          : await tx.modelInfo.findFirst({ where: { id: entityId, locale: draft.locale } });
+  if (!row) throw new ConflictError('修订目标不存在、已删除或缺少指定语言');
+  const data = toJsonObject(row);
+  const base = { ...toJsonObject(draft.data) };
+  for (const field of revisionFields(draft.contentType, base)) {
+    if (data[field] === null || data[field] === undefined) delete base[field];
+    else base[field] = data[field];
+  }
+  return { kind, entityId, rowId: row.id, fingerprint: revisionHash(JSON.parse(JSON.stringify(row))), data: base };
+}
+
+async function verifiedIdentityIds(tx: Tx, kind: string, ids: string[], data: Record<string, unknown>): Promise<string[]> {
+  if (!ids.length) return [];
+  const models = typeof data.modelRef === 'string' ? [data.modelRef] : data.modelRefs as string[] ?? [];
+  const families = typeof data.familyRef === 'string' ? [data.familyRef] : data.familyRefs as string[] ?? [];
+  const signature = (refs: string[]) => canonicalJson([...new Set(refs)].sort());
+  const [modelRows, familyRows] = await Promise.all([
+    tx.entityModel.findMany({ where: { entityType: kind, entityId: { in: ids } }, select: { entityId: true, model: { select: { slug: true } } } }),
+    tx.entityFamily.findMany({ where: { entityType: kind, entityId: { in: ids } }, select: { entityId: true, family: { select: { slug: true } } } }),
+  ]);
+  return ids.filter((id) =>
+    signature(modelRows.filter((r) => r.entityId === id).map((r) => r.model.slug)) === signature(models) &&
+    signature(familyRows.filter((r) => r.entityId === id).map((r) => r.family.slug)) === signature(families));
+}
+
+/** Legacy accepted drafts lack persisted entity IDs. Never choose the first ambiguous match. */
+export async function resolveRevisionTarget(tx: Tx, draft: IngestDraft, explicit?: string): Promise<string> {
+  const recorded = await tx.ingestDraftAcceptance.findUnique({ where: { draftId: draft.id } });
+  if (recorded) {
+    if (explicit && explicit !== recorded.entityId) throw new ConflictError('targetEntityId 与已记录的接受结果不一致');
+    return recorded.entityId;
+  }
+  const kind = revisionKind(draft);
+  const data = toJsonObject(draft.data);
+  let ids: string[];
+  if (kind === 'blog') {
+    const rows = await tx.blogI18n.findMany({ where: { locale: draft.locale, slug: String(data.slug), deletedAt: null, blog: { deletedAt: null } }, select: { blogId: true }, take: 2 });
+    ids = rows.map((r) => r.blogId);
+  } else if (kind === 'family') {
+    const row = await tx.modelFamilyInfo.findUnique({ where: { familyId_locale: { familyId: String(data.modelId), locale: draft.locale } } });
+    ids = row ? [row.id] : [];
+  } else if (kind === 'model') {
+    const model = await tx.modelEntity.findUnique({ where: { familyId_name: { familyId: String(data.modelId), name: String(data.modelName) } } });
+    const row = model && await tx.modelInfo.findUnique({ where: { modelId_locale: { modelId: model.id, locale: draft.locale } } });
+    ids = row ? [row.id] : [];
+  } else {
+    const rows = kind === 'faq'
+      ? await tx.faqI18n.findMany({ where: { ...(explicit ? { faqId: explicit } : {}), locale: draft.locale, deletedAt: null, faq: { deletedAt: null }, question: String(data.question), ...(!explicit ? { answer: String(data.answer) } : {}) }, select: { faqId: true }, take: 101 })
+      : await tx.changelogI18n.findMany({ where: { ...(explicit ? { changelogId: explicit } : {}), locale: draft.locale, deletedAt: null, changelog: { deletedAt: null }, title: String(data.title), ...(!explicit ? { bodyHtml: sanitizeRichText(String(data.bodyHtml)) } : {}) }, select: { changelogId: true }, take: 101 });
+    if (rows.length > 100) throw new ConflictError('旧草稿候选过多，请显式指定 targetEntityId');
+    ids = await verifiedIdentityIds(tx, kind, rows.map((r) => 'faqId' in r ? r.faqId : r.changelogId), data);
+  }
+  if (explicit) {
+    if (!ids.includes(explicit)) throw new ConflictError('targetEntityId 无法与旧草稿身份及内容关联核实');
+    return explicit;
+  }
+  if (ids.length !== 1) throw new ConflictError('旧草稿目标不存在或不唯一；核对后显式提供 targetEntityId');
+  return ids[0]!;
+}
diff --git a/apps/content-api/src/modules/review/revision-write.ts b/apps/content-api/src/modules/review/revision-write.ts
new file mode 100644
index 00000000..53662e86
--- /dev/null
+++ b/apps/content-api/src/modules/review/revision-write.ts
@@ -0,0 +1,46 @@
+import { Prisma, type IngestDraft } from '../../../generated/prisma/client';
+import { UnprocessableError } from '../../utils/errors';
+import { MediaService, type Tx } from '../media/service';
+import { normalizeMediaRefs, sanitizeRichText } from '../media/codec';
+import { ModelContentService } from '../model/content';
+import { toJsonObject } from '../playground/model';
+import type { RevisionTarget } from './revision-target';
+
+/** Editorial writes only: no base updates, locale replacement, publication or generation. */
+export async function applyRevision(tx: Tx, draft: IngestDraft, target: RevisionTarget, changes: Record<string, unknown>): Promise<void> {
+  if (target.kind === 'blog') {
+    const data = { ...changes } as Prisma.BlogI18nUpdateInput;
+    for (const key of ['summary', 'takeaways', 'keywords'] as const) {
+      if (changes[key] === null) data[key] = [];
+    }
+    for (const key of ['heroStats', 'seo'] as const) {
+      if (changes[key] === null) data[key] = Prisma.DbNull;
+    }
+    if (typeof changes.bodyHtml === 'string') {
+      const normalized = normalizeMediaRefs(changes.bodyHtml, new Map(), {
+        allowDirectMediaLinks: true, allowBucketUrlsOutsideMediaSrc: true, allowBucketUrlsInMediaSrc: true,
+      });
+      data.bodyHtml = normalized.html;
+      const refs = normalized.ids.length ? await MediaService.getByIds(normalized.ids, tx) : [];
+      if (refs.length !== normalized.ids.length) throw new UnprocessableError('修订正文含不存在或非法的媒体引用');
+      await MediaService.reconcileBindingsBatch([{
